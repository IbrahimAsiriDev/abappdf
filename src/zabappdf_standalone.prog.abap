  METHOD form_reply.
    DATA lv_id TYPE string.
    DATA lv_q TYPE i.
    DATA ls_form TYPE lcl_pdf_form_manager=>ty_form.
    DATA ls_tpl TYPE lcl_pdf_form_manager=>ty_template.
    DATA lv_fields TYPE string VALUE '[]'.
    DATA lv_json TYPE string.
    DATA lv_reply TYPE string.

    lv_id = iv_body.
    lv_q = find( val = lv_id sub = 'payload=' ).
    IF lv_q >= 0.
      lv_id = substring( val = lv_id off = lv_q + 8 ).
    ENDIF.
    lv_q = find( val = lv_id sub = '&' ).
    IF lv_q >= 0.
      lv_id = substring( val = lv_id len = lv_q ).
    ENDIF.
    lv_id = condense( cl_http_utility=>unescape_url( lv_id ) ).

    TRY.
        IF lv_id IS INITIAL.
          RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'No form name was sent'.
        ENDIF.
        "Read the stored forms again, as the full page did; pending changes keep the loaded state.
        TRY.
            lcl_pdf_form_manager=>reload( ).
          CATCH cx_pdf_error ##NO_HANDLER.
        ENDTRY.
        ls_form = lcl_pdf_form_manager=>read_form( lv_id ).
        TRY.
            ls_tpl = lcl_pdf_form_manager=>read_active_template( ls_form-form_id ).
          CATCH cx_pdf_error.
            CLEAR ls_tpl.
        ENDTRY.
        IF ls_form-ddic_structure IS NOT INITIAL.
          TRY.
              lv_fields = lcl_pdf_data_binder=>field_catalog_json( ls_form-ddic_structure ).
            CATCH cx_pdf_error.
              lv_fields = '[]'.
          ENDTRY.
        ENDIF.
        IF ls_tpl-sample_json IS INITIAL.
          ls_tpl-sample_json = sample_skeleton( ls_form-ddic_structure ).
        ENDIF.
        IF ls_tpl-page_size IS INITIAL.
          ls_tpl-page_size = 'A4'.
          ls_tpl-orientation = 'P'.
          ls_tpl-margin_top = 12.
          ls_tpl-margin_right = 10.
          ls_tpl-margin_bottom = 16.
          ls_tpl-margin_left = 10.
        ENDIF.

        lv_json = '{"id":"' && json_escape( ls_form-form_id ) &&
          '","description":"' && json_escape( ls_form-description ) &&
          '","package":"' && json_escape( ls_form-package ) &&
          '","ddic":"' && json_escape( ls_form-ddic_structure ) &&
          '","version":"' && json_escape( |{ ls_tpl-version }| ) &&
          '","pageSize":"' && json_escape( ls_tpl-page_size ) &&
          '","orientation":"' && json_escape( ls_tpl-orientation ) &&
          '","marginTop":' && |{ ls_tpl-margin_top }| &&
          ',"marginRight":' && |{ ls_tpl-margin_right }| &&
          ',"marginBottom":' && |{ ls_tpl-margin_bottom }| &&
          ',"marginLeft":' && |{ ls_tpl-margin_left }| &&
          ',"html":"' && json_escape( ls_tpl-html_content ) &&
          '","css":"' && json_escape( ls_tpl-css_content ) &&
          '","header":"' && json_escape( ls_tpl-header_html ) &&
          '","footer":"' && json_escape( ls_tpl-footer_html ) &&
          '","sample":"' && json_escape( ls_tpl-sample_json ) &&
          '","fields":' && lv_fields && '}'.
        REPLACE ALL OCCURRENCES OF '<' IN lv_json WITH '\u003c'.

        "A later full page build (after a preview, for example) opens this form again.
        gv_form = ls_form-form_id.
        gv_view_only = boolc( iv_body CS 'view=X' ).
        CLEAR: gv_draft, gv_pdf, gv_message.

        lv_reply = '<html><head><meta charset="utf-8"><title>ABAPPDF_FORM</title></head><body>' &&
          '<textarea id="formData">' && html_escape( lv_json ) && '</textarea>' &&
          '<script>try{parent.abapFormLoaded();}catch(e){}</script></body></html>'.
      CATCH cx_pdf_error INTO DATA(lx_pdf).
        lv_reply = '<html><head><meta charset="utf-8"><title>ABAPPDF_FORM_ERR</title></head><body>' &&
          '<p id="formMessage">' && html_escape( lx_pdf->get_text( ) ) && '</p>' &&
          '<script>try{parent.abapFormLoaded();}catch(e){}</script></body></html>'.
    ENDTRY.

    TRY.
        display( iv_html = lv_reply iv_frame = 'abapSink' ).
      CATCH cx_pdf_error INTO DATA(lx_show).
        MESSAGE lx_show->get_text( ) TYPE 'I'.
    ENDTRY.
  ENDMETHOD.

  METHOD save_reply.
    DATA lv_reply TYPE string.
    IF iv_version IS NOT INITIAL.
      lv_reply = '<html><head><title>ABAPPDF_SAVED_' &&
        html_escape( iv_version ) && '</title></head><body>' &&
        '<script>try{parent.abapSaved(document.title.substring(14));}catch(e){}</script></body></html>'.
    ELSE.
      lv_reply = '<html><head><title>ABAPPDF_ERR</title></head><body><p id="saveMessage">' &&
        html_escape( iv_message ) && '</p>' &&
        '<script>try{parent.abapFailed(document.getElementById("saveMessage").innerText);}catch(e){}</script></body></html>'.
    ENDIF.
    display( iv_html = lv_reply iv_frame = 'abapSink' ).
  ENDMETHOD.

  METHOD post_to_string.
    DATA lo_line TYPE REF TO cl_abap_datadescr.
    DATA lv_x TYPE xstring.
    DATA lv_len TYPE i.
    DATA lv_off TYPE i.
    DATA lv_piece TYPE string.
    DATA lv_body_x TYPE xstring.
    FIELD-SYMBOLS <line> TYPE any.
    FIELD-SYMBOLS <x> TYPE x.
    FIELD-SYMBOLS <xs> TYPE xstring.

    IF it_post IS INITIAL.
      RETURN.
    ENDIF.

    lo_line = CAST cl_abap_tabledescr(
      cl_abap_typedescr=>describe_by_data( it_post ) )->get_table_line_type( ).

    IF lo_line->type_kind = cl_abap_typedescr=>typekind_hex.
      LOOP AT it_post ASSIGNING <line>.
        ASSIGN <line> TO <x>.
        IF sy-subrc = 0.
          CONCATENATE lv_x <x> INTO lv_x IN BYTE MODE.
        ENDIF.
      ENDLOOP.
      lv_len = xstrlen( lv_x ).
      WHILE lv_len > 0.
        lv_off = lv_len - 1.
        IF lv_x+lv_off(1) = '00'.
          lv_len = lv_len - 1.
        ELSE.
          EXIT.
        ENDIF.
      ENDWHILE.
      lv_body_x = lv_x(lv_len).
      rv_body = lcl_pdf_convert=>xstring_to_string( lv_body_x ).
    ELSEIF lo_line->type_kind = cl_abap_typedescr=>typekind_xstring.
      LOOP AT it_post ASSIGNING <line>.
        ASSIGN <line> TO <xs>.
        IF sy-subrc = 0.
          CONCATENATE lv_x <xs> INTO lv_x IN BYTE MODE.
        ENDIF.
      ENDLOOP.
      rv_body = lcl_pdf_convert=>xstring_to_string( lv_x ).
    ELSE.
      LOOP AT it_post ASSIGNING <line>.
        lv_piece = <line>.
        SHIFT lv_piece RIGHT DELETING TRAILING space.
        rv_body = rv_body && lv_piece.
      ENDLOOP.
    ENDIF.
  ENDMETHOD.

  METHOD form_fields.
    DATA lt_pairs TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    DATA lv_pair TYPE string.
    DATA lv_name TYPE string.
    DATA lv_value TYPE string.
    DATA lv_eq TYPE i.
    DATA ls_field TYPE ty_field.
    IF strlen( iv_body ) > 8000000.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Form payload exceeds 8 MB'.
    ENDIF.
    SPLIT iv_body AT '&' INTO TABLE lt_pairs.
    LOOP AT lt_pairs INTO lv_pair.
      IF lv_pair IS INITIAL.
        CONTINUE.
      ENDIF.
      lv_eq = find( val = lv_pair sub = '=' ).
      IF lv_eq <= 0.
        RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Malformed form field'.
      ENDIF.
      lv_name = substring( val = lv_pair len = lv_eq ).
      lv_value = substring( val = lv_pair off = lv_eq + 1 ).
      REPLACE ALL OCCURRENCES OF '+' IN lv_name WITH ` `.
      REPLACE ALL OCCURRENCES OF '+' IN lv_value WITH ` `.
      ls_field-name = to_upper( cl_http_utility=>unescape_url( lv_name ) ).
      ls_field-value = cl_http_utility=>unescape_url( lv_value ).
      INSERT ls_field INTO TABLE rt_fields.
      IF sy-subrc <> 0.
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING message = |Duplicate form field: { ls_field-name }|.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD field_value.
    DATA ls_field TYPE ty_field.
    READ TABLE it_fields WITH TABLE KEY name = to_upper( iv_name ) INTO ls_field.
    IF sy-subrc = 0.
      rv_value = ls_field-value.
    ENDIF.
  ENDMETHOD.

  METHOD field_text.
    rv_text = lcl_pdf_convert=>base64url_decode( field_value(
      it_fields = it_fields
      iv_name   = iv_name ) ).
  ENDMETHOD.

  METHOD payload_text.
    DATA lv_b64 TYPE string.
    DATA lv_part TYPE string.
    DATA lv_name TYPE string.
    DATA lv_idx TYPE i VALUE 2.
    DATA lv_prefix TYPE string VALUE 'payload_b64_'.

    lv_b64 = field_value( it_fields = it_fields iv_name = 'payload_b64' ).
    IF lv_b64 IS INITIAL.
      lv_b64 = field_value( it_fields = it_fields iv_name = 'payload' ).
      lv_prefix = 'payload_'.
    ENDIF.
    DO.
      lv_name = lv_prefix && |{ lv_idx }|.
      lv_part = field_value( it_fields = it_fields iv_name = lv_name ).
      IF lv_part IS INITIAL.
        EXIT.
      ENDIF.
      lv_b64 = lv_b64 && lv_part.
      lv_idx = lv_idx + 1.
      IF lv_idx > 400.
        EXIT.
      ENDIF.
    ENDDO.
    rv_text = lcl_pdf_convert=>base64url_decode( lv_b64 ).
  ENDMETHOD.

  METHOD query_value.
    DATA lt_pairs TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    DATA lv_pair TYPE string.
    DATA lv_eq TYPE i.
    DATA lv_name TYPE string.

    SPLIT iv_query AT '&' INTO TABLE lt_pairs.
    LOOP AT lt_pairs INTO lv_pair.
      lv_eq = find( val = lv_pair sub = '=' ).
      IF lv_eq <= 0.
        CONTINUE.
      ENDIF.
      lv_name = to_upper( substring( val = lv_pair len = lv_eq ) ).
      IF lv_name = to_upper( iv_name ).
        rv_value = cl_http_utility=>unescape_url( substring( val = lv_pair off = lv_eq + 1 ) ).
        RETURN.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD to_int.
    DATA lv_text TYPE string.
    lv_text = iv_text.
    SHIFT lv_text LEFT DELETING LEADING space.
    SHIFT lv_text RIGHT DELETING TRAILING space.
    IF lv_text IS INITIAL OR strlen( lv_text ) > 3 OR lv_text CN '0123456789'.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Margins must be whole millimetres from 0 to 500'.
    ENDIF.
    rv_int = lv_text.
    IF rv_int > 500.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Margins must be between 0 and 500 mm'.
    ENDIF.
  ENDMETHOD.

  METHOD remember_draft.
    gv_draft = abap_true.
    gs_draft_form-form_id = gv_form.
    gs_draft_form-description = gv_form.
    gs_draft_form-package = field_value( it_fields = it_fields iv_name = 'package' ).
    gs_draft_form-ddic_structure = field_value( it_fields = it_fields iv_name = 'ddic' ).
    DATA(lv_html) = field_text( it_fields = it_fields iv_name = 'html' ).
    IF lv_html IS INITIAL.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING message = 'Template body is missing. Nothing was saved; reopen the designer and retry.'.
    ENDIF.
    gs_draft-html_content = lv_html.
    gs_draft-css_content = field_text( it_fields = it_fields iv_name = 'css' ).
    gs_draft-header_html = field_text( it_fields = it_fields iv_name = 'header' ).
    gs_draft-footer_html = field_text( it_fields = it_fields iv_name = 'footer' ).
    gs_draft-sample_json = field_text( it_fields = it_fields iv_name = 'sample' ).
    gs_draft-page_size = field_value( it_fields = it_fields iv_name = 'page_size' ).
    gs_draft-orientation = field_value( it_fields = it_fields iv_name = 'orientation' ).
    gs_draft-margin_top = to_int( field_value( it_fields = it_fields iv_name = 'margin_top' ) ).
    gs_draft-margin_right = to_int( field_value( it_fields = it_fields iv_name = 'margin_right' ) ).
    gs_draft-margin_bottom = to_int( field_value( it_fields = it_fields iv_name = 'margin_bottom' ) ).
    gs_draft-margin_left = to_int( field_value( it_fields = it_fields iv_name = 'margin_left' ) ).
    gv_draft = abap_true.
  ENDMETHOD.

  METHOD bind_sample.
    DATA lr_data TYPE REF TO data.
    FIELD-SYMBOLS <data> TYPE any.
    DATA lv_ddic TYPE string.

    rv_bound = iv_template.
    lv_ddic = to_upper( iv_ddic ).
    IF iv_template IS INITIAL OR iv_template NS '{{'.
      RETURN.
    ENDIF.
    IF iv_sample IS INITIAL.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING message = 'Preview with placeholders requires sample JSON'.
    ENDIF.

    TRY.
        IF lv_ddic IS INITIAL.
          "No DDIC type: the sample JSON itself defines the data shape (API mode forms).
          lr_data = lcl_pdf_json_data=>build( iv_sample ).
          ASSIGN lr_data->* TO <data>.
        ELSE.
          CREATE DATA lr_data TYPE (lv_ddic).
          ASSIGN lr_data->* TO <data>.
          CALL METHOD ('/UI2/CL_JSON')=>deserialize
            EXPORTING
              json = iv_sample
            CHANGING
              data = <data>.
        ENDIF.
        rv_bound = lcl_pdf_data_binder=>render(
          iv_template = iv_template
          is_data     = <data> ).
      CATCH cx_root INTO DATA(lx_error).
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING previous = lx_error
                    message = |Preview binding failed: { lx_error->get_text( ) }|.
    ENDTRY.
  ENDMETHOD.

ENDCLASS.

*& lcl_pdf_demo
CLASS lcl_pdf_demo IMPLEMENTATION.

  METHOD run.
    DATA ls_flight TYPE sflight.
    DATA lv_pdf TYPE xstring.
    DATA lv_size TYPE i.

    IF iv_reset = abap_true.
      TRY.
          lcl_pdf_form_manager=>reset_demo( ).
          lcl_pdf_form_manager=>commit_changes( ).
        CATCH cx_pdf_error INTO DATA(lx_reset).
          lcl_pdf_form_manager=>abort_changes( ).
          RAISE EXCEPTION lx_reset.
      ENDTRY.
    ENDIF.

    read_flight( CHANGING cs_flight = ls_flight ).
    lv_pdf = lcl_pdf_api=>render_pdf(
      iv_form_id = 'ZPDF_DEMO'
      is_data    = ls_flight ).
    lcl_pdf_api=>download_pdf(
      iv_pdf_xstring = lv_pdf
      iv_filename    = 'zpdf_demo.pdf' ).
    lv_size = xstrlen( lv_pdf ).
    WRITE: / 'Rendered', lv_size, 'bytes.'.
  ENDMETHOD.

  METHOD read_flight.
    SELECT * FROM sflight WHERE carrid = 'LH'
      ORDER BY PRIMARY KEY INTO @cs_flight UP TO 1 ROWS.
    ENDSELECT.
    IF sy-subrc <> 0.
      CLEAR cs_flight.
      cs_flight-carrid = 'LH'.
      cs_flight-connid = '0400'.
      cs_flight-fldate = sy-datum.
      cs_flight-price = 345.
      cs_flight-currency = 'EUR'.
      cs_flight-seatsocc = 120.
      cs_flight-seatsmax = 180.
      cs_flight-planetype = 'A320'.
    ENDIF.
  ENDMETHOD.

ENDCLASS.

