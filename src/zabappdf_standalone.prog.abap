CLASS ltc_pdf_tests IMPLEMENTATION.
  METHOD total_sum_char.
    "Same data as the invoice report: amounts as text.
    TYPES: BEGIN OF ty_item, material TYPE c LENGTH 18, amount TYPE c LENGTH 20, END OF ty_item,
           ty_items TYPE STANDARD TABLE OF ty_item WITH EMPTY KEY,
           BEGIN OF ty_doc, items TYPE ty_items, END OF ty_doc.
    DATA ls_doc TYPE ty_doc.
    ls_doc-items = VALUE #( ( material = 'MAT-100' amount = '50.00' ) ( material = 'MAT-200' amount = '91.00' )
                            ( material = 'MAT-300' amount = '16.25' ) ( material = 'MAT-400' amount = '22.00' ) ).
    cl_abap_unit_assert=>assert_equals(
      act = lcl_pdf_data_binder=>render( iv_template = '{{sum ITEMS.AMOUNT}}' is_data = ls_doc )
      exp = '179.25'
      msg = 'sum over a text AMOUNT field' ).
  ENDMETHOD.

  METHOD total_sum_packed.
    "Amounts as packed numbers (CURR/DEC fields); the separator follows the user's number format.
    TYPES: BEGIN OF ty_item, amount TYPE p LENGTH 13 DECIMALS 2, END OF ty_item,
           ty_items TYPE STANDARD TABLE OF ty_item WITH EMPTY KEY,
           BEGIN OF ty_doc, items TYPE ty_items, END OF ty_doc.
    DATA ls_doc TYPE ty_doc.
    DATA lv_out TYPE string.
    ls_doc-items = VALUE #( ( amount = '50.00' ) ( amount = '91.00' ) ( amount = '16.25' ) ( amount = '22.00' ) ).
    lv_out = lcl_pdf_data_binder=>render( iv_template = '{{sum ITEMS.AMOUNT}}' is_data = ls_doc ).
    cl_abap_unit_assert=>assert_true(
      act = xsdbool( lv_out = '179.25' OR lv_out = '179,25' )
      msg = |sum over a packed AMOUNT field returned "{ lv_out }"| ).
  ENDMETHOD.

  METHOD total_designer_table.
    "The shape the designer saves: metadata comment, data row, total in a footer row.
    TYPES: BEGIN OF ty_item, material TYPE c LENGTH 18, qty TYPE c LENGTH 15, amount TYPE c LENGTH 20, END OF ty_item,
           ty_items TYPE STANDARD TABLE OF ty_item WITH EMPTY KEY,
           BEGIN OF ty_doc, items TYPE ty_items, END OF ty_doc.
    DATA ls_doc TYPE ty_doc.
    DATA lv_out TYPE string.
    ls_doc-items = VALUE #( ( material = 'MAT-100' qty = '10' amount = '50.00' ) ( material = 'MAT-200' qty = '2' amount = '91.00' )
                            ( material = 'MAT-300' qty = '5' amount = '16.25' ) ( material = 'MAT-400' qty = '20' amount = '22.00' ) ).
    lv_out = lcl_pdf_data_binder=>render(
      iv_template = '<!--abappdf64:eyJ1bml0IjoicHgiLCJ3aWRnZXRzIjpbXX0--><table><tbody>' &&
                    '{{#each ITEMS}}<tr><td><div>{{material}}</div></td><td><div>{{QTY}}</div></td><td><div>{{AMOUNT}}</div></td></tr>{{/each}}' &&
                    '<tr class="tfoot"><td colspan="2"><div>Total</div></td><td><div>{{sum ITEMS.AMOUNT}}</div></td></tr></tbody></table>'
      is_data     = ls_doc ).
    cl_abap_unit_assert=>assert_true(
      act = xsdbool( lv_out CS '<div>Total</div></td><td><div>179.25</div>' )
      msg = |designer table total missing: { lv_out }| ).
  ENDMETHOD.

  METHOD total_count_avg_format.
    TYPES: BEGIN OF ty_item, amount TYPE c LENGTH 20, END OF ty_item,
           ty_items TYPE STANDARD TABLE OF ty_item WITH EMPTY KEY,
           BEGIN OF ty_doc, items TYPE ty_items, END OF ty_doc.
    DATA ls_doc TYPE ty_doc.
    ls_doc-items = VALUE #( ( amount = '1000.00' ) ( amount = '234.50' ) ).
    cl_abap_unit_assert=>assert_equals(
      act = lcl_pdf_data_binder=>render(
              iv_template = '{{count ITEMS}}|{{avg ITEMS.AMOUNT}}|<span data-fmt="#,##0.00">{{sum ITEMS.AMOUNT}}</span>|<span data-fmt="#.##0,00">{{max ITEMS.AMOUNT}}</span>'
              is_data     = ls_doc )
      exp = '2|617.25|<span data-fmt="#,##0.00">1,234.50</span>|<span data-fmt="#.##0,00">1.000,00</span>'
      msg = 'count, average and number formats' ).
  ENDMETHOD.
  METHOD escaped_fields.
    TYPES: BEGIN OF ty_data, name TYPE string, END OF ty_data.
    DATA ls_data TYPE ty_data.
    ls_data-name = `<A&B>"'`.
    DATA(lv_html) = lcl_pdf_data_binder=>render(
      iv_template = '{{name}}' is_data = ls_data ).
    cl_abap_unit_assert=>assert_equals(
      act = lv_html exp = '&lt;A&amp;B&gt;&quot;&#39;' ).
  ENDMETHOD.

  METHOD missing_field.
    DATA lv_data TYPE string.
    TRY.
        DATA(lv_html) = lcl_pdf_data_binder=>render(
          iv_template = '{{missing}}' is_data = lv_data ).
        cl_abap_unit_assert=>fail( 'Missing field must fail' ).
      CATCH cx_pdf_error INTO DATA(lx_error).
        cl_abap_unit_assert=>assert_true(
          act = xsdbool( lx_error->get_text( ) CS 'Unknown template field' ) ).
    ENDTRY.
  ENDMETHOD.

  METHOD nested_tables.
    TYPES: BEGIN OF ty_item, name TYPE string, END OF ty_item.
    TYPES ty_items TYPE STANDARD TABLE OF ty_item WITH EMPTY KEY.
    TYPES: BEGIN OF ty_data, items TYPE ty_items, END OF ty_data.
    DATA ls_data TYPE ty_data.
    APPEND VALUE #( name = 'A&B' ) TO ls_data-items.
    APPEND VALUE #( name = 'Second' ) TO ls_data-items.
    DATA(lv_html) = lcl_pdf_data_binder=>render(
      iv_template = '{{#each items}}<p>{{ROW}}:{{name}}</p>{{else}}Empty{{/each}}'
      is_data = ls_data ).
    cl_abap_unit_assert=>assert_equals(
      act = lv_html exp = '<p>1:A&amp;B</p><p>2:Second</p>' ).
  ENDMETHOD.

  METHOD invalid_hidden_block.
    TYPES: BEGIN OF ty_data, enabled TYPE abap_bool, END OF ty_data.
    DATA ls_data TYPE ty_data.
    TRY.
        DATA(lv_html) = lcl_pdf_data_binder=>render(
          iv_template = '{{#if enabled}}{{#each items}}{{/if}}{{/if}}'
          is_data = ls_data ).
        cl_abap_unit_assert=>fail( 'Wrong closing tag in hidden branch must fail' ).
      CATCH cx_pdf_error INTO DATA(lx_error).
        cl_abap_unit_assert=>assert_true(
          act = xsdbool( lx_error->get_text( ) CS 'Expected /EACH' ) ).
    ENDTRY.
  ENDMETHOD.

  METHOD encoded_form_fields.
    DATA(lt_spacing) = lcl_pdf_app=>form_fields( 'a=+two++words+&b=%2B&c=%20' ).
    cl_abap_unit_assert=>assert_equals(
      act = lcl_pdf_app=>field_value( it_fields = lt_spacing iv_name = 'a' )
      exp = ` two  words ` ).
    cl_abap_unit_assert=>assert_equals(
      act = lcl_pdf_app=>field_value( it_fields = lt_spacing iv_name = 'b' ) exp = '+' ).
    cl_abap_unit_assert=>assert_equals(
      act = lcl_pdf_app=>field_value( it_fields = lt_spacing iv_name = 'c' ) exp = ` ` ).
    DATA(lt_fields) = lcl_pdf_app=>form_fields(
      'name=Sales%20%26%20Service&plus=%2B&text=two+words' ).
    cl_abap_unit_assert=>assert_equals(
      act = lcl_pdf_app=>field_value( it_fields = lt_fields iv_name = 'name' )
      exp = 'Sales & Service' ).
    cl_abap_unit_assert=>assert_equals(
      act = lcl_pdf_app=>field_value( it_fields = lt_fields iv_name = 'plus' )
      exp = '+' ).
    cl_abap_unit_assert=>assert_equals(
      act = lcl_pdf_app=>field_value( it_fields = lt_fields iv_name = 'text' )
      exp = 'two words' ).
  ENDMETHOD.

  METHOD duplicate_fields.
    TRY.
        DATA(lt_fields) = lcl_pdf_app=>form_fields( 'name=A&NAME=B' ).
        cl_abap_unit_assert=>fail( 'Duplicate field must fail' ).
      CATCH cx_pdf_error INTO DATA(lx_error).
        cl_abap_unit_assert=>assert_true(
          act = xsdbool( lx_error->get_text( ) CS 'Duplicate form field' ) ).
    ENDTRY.
  ENDMETHOD.

  METHOD margin_overflow.
    TRY.
        DATA(lv_margin) = lcl_pdf_app=>to_int( '99999999999999999999' ).
        cl_abap_unit_assert=>fail( 'Large margin must raise a checked error' ).
      CATCH cx_pdf_error.
        "Expected; a numeric conversion dump is not acceptable.
    ENDTRY.
  ENDMETHOD.

  METHOD invalid_page_area.
    DATA ls_page TYPE lcl_pdf_renderer=>ty_page.
    ls_page-page_size = 'A4'.
    ls_page-orientation = 'P'.
    ls_page-margin_left = 110.
    ls_page-margin_right = 110.
    TRY.
        lcl_pdf_renderer=>validate_page( ls_page ).
        cl_abap_unit_assert=>fail( 'Margins consuming the page must fail' ).
      CATCH cx_pdf_error INTO DATA(lx_error).
        cl_abap_unit_assert=>assert_true(
          act = xsdbool( lx_error->get_text( ) CS 'printable page area' ) ).
    ENDTRY.
  ENDMETHOD.

  METHOD raw_keeps_formatting.
    TYPES: BEGIN OF ty_doc, raw TYPE string, END OF ty_doc.
    DATA ls_doc TYPE ty_doc.
    ls_doc-raw = `<B>Total</B> <table border=1><tr><td colspan='2' style="color:red">x &amp; y</td></tr></table>`.
    cl_abap_unit_assert=>assert_equals(
      act = lcl_pdf_data_binder=>render( iv_template = '{{{RAW}}}' is_data = ls_doc )
      exp = `<b>Total</b> <table border="1"><tr><td colspan="2" style="color:red">x &amp; y</td></tr></table>` ).
  ENDMETHOD.

  METHOD raw_blocks_attacks.
    TYPES: BEGIN OF ty_doc, raw TYPE string, END OF ty_doc.
    DATA ls_doc TYPE ty_doc.
    DATA lt_inputs TYPE string_table.
    DATA lv_input TYPE string.
    DATA lv_out TYPE string.
    lt_inputs = VALUE #(
      ( `<img src=x"onerror=alert(1)>` )
      ( `<a href="java&#115;cript:alert(1)">x</a>` )
      ( `<a href="java&#x09;script:alert(1)">x</a>` )
      ( |<a href="java\tscript:alert(1)">x</a>| )
      ( `<a href=" JaVaScRiPt:alert(1)">x</a>` )
      ( `<a href="data:text/html,<script>alert(1)</script>">x</a>` )
      ( `<script>alert(1)</script>` )
      ( `<ScRiPt src=//evil></ScRiPt>` )
      ( `<svg onload=alert(1)><circle/></svg>` )
      ( `<iframe src="https://intranet/"></iframe>` )
      ( `<meta http-equiv="refresh" content="0;url=javascript:alert(1)">` )
      ( `<img src="http://intranet/secret.png">` )
      ( `<div style="background:url(http://intranet/x)">t</div>` )
      ( `<div style="background:u\72l(http://intranet/x)">t</div>` )
      ( `<div style="width:expression(alert(1))">t</div>` )
      ( `<b onclick="alert(1)" onmouseover=alert(1)>t</b>` )
      ( `<form action="https://intranet/"><input name=x></form>` ) ).
    LOOP AT lt_inputs INTO lv_input.
      ls_doc-raw = lv_input.
      lv_out = to_lower( lcl_pdf_data_binder=>render( iv_template = '{{{RAW}}}' is_data = ls_doc ) ).
      cl_abap_unit_assert=>assert_true(
        act = xsdbool( lv_out NS '<script' AND lv_out NS 'javascript' AND lv_out NS 'onerror'
                   AND lv_out NS 'onload' AND lv_out NS 'onclick' AND lv_out NS 'onmouseover'
                   AND lv_out NS 'intranet' AND lv_out NS 'evil' AND lv_out NS '<iframe'
                   AND lv_out NS '<meta' AND lv_out NS '<svg' AND lv_out NS '<form'
                   AND lv_out NS 'expression' AND lv_out NS 'data:text' )
        msg = |Not sanitized: { lv_input } -> { lv_out }| ).
    ENDLOOP.
  ENDMETHOD.

  METHOD raw_embedded_image.
    TYPES: BEGIN OF ty_doc, raw TYPE string, END OF ty_doc.
    DATA ls_doc TYPE ty_doc.
    ls_doc-raw = `<img src="data:image/png;base64,iVBORw0KGgo=" width="20">`.
    cl_abap_unit_assert=>assert_equals(
      act = lcl_pdf_data_binder=>render( iv_template = '{{{RAW}}}' is_data = ls_doc )
      exp = ls_doc-raw ).
  ENDMETHOD.

  METHOD arabic_shaping.
    "سلام: seen initial, lam-alef final ligature, meem isolated (alef does not join the next letter).
    cl_abap_unit_assert=>assert_equals(
      act = lcl_pdf_arabic=>shape( VALUE #( ( 1587 ) ( 1604 ) ( 1575 ) ( 1605 ) ) )
      exp = VALUE lcl_pdf_arabic=>ty_ints( ( 65203 ) ( 65276 ) ( 65249 ) ) ).
    "باب: beh initial, alef final, beh isolated.
    cl_abap_unit_assert=>assert_equals(
      act = lcl_pdf_arabic=>shape( VALUE #( ( 1576 ) ( 1575 ) ( 1576 ) ) )
      exp = VALUE lcl_pdf_arabic=>ty_ints( ( 65169 ) ( 65166 ) ( 65167 ) ) ).
  ENDMETHOD.

  METHOD unicode_roundtrip.
    DATA(lv_text) = CONV string( 'فاتورة — Invoice €' ).
    DATA(lv_bytes) = lcl_pdf_convert=>string_to_xstring( lv_text ).
    cl_abap_unit_assert=>assert_equals(
      act = lcl_pdf_convert=>xstring_to_string( lv_bytes ) exp = lv_text ).
  ENDMETHOD.
ENDCLASS.

*&---------------------------------------------------------------------*
*& Selection screen and events
*&---------------------------------------------------------------------*
* Comment and frame names are at most eight characters. The selection
* screen declares them, so they are not declared with DATA again.
SELECTION-SCREEN BEGIN OF SCREEN 1001 TITLE c_title.
SELECTION-SCREEN END OF SCREEN 1001.

SELECTION-SCREEN BEGIN OF BLOCK eng WITH FRAME TITLE c_engine.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS r_nat RADIOBUTTON GROUP rend DEFAULT 'X'.
SELECTION-SCREEN COMMENT 4(40) c_nat.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS r_got RADIOBUTTON GROUP rend.
SELECTION-SCREEN COMMENT 4(40) c_got.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT (18) c_url.
PARAMETERS p_url TYPE string LOWER CASE DEFAULT gc_gotenberg_url VISIBLE LENGTH 60.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT (18) c_time.
PARAMETERS p_time TYPE i DEFAULT 60.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN END OF BLOCK eng.

SELECTION-SCREEN BEGIN OF BLOCK des WITH FRAME TITLE c_design.
SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT (26) c_file.
PARAMETERS p_file TYPE string LOWER CASE VISIBLE LENGTH 80.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT (26) c_mime.
PARAMETERS p_mime TYPE string LOWER CASE VISIBLE LENGTH 80.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN PUSHBUTTON /1(24) c_reload USER-COMMAND RELOAD.
SELECTION-SCREEN END OF BLOCK des.

SELECTION-SCREEN BEGIN OF BLOCK run WITH FRAME TITLE c_run.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS r_work RADIOBUTTON GROUP mode DEFAULT 'X' USER-COMMAND mode.
SELECTION-SCREEN COMMENT 4(36) c_work.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS r_demo RADIOBUTTON GROUP mode.
SELECTION-SCREEN COMMENT 4(36) c_demo.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS p_reset AS CHECKBOX.
SELECTION-SCREEN COMMENT 3(28) c_reset.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN END OF BLOCK run.
PARAMETERS p_api TYPE c LENGTH 1 NO-DISPLAY.

INITIALIZATION.
  c_title = 'abapPDF Designer'.
  c_engine = 'PDF engine'.
  c_nat = 'Native ABAP (no server needed)'.
  c_got = 'Gotenberg service (URL below)'.
  c_design = 'Designer'.
  c_run = 'Run'.
  c_url = 'URL'.
  c_time = 'Timeout secs'.
  c_file = 'Local HTML file'.
  c_mime = 'MIME path'.
  c_work = 'Open designer'.
  c_demo = 'Render SFLIGHT demo PDF'.
  c_reset = 'Replace demo template'.
  c_reload = 'Reload designer'.
  PERFORM configure_designer_screen.

AT SELECTION-SCREEN OUTPUT.
  IF p_api = abap_true.
    "API mode never shows the designer.
    RETURN.
  ENDIF.
  IF sy-dynnr = '1000' AND r_work = abap_true AND sy-batch = abap_false.
    CALL SELECTION-SCREEN 1001.
    RETURN.
  ENDIF.
  "The embedded designer starts in PBO; it does not need Execute (F8).
  "Keep Execute available for the separate demo-rendering mode.
  DATA lt_designer_exclude TYPE STANDARD TABLE OF rsexfcode WITH DEFAULT KEY.
  CLEAR lt_designer_exclude.
  IF r_work = 'X'.
    APPEND VALUE #( fcode = 'ONLI' ) TO lt_designer_exclude.
  ENDIF.
  CALL FUNCTION 'RS_SET_SELSCREEN_STATUS'
    EXPORTING
      p_status  = '%_00'
      p_program = 'RSSYSTDB'
    TABLES
      p_exclude = lt_designer_exclude.
  lcl_pdf_app=>set_source(
    iv_file = p_file
    iv_mime = p_mime ).
  TRY.
      lcl_pdf_form_manager=>set_runtime(
        iv_url     = p_url
        iv_timeout = p_time ).
      lcl_pdf_form_manager=>set_config(
        iv_param = `ENGINE`
        iv_value = COND string( WHEN r_got = abap_true THEN `GOTENBERG` ELSE `NATIVE` ) ).
    CATCH cx_pdf_error INTO DATA(lx_init).
      MESSAGE lx_init->get_text( ) TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
  ENDTRY.
  IF r_work = 'X'.
    lcl_pdf_app=>start( ).
  ENDIF.

AT SELECTION-SCREEN ON EXIT-COMMAND.
  IF sy-dynnr = '1001'.
    LEAVE PROGRAM.
  ENDIF.

AT SELECTION-SCREEN.
  lcl_pdf_app=>set_source(
    iv_file = p_file
    iv_mime = p_mime ).
  TRY.
      lcl_pdf_form_manager=>set_runtime(
        iv_url     = p_url
        iv_timeout = p_time ).
      lcl_pdf_form_manager=>set_config(
        iv_param = `ENGINE`
        iv_value = COND string( WHEN r_got = abap_true THEN `GOTENBERG` ELSE `NATIVE` ) ).
    CATCH cx_pdf_error INTO DATA(lx_screen).
      MESSAGE lx_screen->get_text( ) TYPE 'E'.
  ENDTRY.
  IF sy-ucomm = 'RELOAD' OR sy-ucomm = 'REFR'.
    lcl_pdf_app=>show( ).
  ENDIF.

START-OF-SELECTION.
  IF p_api = abap_true.
    PERFORM api_mode.
    RETURN.
  ENDIF.
  TRY.
      lcl_pdf_form_manager=>set_runtime(
        iv_url     = p_url
        iv_timeout = p_time ).
      lcl_pdf_form_manager=>set_config(
        iv_param = `ENGINE`
        iv_value = COND string( WHEN r_got = abap_true THEN `GOTENBERG` ELSE `NATIVE` ) ).
      IF r_demo = 'X'.
        lcl_pdf_demo=>run( iv_reset = p_reset ).
      ENDIF.
    CATCH cx_pdf_error INTO DATA(lx_pdf).
      WRITE: / lx_pdf->get_text( ).
  ENDTRY.

*& API mode: request and result travel through ABAP memory; no list output.
FORM api_mode.
  DATA lv_form_id TYPE string.
  DATA lv_json TYPE string.
  DATA lv_html TYPE string.
  DATA lv_css TYPE string.
  DATA lv_header TYPE string.
  DATA lv_footer TYPE string.
  DATA lv_page_size TYPE string.
  DATA lv_orientation TYPE string.
  DATA lv_margin_top TYPE i.
  DATA lv_margin_right TYPE i.
  DATA lv_margin_bottom TYPE i.
  DATA lv_margin_left TYPE i.
  DATA ls_page TYPE lcl_pdf_renderer=>ty_page.
  DATA lv_pdf TYPE xstring.
  DATA lv_message TYPE string.

  IMPORT form_id = lv_form_id json = lv_json html = lv_html css = lv_css
         header = lv_header footer = lv_footer
         page_size = lv_page_size orientation = lv_orientation
         margin_top = lv_margin_top margin_right = lv_margin_right
         margin_bottom = lv_margin_bottom margin_left = lv_margin_left
    FROM MEMORY ID 'ZABAPPDF_API_IN'.
  IF sy-subrc <> 0.
    lv_message = 'No request found in memory ID ZABAPPDF_API_IN'.
  ELSE.
    FREE MEMORY ID 'ZABAPPDF_API_IN'.
    TRY.
        lcl_pdf_form_manager=>set_runtime(
          iv_url     = p_url
          iv_timeout = p_time ).
        lcl_pdf_form_manager=>set_config(
          iv_param = `ENGINE`
          iv_value = COND string( WHEN r_got = abap_true THEN `GOTENBERG` ELSE `NATIVE` ) ).
        ls_page-page_size = lv_page_size.
        ls_page-orientation = lv_orientation.
        ls_page-margin_top = lv_margin_top.
        ls_page-margin_right = lv_margin_right.
        ls_page-margin_bottom = lv_margin_bottom.
        ls_page-margin_left = lv_margin_left.
        lv_pdf = lcl_pdf_api=>render_json(
          iv_form_id = lv_form_id
          iv_json    = lv_json
          iv_html    = lv_html
          iv_css     = lv_css
          iv_header  = lv_header
          iv_footer  = lv_footer
          is_page    = ls_page ).
      CATCH cx_pdf_error INTO DATA(lx_api).
        lv_message = lx_api->get_text( ).
        CLEAR lv_pdf.
      CATCH cx_root INTO DATA(lx_root).
        lv_message = lx_root->get_text( ).
        CLEAR lv_pdf.
    ENDTRY.
  ENDIF.
  EXPORT pdf = lv_pdf message = lv_message TO MEMORY ID 'ZABAPPDF_API_OUT'.
ENDFORM.

FORM configure_designer_screen.
  "Only this report's dedicated HTML screen is changed, not screen 1000.
  DATA ls_designer_header TYPE rpy_dyhead.
  DATA lt_designer_containers TYPE dycatt_tab.
  DATA lt_designer_fields TYPE dyfatc_tab.
  DATA lt_designer_flow TYPE swydyflow.
  CALL FUNCTION 'RPY_DYNPRO_READ'
    EXPORTING progname = sy-repid dynnr = '1001'
    IMPORTING header = ls_designer_header
    TABLES containers = lt_designer_containers
           fields_to_containers = lt_designer_fields
           flow_logic = lt_designer_flow
    EXCEPTIONS OTHERS = 1.
  IF sy-subrc <> 0.
    MESSAGE 'Could not read designer screen 1001; toolbar setting was not changed' TYPE 'S' DISPLAY LIKE 'W'.
    RETURN.
  ENDIF.
  IF ls_designer_header-no_toolbar = abap_true.
    RETURN.
  ENDIF.
  ls_designer_header-no_toolbar = abap_true.
  CALL FUNCTION 'RPY_DYNPRO_INSERT'
    EXPORTING header = ls_designer_header suppress_exist_checks = abap_true
    TABLES containers = lt_designer_containers
           fields_to_containers = lt_designer_fields
           flow_logic = lt_designer_flow
    EXCEPTIONS already_exists = 2 OTHERS = 1.
  IF sy-subrc <> 0 AND sy-subrc <> 2.
    MESSAGE 'Set No application toolbar on screen 1001 in SE51; automatic update was not permitted' TYPE 'S' DISPLAY LIKE 'W'.
  ENDIF.
ENDFORM.
