*& cx_pdf_error
CLASS cx_pdf_error IMPLEMENTATION.

  METHOD constructor.
    super->constructor( previous = previous ).
    me->message = message.
  ENDMETHOD.

  METHOD get_text.
    IF message IS INITIAL.
      result = super->get_text( ).
    ELSE.
      result = message.
    ENDIF.
  ENDMETHOD.

ENDCLASS.

*& lcl_pdf_convert
CLASS lcl_pdf_security IMPLEMENTATION.
  METHOD check.
    AUTHORITY-CHECK OBJECT 'S_PROGRAM'
      ID 'P_GROUP' FIELD iv_group
      ID 'P_ACTION' FIELD 'SUBMIT'.
    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING message = |Missing authorization: S_PROGRAM { iv_group } / SUBMIT|.
    ENDIF.
  ENDMETHOD.
ENDCLASS.

CLASS lcl_pdf_convert IMPLEMENTATION.

  METHOD string_to_xstring.
    IF iv_string IS INITIAL.
      RETURN.
    ENDIF.

    TRY.
        DATA(lo_out) = cl_abap_conv_out_ce=>create( encoding = 'UTF-8' ).
        lo_out->convert(
          EXPORTING
            data   = iv_string
          IMPORTING
            buffer = rv_xstring ).
      CATCH cx_root INTO DATA(lx_error).
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING
            previous = lx_error
            message  = |UTF-8 encode failed: { lx_error->get_text( ) }|.
    ENDTRY.
  ENDMETHOD.

  METHOD xstring_to_string.
    IF iv_xstring IS INITIAL.
      RETURN.
    ENDIF.

    TRY.
        DATA(lo_in) = cl_abap_conv_in_ce=>create(
          input    = iv_xstring
          encoding = 'UTF-8' ).
        lo_in->read( IMPORTING data = rv_string ).
      CATCH cx_root INTO DATA(lx_error).
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING
            previous = lx_error
            message  = |UTF-8 decode failed: { lx_error->get_text( ) }|.
    ENDTRY.
  ENDMETHOD.

  METHOD base64_decode.
    DATA lv_b64 TYPE string.
    lv_b64 = iv_b64.
    CONDENSE lv_b64 NO-GAPS.
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>cr_lf IN lv_b64 WITH ''.
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>cr_lf+0(1) IN lv_b64 WITH ''.
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>newline IN lv_b64 WITH ''.
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>horizontal_tab IN lv_b64 WITH ''.
    IF lv_b64 IS INITIAL.
      RETURN.
    ENDIF.
    rv_string = xstring_to_string( cl_http_utility=>decode_x_base64( lv_b64 ) ).
  ENDMETHOD.

  METHOD base64url_decode.
    DATA lv_b64 TYPE string.
    DATA lv_len TYPE i.
    DATA lv_mod TYPE i.

    lv_b64 = iv_b64.
    CONDENSE lv_b64 NO-GAPS.
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>cr_lf IN lv_b64 WITH ''.
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>cr_lf+0(1) IN lv_b64 WITH ''.
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>newline IN lv_b64 WITH ''.
    REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>horizontal_tab IN lv_b64 WITH ''.
    REPLACE ALL OCCURRENCES OF '-' IN lv_b64 WITH '+'.
    REPLACE ALL OCCURRENCES OF '_' IN lv_b64 WITH '/'.

    IF lv_b64 IS INITIAL.
      RETURN.
    ENDIF.

    lv_len = strlen( lv_b64 ).
    lv_mod = lv_len MOD 4.
    IF lv_mod = 2.
      lv_b64 = lv_b64 && '=='.
    ELSEIF lv_mod = 3.
      lv_b64 = lv_b64 && '='.
    ELSEIF lv_mod = 1.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING
          message = 'Designer payload is not valid base64url'.
    ENDIF.

    rv_string = xstring_to_string( cl_http_utility=>decode_x_base64( lv_b64 ) ).
  ENDMETHOD.

ENDCLASS.

*& lcl_pdf_data_binder
CLASS lcl_pdf_data_binder IMPLEMENTATION.

  METHOD render.
    rv_result = NEW lcl_pdf_data_binder( )->run(
      iv_template = iv_template
      is_data     = is_data ).
  ENDMETHOD.

  METHOD run.
    DATA lr_root TYPE REF TO data.
    GET REFERENCE OF is_data INTO lr_root.
    APPEND lr_root TO mt_ctx.
    CLEAR mt_fmt.
    rv_result = render_template( apply_patterns( iv_template ) ).
  ENDMETHOD.


  METHOD apply_fmt_marks.
    DATA lv_pos TYPE i.
    DATA lv_at TYPE i.
    DATA lv_endq TYPE i.
    DATA lv_fmt TYPE string.
    DATA lv_gt TYPE i.
    DATA lv_close TYPE i.
    DATA lv_path TYPE string.
    DATA lv_token TYPE string.
    DATA lv_value TYPE string.
    DATA lv_shown TYPE string.
    DATA lv_mark TYPE string VALUE 'data-fmt="'.

    rv_html = iv_html.
    WHILE lv_pos < strlen( rv_html ).
      lv_at = find( val = rv_html sub = lv_mark off = lv_pos ).
      IF lv_at < 0.
        RETURN.
      ENDIF.
      lv_endq = find(
        val = rv_html
        sub = '"'
        off = lv_at + strlen( lv_mark ) ).
      IF lv_endq < 0.
        RETURN.
      ENDIF.
      lv_fmt = substring(
        val = rv_html
        off = lv_at + strlen( lv_mark )
        len = lv_endq - lv_at - strlen( lv_mark ) ).
      lv_gt = lv_endq + 1.
      IF lv_gt < strlen( rv_html )
        AND substring( val = rv_html off = lv_gt len = 1 ) = '>'.
        lv_gt = lv_gt + 1.
      ENDIF.
      IF lv_gt + 2 > strlen( rv_html )
        OR substring( val = rv_html off = lv_gt len = 2 ) <> '{{'.
        lv_pos = lv_endq + 1.
        CONTINUE.
      ENDIF.
      lv_close = find( val = rv_html sub = '}}' off = lv_gt + 2 ).
      IF lv_close < 0.
        RETURN.
      ENDIF.
      lv_path = trim( substring(
        val = rv_html
        off = lv_gt + 2
        len = lv_close - lv_gt - 2 ) ).
      "Totals keep the format of their own span only; block tags carry none.
      IF lv_path(1) CA '#/^' OR is_aggregate( lv_path ) = abap_true.
        lv_pos = lv_close + 2.
        CONTINUE.
      ENDIF.
      remember_pattern( iv_path = lv_path iv_pattern = lv_fmt ).
      lv_token = substring(
        val = rv_html
        off = lv_gt
        len = lv_close + 2 - lv_gt ).
      "Fields inside {{#each}} are formatted later, at render time.
      TRY.
          lv_value = resolve_text( lv_path ).
        CATCH cx_pdf_error.
          lv_pos = lv_close + 2.
          CONTINUE.
      ENDTRY.
      lv_shown = format_display( iv_value = lv_value iv_pattern = lv_fmt ).
      IF lv_shown <> lv_value.
        rv_html = substring( val = rv_html off = 0 len = lv_gt ) &&
          lv_shown &&
          substring( val = rv_html off = lv_close + 2 ).
        lv_pos = lv_gt + strlen( lv_shown ).
      ELSE.
        lv_pos = lv_close + 2.
      ENDIF.
    ENDWHILE.
  ENDMETHOD.


  METHOD apply_patterns.
    DATA lv_mark TYPE string VALUE '<!--abappdf:'.
    DATA lv_at TYPE i.
    DATA lv_end TYPE i.
    DATA lv_json TYPE string.
    DATA lv_body TYPE string.
    DATA lv_pos TYPE i.
    DATA lv_len TYPE i.
    DATA lv_obj_at TYPE i.
    DATA lv_depth TYPE i.
    DATA lv_in_str TYPE abap_bool.
    DATA lv_esc TYPE abap_bool.
    DATA lv_ch TYPE c LENGTH 1.
    DATA lv_obj TYPE string.
    DATA lv_text TYPE string.
    DATA lv_fmt TYPE string.
    DATA lv_path TYPE string.
    DATA lv_value TYPE string.
    DATA lv_shown TYPE string.

    rv_template = iv_template.
    lv_at = find( val = iv_template sub = '<!--abappdf64:' ).
    IF lv_at >= 0.
      lv_mark = '<!--abappdf64:'.
    ELSE.
      lv_at = find( val = iv_template sub = lv_mark ).
      IF lv_at < 0.
        rv_template = apply_fmt_marks( iv_template ).
        RETURN.
      ENDIF.
    ENDIF.
    lv_end = find( val = iv_template sub = '-->' off = lv_at ).
    IF lv_end < 0.
      RETURN.
    ENDIF.
    lv_json = substring(
      val = iv_template
      off = lv_at + strlen( lv_mark )
      len = lv_end - lv_at - strlen( lv_mark ) ).
    IF lv_mark = '<!--abappdf64:'.
      TRY.
          lv_json = lcl_pdf_convert=>base64url_decode( lv_json ).
        CATCH cx_pdf_error.
          rv_template = substring( val = iv_template off = 0 len = lv_end + 3 ) &&
            apply_fmt_marks( substring( val = iv_template off = lv_end + 3 ) ).
          RETURN.
      ENDTRY.
    ELSE.
      REPLACE ALL OCCURRENCES OF '- -' IN lv_json WITH '--'.
    ENDIF.
    "Skip the widget scan when no widget carries a date format.
    IF lv_json NS '"dateFmt"' AND lv_json NS 'Date/Time Field'.
      rv_template = substring( val = iv_template off = 0 len = lv_end + 3 ) &&
        apply_fmt_marks( substring( val = iv_template off = lv_end + 3 ) ).
      RETURN.
    ENDIF.
    lv_body = apply_fmt_marks( substring( val = iv_template off = lv_end + 3 ) ).

    lv_pos = find( val = lv_json sub = '"widgets":[' ).
    IF lv_pos < 0.
      rv_template = substring( val = iv_template off = 0 len = lv_end + 3 ) && lv_body.
      RETURN.
    ENDIF.
    lv_pos = lv_pos + strlen( '"widgets":[' ).
    lv_len = strlen( lv_json ).

    WHILE lv_pos < lv_len.
      lv_ch = substring( val = lv_json off = lv_pos len = 1 ).
      IF lv_ch = ']'.
        EXIT.
      ENDIF.
      IF lv_ch <> '{'.
        lv_pos = lv_pos + 1.
        CONTINUE.
      ENDIF.

      lv_obj_at = lv_pos.
      lv_depth = 0.
      lv_in_str = abap_false.
      lv_esc = abap_false.
      WHILE lv_pos < lv_len.
        lv_ch = substring( val = lv_json off = lv_pos len = 1 ).
        IF lv_in_str = abap_true.
          IF lv_esc = abap_true.
            lv_esc = abap_false.
          ELSEIF lv_ch = '\'.
            lv_esc = abap_true.
          ELSEIF lv_ch = '"'.
            lv_in_str = abap_false.
          ENDIF.
        ELSEIF lv_ch = '"'.
          lv_in_str = abap_true.
        ELSEIF lv_ch = '{'.
          lv_depth = lv_depth + 1.
        ELSEIF lv_ch = '}'.
          lv_depth = lv_depth - 1.
          IF lv_depth = 0.
            lv_obj = substring(
              val = lv_json
              off = lv_obj_at
              len = lv_pos - lv_obj_at + 1 ).
            lv_pos = lv_pos + 1.
            EXIT.
          ENDIF.
        ENDIF.
        lv_pos = lv_pos + 1.
      ENDWHILE.

      lv_fmt = json_string_value( iv_json = lv_obj iv_key = 'dateFmt' ).
      lv_text = json_string_value( iv_json = lv_obj iv_key = 'text' ).
      IF lv_fmt IS INITIAL
        AND json_string_value( iv_json = lv_obj iv_key = 'type' ) = 'Date/Time Field'.
        lv_fmt = 'YYYY-MM-DD'.
      ENDIF.
      lv_text = trim( lv_text ).
      IF lv_fmt IS INITIAL
        OR strlen( lv_text ) < 5
        OR lv_text(2) <> '{{'
        OR substring( val = lv_text off = strlen( lv_text ) - 2 ) <> '}}'.
        CONTINUE.
      ENDIF.
      lv_path = trim( substring( val = lv_text off = 2 len = strlen( lv_text ) - 4 ) ).
      IF lv_path IS INITIAL OR lv_path CS ' '.
        CONTINUE.
      ENDIF.
      remember_pattern( iv_path = lv_path iv_pattern = lv_fmt ).
      TRY.
          lv_value = resolve_text( lv_path ).
        CATCH cx_pdf_error.
          CONTINUE.
      ENDTRY.
      lv_shown = format_display( iv_value = lv_value iv_pattern = lv_fmt ).
      IF lv_shown <> lv_value.
        REPLACE FIRST OCCURRENCE OF lv_text IN lv_body WITH lv_shown.
      ENDIF.
    ENDWHILE.

    rv_template = substring( val = iv_template off = 0 len = lv_end + 3 ) && lv_body.
  ENDMETHOD.


  METHOD format_display.
    DATA lv_digits TYPE string.
    DATA lv_len TYPE i.
    DATA lv_i TYPE i.
    DATA lv_ch TYPE c LENGTH 1.
    DATA lv_day TYPE string.
    DATA lv_month TYPE string.
    DATA lv_year TYPE string.
    DATA lv_hour TYPE string.
    DATA lv_min TYPE string.
    DATA lv_sec TYPE string.
    DATA lv_date TYPE string.
    DATA lv_time TYPE string.

    rv_text = iv_value.
    IF iv_pattern IS INITIAL OR iv_value IS INITIAL.
      RETURN.
    ENDIF.
    IF iv_pattern(1) CA '#0' OR ( strlen( iv_pattern ) > 2 AND iv_pattern(2) = 'AR' AND iv_pattern+2(1) CA '#0' ).
      rv_text = number_pattern( iv_value = iv_value iv_pattern = iv_pattern ).
      RETURN.
    ENDIF.

    lv_len = strlen( iv_value ).
    DO lv_len TIMES.
      lv_i = sy-index - 1.
      lv_ch = substring( val = iv_value off = lv_i len = 1 ).
      IF lv_ch CA '0123456789'.
        lv_digits = lv_digits && lv_ch.
      ENDIF.
    ENDDO.

    IF strlen( lv_digits ) = 8.
      lv_day = substring( val = lv_digits off = 0 len = 2 ).
      lv_month = substring( val = lv_digits off = 2 len = 2 ).
      lv_year = substring( val = lv_digits off = 4 len = 4 ).
      CASE iv_pattern.
        WHEN 'MM/DD/YYYY'.
          lv_date = |{ lv_month }/{ lv_day }/{ lv_year }|.
        WHEN 'DD.MM.YYYY'.
          lv_date = |{ lv_day }.{ lv_month }.{ lv_year }|.
        WHEN 'YYYY/MM/DD'.
          lv_date = |{ lv_year }/{ lv_month }/{ lv_day }|.
        WHEN 'YYYY-MM-DD' OR 'YYYY-MM-DD HH:MM'.
          lv_date = |{ lv_year }-{ lv_month }-{ lv_day }|.
        WHEN 'AR'.
          lv_date = arabic_digits( |{ lv_year }/{ lv_month }/{ lv_day }| ).
        WHEN OTHERS.
          lv_date = |{ lv_day }/{ lv_month }/{ lv_year }|.
      ENDCASE.
      IF iv_pattern = 'YYYY-MM-DD HH:MM'.
        rv_text = |{ lv_date } 00:00|.
      ELSEIF iv_pattern = 'DD/MM/YYYY HH:MM'.
        rv_text = |{ lv_date } 00:00|.
      ELSEIF iv_pattern CP 'HH*'.
        RETURN.
      ELSE.
        rv_text = lv_date.
      ENDIF.
      RETURN.
    ENDIF.

    IF strlen( lv_digits ) = 6 OR strlen( lv_digits ) = 4.
      lv_hour = substring( val = lv_digits off = 0 len = 2 ).
      lv_min = substring( val = lv_digits off = 2 len = 2 ).
      IF strlen( lv_digits ) = 6.
        lv_sec = substring( val = lv_digits off = 4 len = 2 ).
      ELSE.
        lv_sec = '00'.
      ENDIF.
      lv_time = |{ lv_hour }:{ lv_min }|.
      CASE iv_pattern.
        WHEN 'HH:MM'.
          rv_text = lv_time.
        WHEN 'HH:MM:SS'.
          rv_text = |{ lv_hour }:{ lv_min }:{ lv_sec }|.
        WHEN 'YYYY-MM-DD HH:MM'.
          rv_text = lv_time.
        WHEN 'DD/MM/YYYY HH:MM'.
          rv_text = lv_time.
        WHEN OTHERS.
          RETURN.
      ENDCASE.
    ENDIF.
  ENDMETHOD.


  METHOD remember_pattern.
    DATA ls_fmt TYPE ty_fmt.
    FIELD-SYMBOLS <fmt> TYPE ty_fmt.

    IF iv_pattern IS INITIAL OR iv_path IS INITIAL.
      RETURN.
    ENDIF.
    ls_fmt-path = to_upper( trim( iv_path ) ).
    ls_fmt-pattern = trim( iv_pattern ).
    IF ls_fmt-path IS INITIAL OR ls_fmt-pattern IS INITIAL.
      RETURN.
    ENDIF.
    READ TABLE mt_fmt ASSIGNING <fmt> WITH TABLE KEY path = ls_fmt-path.
    IF sy-subrc = 0.
      <fmt>-pattern = ls_fmt-pattern.
    ELSE.
      INSERT ls_fmt INTO TABLE mt_fmt.
    ENDIF.
  ENDMETHOD.


  METHOD pattern_for.
    DATA lv_from TYPE i.
    DATA lv_prefix TYPE string.
    DATA lv_len TYPE i.
    DATA lv_at TYPE i.
    DATA lv_hit TYPE i.
    DATA lv_endq TYPE i.
    DATA lv_key TYPE string VALUE 'data-fmt="'.
    DATA lv_prev TYPE i.
    DATA lv_ch TYPE c LENGTH 1.
    FIELD-SYMBOLS <fmt> TYPE ty_fmt.

    IF iv_at > 0.
      lv_from = iv_at - 120.
      IF lv_from < 0.
        lv_from = 0.
      ENDIF.
      lv_prefix = substring( val = iv_html off = lv_from len = iv_at - lv_from ).
      lv_len = strlen( lv_prefix ).
      WHILE lv_len > 0.
        lv_ch = substring( val = lv_prefix off = lv_len - 1 len = 1 ).
        IF lv_ch <> ' '.
          EXIT.
        ENDIF.
        lv_len = lv_len - 1.
        lv_prefix = substring( val = lv_prefix off = 0 len = lv_len ).
      ENDWHILE.
      IF lv_len > 1
        AND substring( val = lv_prefix off = lv_len - 1 len = 1 ) = '>'.
        lv_prefix = substring( val = lv_prefix off = 0 len = lv_len - 1 ).
        lv_len = strlen( lv_prefix ).
        IF lv_len > 1
          AND substring( val = lv_prefix off = lv_len - 1 len = 1 ) = '"'.
          lv_hit = -1.
          lv_at = 0.
          WHILE lv_at < lv_len.
            lv_endq = find( val = lv_prefix sub = lv_key off = lv_at ).
            IF lv_endq < 0.
              EXIT.
            ENDIF.
            lv_hit = lv_endq.
            lv_at = lv_endq + 1.
          ENDWHILE.
          IF lv_hit >= 0.
            lv_at = lv_hit + strlen( lv_key ).
            lv_endq = find( val = lv_prefix sub = '"' off = lv_at ).
            IF lv_endq = lv_len - 1.
              rv_pattern = trim( substring(
                val = lv_prefix
                off = lv_at
                len = lv_endq - lv_at ) ).
              IF rv_pattern IS NOT INITIAL.
                RETURN.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.

      lv_prev = iv_at - 1.
      WHILE lv_prev >= 0.
        lv_ch = substring( val = iv_html off = lv_prev len = 1 ).
        IF lv_ch <> ' '.
          EXIT.
        ENDIF.
        lv_prev = lv_prev - 1.
      ENDWHILE.
      IF lv_prev >= 0 AND lv_ch = '"'.
        RETURN.
      ENDIF.
    ENDIF.

    READ TABLE mt_fmt ASSIGNING <fmt>
      WITH TABLE KEY path = to_upper( trim( iv_path ) ).
    IF sy-subrc = 0.
      rv_pattern = <fmt>-pattern.
    ENDIF.
  ENDMETHOD.


  METHOD json_string_value.
    DATA lv_key TYPE string.
    DATA lv_at TYPE i.
    DATA lv_pos TYPE i.
    DATA lv_len TYPE i.
    DATA lv_ch TYPE c LENGTH 1.
    DATA lv_esc TYPE abap_bool.

    lv_key = |"{ iv_key }":"|.
    lv_at = find( val = iv_json sub = lv_key ).
    IF lv_at < 0.
      RETURN.
    ENDIF.
    lv_pos = lv_at + strlen( lv_key ).
    lv_len = strlen( iv_json ).
    WHILE lv_pos < lv_len.
      lv_ch = substring( val = iv_json off = lv_pos len = 1 ).
      IF lv_esc = abap_true.
        rv_value = rv_value && lv_ch.
        lv_esc = abap_false.
      ELSEIF lv_ch = '\'.
        lv_esc = abap_true.
      ELSEIF lv_ch = '"'.
        RETURN.
      ELSE.
        rv_value = rv_value && lv_ch.
      ENDIF.
      lv_pos = lv_pos + 1.
    ENDWHILE.
  ENDMETHOD.


  METHOD arabic_digits.
    DATA lv_len TYPE i.
    DATA lv_i TYPE i.
    DATA lv_ch TYPE c LENGTH 1.

    lv_len = strlen( iv_text ).
    DO lv_len TIMES.
      lv_i = sy-index - 1.
      lv_ch = substring( val = iv_text off = lv_i len = 1 ).
      CASE lv_ch.
        WHEN '0'. rv_text = rv_text && '٠'.
        WHEN '1'. rv_text = rv_text && '١'.
        WHEN '2'. rv_text = rv_text && '٢'.
        WHEN '3'. rv_text = rv_text && '٣'.
        WHEN '4'. rv_text = rv_text && '٤'.
        WHEN '5'. rv_text = rv_text && '٥'.
        WHEN '6'. rv_text = rv_text && '٦'.
        WHEN '7'. rv_text = rv_text && '٧'.
        WHEN '8'. rv_text = rv_text && '٨'.
        WHEN '9'. rv_text = rv_text && '٩'.
        WHEN OTHERS. rv_text = rv_text && lv_ch.
      ENDCASE.
    ENDDO.
  ENDMETHOD.

  METHOD render_template.
    DATA lv_pos TYPE i VALUE 0.
    DATA lv_len TYPE i.
    DATA lv_open TYPE i.
    DATA lv_end TYPE i.
    DATA lv_after TYPE i.
    DATA lv_tag_text TYPE string.
    DATA ls_tag TYPE ty_tag.
    DATA lv_inner TYPE string.
    DATA lv_else TYPE string.
    DATA lv_block_end TYPE i.
    DATA lv_piece TYPE string.
    DATA lv_fmt TYPE string.
    DATA lr_section TYPE REF TO data.
    DATA lv_found TYPE abap_bool.
    FIELD-SYMBOLS <section> TYPE any.

    lv_len = strlen( iv_template ).

    WHILE lv_pos < lv_len.
      lv_open = find(
        val = iv_template
        sub = '{{'
        off = lv_pos ).
      IF lv_open < 0.
        rv_result = rv_result && substring(
          val = iv_template
          off = lv_pos ).
        RETURN.
      ENDIF.

      IF lv_open > lv_pos.
        rv_result = rv_result && substring(
          val = iv_template
          off = lv_pos
          len = lv_open - lv_pos ).
      ENDIF.

      IF lv_open + 3 <= lv_len AND iv_template+lv_open(3) = '{{{'.
        lv_end = find(
          val = iv_template
          sub = '}}}'
          off = lv_open + 3 ).
        IF lv_end < 0.
          RAISE EXCEPTION TYPE cx_pdf_error
            EXPORTING
              message = 'Unclosed {{{ in template'.
        ENDIF.
        lv_tag_text = substring(
          val = iv_template
          off = lv_open + 3
          len = lv_end - lv_open - 3 ).
        rv_result = rv_result && sanitize_raw( resolve_text( trim( lv_tag_text ) ) ).
        lv_pos = lv_end + 3.
        CONTINUE.
      ENDIF.

      lv_end = find(
        val = iv_template
        sub = '}}'
        off = lv_open + 2 ).
      IF lv_end < 0.
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING
            message = 'Unclosed {{ in template'.
      ENDIF.

      lv_tag_text = trim( substring(
        val = iv_template
        off = lv_open + 2
        len = lv_end - lv_open - 2 ) ).
      lv_after = lv_end + 2.
      ls_tag = classify_tag( lv_tag_text ).

      CASE ls_tag-kind.
        WHEN 'comment'.
          lv_pos = lv_after.
        WHEN 'close' OR 'else'.
          RAISE EXCEPTION TYPE cx_pdf_error
            EXPORTING message = |Unexpected template tag at offset { lv_open }: { lv_tag_text }|.
        WHEN 'var'.
          IF is_aggregate( ls_tag-path ) = abap_true.
            lv_piece = aggregate( ls_tag-path ).
          ELSE.
            lv_piece = resolve_text( ls_tag-path ).
          ENDIF.
          lv_fmt = pattern_for(
            iv_html = iv_template
            iv_at   = lv_open
            iv_path = ls_tag-path ).
          IF lv_fmt IS NOT INITIAL.
            lv_piece = format_display( iv_value = lv_piece iv_pattern = lv_fmt ).
          ENDIF.
          rv_result = rv_result && escape_html( lv_piece ).
          lv_pos = lv_after.
        WHEN 'each' OR 'if' OR 'section' OR 'inverted'.
          find_block_end(
            EXPORTING
              iv_template = iv_template
              iv_start    = lv_after
              iv_close    = ls_tag-close
            IMPORTING
              ev_inner    = lv_inner
              ev_else     = lv_else
              ev_end      = lv_block_end ).
          CASE ls_tag-kind.
            WHEN 'each'.
              rv_result = rv_result && render_each(
                iv_path  = ls_tag-path
                iv_inner = lv_inner
                iv_else  = lv_else ).
            WHEN 'if'.
              rv_result = rv_result && render_if(
                iv_path  = ls_tag-path
                iv_inner = lv_inner
                iv_else  = lv_else ).
            WHEN 'inverted'.
              rv_result = rv_result && render_if(
                iv_path     = ls_tag-path
                iv_inner    = lv_inner
                iv_else     = lv_else
                iv_inverted = abap_true ).
            WHEN 'section'.
              CLEAR lr_section.
              CLEAR lv_found.
              try_resolve(
                EXPORTING
                  iv_path  = ls_tag-path
                IMPORTING
                  eo_data  = lr_section
                  ev_found = lv_found ).
              IF lv_found = abap_true.
                ASSIGN lr_section->* TO <section>.
                IF sy-subrc <> 0.
                  CLEAR lv_found.
                ELSEIF cl_abap_typedescr=>describe_by_data( <section> )->kind
                    <> cl_abap_typedescr=>kind_table.
                  CLEAR lv_found.
                ENDIF.
              ENDIF.
              IF lv_found = abap_true.
                rv_result = rv_result && render_each(
                  iv_path  = ls_tag-path
                  iv_inner = lv_inner
                  iv_else  = lv_else ).
              ELSE.
                rv_result = rv_result && render_if(
                  iv_path  = ls_tag-path
                  iv_inner = lv_inner
                  iv_else  = lv_else ).
              ENDIF.
          ENDCASE.
          lv_pos = lv_block_end.
      ENDCASE.
    ENDWHILE.
  ENDMETHOD.

  METHOD find_block_end.
    DATA lv_pos TYPE i.
    DATA lv_len TYPE i.
    DATA lv_depth TYPE i VALUE 1.
    DATA lv_open TYPE i.
    DATA lv_end TYPE i.
    DATA lv_tag_text TYPE string.
    DATA ls_tag TYPE ty_tag.
    DATA lv_else_open TYPE i VALUE -1.
    DATA lv_else_after TYPE i.
    DATA lt_closes TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    DATA lv_expected TYPE string.
    APPEND to_upper( iv_close ) TO lt_closes.

    lv_pos = iv_start.
    lv_len = strlen( iv_template ).

    WHILE lv_pos < lv_len.
      lv_open = find(
        val = iv_template
        sub = '{{'
        off = lv_pos ).
      IF lv_open < 0.
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING
            message = |Unclosed block /{ iv_close }|.
      ENDIF.

      IF lv_open + 3 <= lv_len AND iv_template+lv_open(3) = '{{{'.
        lv_end = find(
          val = iv_template
          sub = '}}}'
          off = lv_open + 3 ).
        IF lv_end < 0.
          RAISE EXCEPTION TYPE cx_pdf_error
            EXPORTING
              message = 'Unclosed {{{ in template'.
        ENDIF.
        lv_pos = lv_end + 3.
        CONTINUE.
      ENDIF.

      lv_end = find(
        val = iv_template
        sub = '}}'
        off = lv_open + 2 ).
      IF lv_end < 0.
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING
            message = 'Unclosed {{ in template'.
      ENDIF.

      lv_tag_text = trim( substring(
        val = iv_template
        off = lv_open + 2
        len = lv_end - lv_open - 2 ) ).
      ls_tag = classify_tag( lv_tag_text ).

      IF ls_tag-kind = 'each'
          OR ls_tag-kind = 'if'
          OR ls_tag-kind = 'section'
          OR ls_tag-kind = 'inverted'.
        lv_depth = lv_depth + 1.
        IF lv_depth > 50.
          RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Template nesting exceeds 50 levels'.
        ENDIF.
        APPEND to_upper( ls_tag-close ) TO lt_closes.
      ELSEIF ls_tag-kind = 'close'.
        READ TABLE lt_closes INDEX lv_depth INTO lv_expected.
        IF lv_expected <> to_upper( ls_tag-path ).
          RAISE EXCEPTION TYPE cx_pdf_error
            EXPORTING message = |Expected /{ lv_expected } but found /{ ls_tag-path }|.
        ENDIF.
        DELETE lt_closes INDEX lv_depth.
        lv_depth = lv_depth - 1.
        IF lv_depth = 0.
          IF to_upper( ls_tag-path ) <> to_upper( iv_close ).
            RAISE EXCEPTION TYPE cx_pdf_error
              EXPORTING
                message = |Expected /{ iv_close } but found /{ ls_tag-path }|.
          ENDIF.
          IF lv_else_open < 0.
            ev_inner = substring(
              val = iv_template
              off = iv_start
              len = lv_open - iv_start ).
            CLEAR ev_else.
          ELSE.
            ev_inner = substring(
              val = iv_template
              off = iv_start
              len = lv_else_open - iv_start ).
            ev_else = substring(
              val = iv_template
              off = lv_else_after
              len = lv_open - lv_else_after ).
          ENDIF.
          ev_end = lv_end + 2.
          RETURN.
        ENDIF.
      ELSEIF ls_tag-kind = 'else' AND lv_depth = 1.
        IF lv_else_open >= 0.
          RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Duplicate else in template block'.
        ENDIF.
        lv_else_open = lv_open.
        lv_else_after = lv_end + 2.
      ENDIF.

      lv_pos = lv_end + 2.
    ENDWHILE.

    RAISE EXCEPTION TYPE cx_pdf_error
      EXPORTING
        message = |Unclosed block /{ iv_close }|.
  ENDMETHOD.

  METHOD classify_tag.
    DATA lv_tag TYPE string.
    DATA lv_len TYPE i.

    lv_tag = trim( iv_tag ).
    lv_len = strlen( lv_tag ).

    IF lv_len = 0.
      rs_tag-kind = 'var'.
      RETURN.
    ENDIF.

    IF lv_tag(1) = '!'.
      rs_tag-kind = 'comment'.
      RETURN.
    ENDIF.

    IF lv_tag = 'else'.
      rs_tag-kind = 'else'.
      RETURN.
    ENDIF.

    IF lv_tag(1) = '/'.
      rs_tag-kind = 'close'.
      rs_tag-path = trim( substring( val = lv_tag off = 1 ) ).
      rs_tag-close = rs_tag-path.
      RETURN.
    ENDIF.

    "A trailing blank in a text literal is ignored in comparisons, so test the blank explicitly.
    IF lv_tag = '#each' OR ( lv_len >= 6 AND lv_tag(5) = '#each' AND find( val = lv_tag sub = ` ` ) = 5 ).
      rs_tag-kind = 'each'.
      rs_tag-close = 'each'.
      IF lv_len > 5.
        rs_tag-path = trim( substring( val = lv_tag off = 5 ) ).
      ENDIF.
      IF rs_tag-path IS INITIAL.
        rs_tag-path = '.'.
      ENDIF.
      RETURN.
    ENDIF.

    IF lv_tag = '#if' OR ( lv_len >= 4 AND lv_tag(3) = '#if' AND find( val = lv_tag sub = ` ` ) = 3 ).
      rs_tag-kind = 'if'.
      rs_tag-close = 'if'.
      IF lv_len > 3.
        rs_tag-path = trim( substring( val = lv_tag off = 3 ) ).
      ENDIF.
      IF rs_tag-path IS INITIAL.
        rs_tag-path = '.'.
      ENDIF.
      RETURN.
    ENDIF.

    IF lv_tag(1) = '#'.
      rs_tag-kind = 'section'.
      rs_tag-path = trim( substring( val = lv_tag off = 1 ) ).
      rs_tag-close = rs_tag-path.
      RETURN.
    ENDIF.

    IF lv_tag(1) = '^'.
      rs_tag-kind = 'inverted'.
      rs_tag-path = trim( substring( val = lv_tag off = 1 ) ).
      rs_tag-close = rs_tag-path.
      RETURN.
    ENDIF.

    rs_tag-kind = 'var'.
    rs_tag-path = lv_tag.
  ENDMETHOD.

  METHOD render_each.
    DATA lr_data TYPE REF TO data.
    DATA lv_found TYPE abap_bool.
    DATA lr_row TYPE REF TO data.
    FIELD-SYMBOLS <node> TYPE any.
    FIELD-SYMBOLS <table> TYPE ANY TABLE.
    FIELD-SYMBOLS <row> TYPE any.

    try_resolve(
      EXPORTING
        iv_path  = iv_path
      IMPORTING
        eo_data  = lr_data
        ev_found = lv_found ).

    IF lv_found = abap_false.
      rv_result = render_template( iv_else ).
      RETURN.
    ENDIF.

    ASSIGN lr_data->* TO <node>.
    IF sy-subrc <> 0.
      rv_result = render_template( iv_else ).
      RETURN.
    ENDIF.

    IF cl_abap_typedescr=>describe_by_data( <node> )->kind
        = cl_abap_typedescr=>kind_struct.
      APPEND 1 TO mt_rowno.
      APPEND lr_data TO mt_ctx.
      rv_result = render_template( iv_inner ).
      DELETE mt_ctx INDEX lines( mt_ctx ).
      DELETE mt_rowno INDEX lines( mt_rowno ).
      RETURN.
    ENDIF.

    ASSIGN <node> TO <table>.
    IF sy-subrc <> 0.
      rv_result = render_template( iv_else ).
      RETURN.
    ENDIF.

    IF lines( <table> ) = 0.
      rv_result = render_template( iv_else ).
      RETURN.
    ENDIF.

    DATA lv_row_number TYPE i.
    LOOP AT <table> ASSIGNING <row>.
      lv_row_number = lv_row_number + 1.
      APPEND lv_row_number TO mt_rowno.
      GET REFERENCE OF <row> INTO lr_row.
      APPEND lr_row TO mt_ctx.
      rv_result = rv_result && render_template( iv_inner ).
      DELETE mt_ctx INDEX lines( mt_ctx ).
      DELETE mt_rowno INDEX lines( mt_rowno ).
    ENDLOOP.
  ENDMETHOD.

  METHOD render_if.
    DATA lr_data TYPE REF TO data.
    DATA lv_found TYPE abap_bool.
    DATA lv_yes TYPE abap_bool.
    DATA lv_upper TYPE string.
    DATA lv_row TYPE i.

    "{{#if ROW_EVEN}} / {{#if ROW_ODD}}: position inside the current {{#each}}.
    lv_upper = to_upper( trim( iv_path ) ).
    IF ( lv_upper = 'ROW_EVEN' OR lv_upper = 'ROW_ODD' ) AND lines( mt_rowno ) > 0.
      READ TABLE mt_rowno INDEX lines( mt_rowno ) INTO lv_row.
      lv_yes = xsdbool( lv_row MOD 2 = 0 ).
      IF lv_upper = 'ROW_ODD'.
        lv_yes = xsdbool( lv_yes = abap_false ).
      ENDIF.
      IF iv_inverted = abap_true.
        lv_yes = xsdbool( lv_yes = abap_false ).
      ENDIF.
      IF lv_yes = abap_true.
        rv_result = render_template( iv_inner ).
      ELSE.
        rv_result = render_template( iv_else ).
      ENDIF.
      RETURN.
    ENDIF.

    try_resolve(
      EXPORTING
        iv_path  = iv_path
      IMPORTING
        eo_data  = lr_data
        ev_found = lv_found ).

    IF lv_found = abap_true.
      lv_yes = is_truthy( lr_data ).
    ENDIF.

    IF iv_inverted = abap_true.
      lv_yes = xsdbool( lv_yes = abap_false ).
    ENDIF.

    IF lv_yes = abap_true.
      rv_result = render_template( iv_inner ).
    ELSE.
      rv_result = render_template( iv_else ).
    ENDIF.
  ENDMETHOD.

  METHOD resolve_text.
    DATA lr_data TYPE REF TO data.
    DATA lv_found TYPE abap_bool.
    IF to_upper( trim( iv_path ) ) = 'ROW' AND lines( mt_rowno ) > 0.
      READ TABLE mt_rowno INDEX lines( mt_rowno ) INTO DATA(lv_row).
      rv_text = |{ lv_row }|.
      RETURN.
    ENDIF.

    try_resolve(
      EXPORTING
        iv_path  = iv_path
      IMPORTING
        eo_data  = lr_data
        ev_found = lv_found ).
    IF lv_found = abap_false.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING message = |Unknown template field: { iv_path }|.
    ENDIF.
    rv_text = value_to_string( lr_data ).
  ENDMETHOD.

  METHOD try_resolve.
    DATA lv_path TYPE string.
    DATA lv_skip TYPE i.
    DATA lv_index TYPE i.
    DATA lv_walk TYPE abap_bool.
    DATA lr_ctx TYPE REF TO data.
    DATA lr_found TYPE REF TO data.

    CLEAR eo_data.
    ev_found = abap_false.
    lv_path = trim( iv_path ).

    WHILE strlen( lv_path ) >= 3 AND lv_path(3) = '../'.
      lv_skip = lv_skip + 1.
      lv_path = substring( val = lv_path off = 3 ).
    ENDWHILE.
    lv_path = trim( lv_path ).

    lv_index = lines( mt_ctx ) - lv_skip.
    WHILE lv_index >= 1.
      READ TABLE mt_ctx INDEX lv_index INTO lr_ctx.
      CLEAR lr_found.
      CLEAR lv_walk.
      CALL METHOD walk
        EXPORTING
          io_data  = lr_ctx
          iv_path  = lv_path
        IMPORTING
          eo_data  = lr_found
        RECEIVING
          rv_found = lv_walk.
      IF lv_walk = abap_true.
        eo_data = lr_found.
        ev_found = abap_true.
        RETURN.
      ENDIF.
      lv_index = lv_index - 1.
    ENDWHILE.
  ENDMETHOD.

  METHOD walk.
    DATA lv_path TYPE string.
    DATA lt_parts TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    DATA lv_part TYPE string.
    DATA lr_cur TYPE REF TO data.
    FIELD-SYMBOLS <node> TYPE any.
    FIELD-SYMBOLS <comp> TYPE any.

    rv_found = abap_false.
    CLEAR eo_data.
    IF io_data IS NOT BOUND.
      RETURN.
    ENDIF.

    lv_path = trim( iv_path ).
    REPLACE ALL OCCURRENCES OF '-' IN lv_path WITH '.'.
    IF lv_path IS INITIAL OR lv_path = '.'.
      eo_data = io_data.
      rv_found = abap_true.
      RETURN.
    ENDIF.

    lr_cur = io_data.
    SPLIT lv_path AT '.' INTO TABLE lt_parts.

    LOOP AT lt_parts INTO lv_part.
      lv_part = trim( lv_part ).
      IF lv_part IS INITIAL OR lv_part = '.'.
        CONTINUE.
      ENDIF.
      ASSIGN lr_cur->* TO <node>.
      IF sy-subrc <> 0.
        RETURN.
      ENDIF.
      IF cl_abap_typedescr=>describe_by_data( <node> )->kind
          <> cl_abap_typedescr=>kind_struct.
        RETURN.
      ENDIF.
      ASSIGN COMPONENT to_upper( lv_part ) OF STRUCTURE <node> TO <comp>.
      IF sy-subrc <> 0.
        RETURN.
      ENDIF.
      GET REFERENCE OF <comp> INTO lr_cur.
    ENDLOOP.

    eo_data = lr_cur.
    rv_found = abap_true.
  ENDMETHOD.

  METHOD is_truthy.
    DATA lo_type TYPE REF TO cl_abap_typedescr.
    FIELD-SYMBOLS <value> TYPE any.
    FIELD-SYMBOLS <table> TYPE ANY TABLE.

    rv_truthy = abap_false.
    IF io_data IS NOT BOUND.
      RETURN.
    ENDIF.

    ASSIGN io_data->* TO <value>.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    lo_type = cl_abap_typedescr=>describe_by_data( <value> ).
    CASE lo_type->kind.
      WHEN cl_abap_typedescr=>kind_table.
        ASSIGN io_data->* TO <table>.
        IF sy-subrc = 0 AND lines( <table> ) > 0.
          rv_truthy = abap_true.
        ENDIF.
      WHEN cl_abap_typedescr=>kind_struct.
        rv_truthy = abap_true.
      WHEN OTHERS.
        IF <value> IS NOT INITIAL.
          rv_truthy = abap_true.
        ENDIF.
    ENDCASE.
  ENDMETHOD.

  METHOD value_to_string.
    DATA lo_type TYPE REF TO cl_abap_typedescr.
    FIELD-SYMBOLS <value> TYPE any.
    DATA lv_text TYPE string.
    DATA lv_char TYPE c LENGTH 255.

    IF io_data IS NOT BOUND.
      RETURN.
    ENDIF.
    ASSIGN io_data->* TO <value>.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    lo_type = cl_abap_typedescr=>describe_by_data( <value> ).
    IF lo_type->kind <> cl_abap_typedescr=>kind_elem.
      RETURN.
    ENDIF.

    CASE lo_type->type_kind.
      WHEN cl_abap_typedescr=>typekind_char
        OR cl_abap_typedescr=>typekind_string
        OR cl_abap_typedescr=>typekind_num.
        lv_text = <value>.
      WHEN OTHERS.
        WRITE <value> TO lv_char LEFT-JUSTIFIED.
        CONDENSE lv_char.
        lv_text = lv_char.
    ENDCASE.
    rv_text = lv_text.
  ENDMETHOD.

  METHOD sanitize_raw.
    "Allow-list sanitizer in one pass: text is copied, known tags are rebuilt from their
    "allowed attributes, dangerous elements are removed with their content, every other
    "tag is dropped (its text stays), and a stray '<' is escaped.
    DATA lt_out TYPE string_table.
    DATA lv_lower TYPE string.
    DATA lv_len TYPE i.
    DATA lv_pos TYPE i.
    DATA lv_lt TYPE i.
    DATA lv_gt TYPE i.
    DATA lv_end TYPE i.
    DATA lv_next TYPE string.
    DATA lv_name TYPE string.
    DATA lv_tag TYPE string.

    IF iv_html NA '<'.
      rv_html = iv_html.
      RETURN.
    ENDIF.
    lv_lower = to_lower( iv_html ).
    lv_len = strlen( iv_html ).

    WHILE lv_pos < lv_len.
      lv_lt = find( val = iv_html sub = `<` off = lv_pos ).
      IF lv_lt < 0.
        APPEND substring( val = iv_html off = lv_pos ) TO lt_out.
        EXIT.
      ENDIF.
      IF lv_lt > lv_pos.
        APPEND substring( val = iv_html off = lv_pos len = lv_lt - lv_pos ) TO lt_out.
      ENDIF.
      lv_pos = lv_lt + 1.
      IF lv_pos >= lv_len.
        APPEND `&lt;` TO lt_out.
        EXIT.
      ENDIF.
      lv_next = substring( val = iv_html off = lv_pos len = 1 ).

      IF lv_next = `!` OR lv_next = `?`.
        "Comments, doctype, CDATA and processing instructions are removed.
        IF lv_pos + 3 <= lv_len AND substring( val = iv_html off = lv_pos len = 3 ) = `!--`.
          lv_end = find( val = iv_html sub = `-->` off = lv_pos + 3 ).
          IF lv_end < 0.
            EXIT.
          ENDIF.
          lv_pos = lv_end + 3.
        ELSE.
          lv_gt = find( val = iv_html sub = `>` off = lv_pos ).
          IF lv_gt < 0.
            EXIT.
          ENDIF.
          lv_pos = lv_gt + 1.
        ENDIF.

      ELSEIF lv_next = `/`.
        "Closing tag: kept only for allowed tags, without attributes.
        lv_gt = find( val = iv_html sub = `>` off = lv_pos ).
        IF lv_gt < 0.
          EXIT.
        ENDIF.
        lv_name = tag_name( iv_lower = lv_lower iv_start = lv_pos + 1 ).
        IF lv_name IS NOT INITIAL AND c_raw_tags CS |\|{ lv_name }\||.
          APPEND |</{ lv_name }>| TO lt_out.
        ENDIF.
        lv_pos = lv_gt + 1.

      ELSEIF lv_next CA c_raw_letters.
        lv_name = tag_name( iv_lower = lv_lower iv_start = lv_pos ).
        sanitize_tag(
          EXPORTING iv_html  = iv_html
                    iv_name  = lv_name
                    iv_start = lv_pos + strlen( lv_name )
          IMPORTING ev_tag   = lv_tag
                    ev_end   = lv_gt ).
        IF lv_gt < 0.
          "Unterminated tag: the rest of the value is dropped.
          EXIT.
        ENDIF.
        lv_pos = lv_gt + 1.
        IF c_raw_drop CS |\|{ lv_name }\||.
          lv_end = find( val = lv_lower sub = |</{ lv_name }| off = lv_pos ).
          IF lv_end < 0.
            EXIT.
          ENDIF.
          lv_gt = find( val = lv_lower sub = `>` off = lv_end ).
          IF lv_gt < 0.
            EXIT.
          ENDIF.
          lv_pos = lv_gt + 1.
        ELSEIF c_raw_tags CS |\|{ lv_name }\||.
          APPEND lv_tag TO lt_out.
        ENDIF.

      ELSE.
        "'<' that does not start a tag is text.
        APPEND `&lt;` TO lt_out.
      ENDIF.
    ENDWHILE.

    rv_html = concat_lines_of( table = lt_out ).
  ENDMETHOD.

  METHOD tag_name.
    DATA lv_pos TYPE i.
    DATA lv_len TYPE i.
    lv_len = strlen( iv_lower ).
    lv_pos = iv_start.
    WHILE lv_pos < lv_len.
      IF substring( val = iv_lower off = lv_pos len = 1 ) NA c_raw_namechar.
        EXIT.
      ENDIF.
      lv_pos = lv_pos + 1.
    ENDWHILE.
    IF lv_pos > iv_start.
      rv_name = substring( val = iv_lower off = iv_start len = lv_pos - iv_start ).
    ENDIF.
  ENDMETHOD.

  METHOD sanitize_tag.
    "Attribute syntax as browsers read it: name, optional '=' and a quoted or unquoted value.
    DATA lv_sep TYPE string.
    DATA lv_stop TYPE string.
    DATA lv_len TYPE i.
    DATA lv_pos TYPE i.
    DATA lv_start TYPE i.
    DATA lv_close TYPE i.
    DATA lv_ch TYPE string.
    DATA lv_attr TYPE string.
    DATA lv_value TYPE string.
    DATA lv_clean TYPE string.
    DATA lv_has_value TYPE abap_bool.

    lv_sep = | /\t\n\r| && cl_abap_char_utilities=>form_feed.
    lv_stop = lv_sep && `=>`.
    ev_tag = |<{ iv_name }|.
    ev_end = -1.
    lv_len = strlen( iv_html ).
    lv_pos = iv_start.

    WHILE lv_pos < lv_len.
      lv_ch = substring( val = iv_html off = lv_pos len = 1 ).
      IF lv_ch = `>`.
        ev_end = lv_pos.
        ev_tag = ev_tag && `>`.
        RETURN.
      ENDIF.
      IF lv_ch CA lv_sep.
        lv_pos = lv_pos + 1.
        CONTINUE.
      ENDIF.

      "Attribute name.
      lv_start = lv_pos.
      WHILE lv_pos < lv_len.
        IF substring( val = iv_html off = lv_pos len = 1 ) CA lv_stop.
          EXIT.
        ENDIF.
        lv_pos = lv_pos + 1.
      ENDWHILE.
      lv_attr = to_lower( substring( val = iv_html off = lv_start len = lv_pos - lv_start ) ).
      IF lv_attr IS INITIAL.
        "A lone '=' is skipped.
        lv_pos = lv_pos + 1.
        CONTINUE.
      ENDIF.

      "Optional value.
      CLEAR: lv_value, lv_has_value.
      WHILE lv_pos < lv_len.
        IF substring( val = iv_html off = lv_pos len = 1 ) NA lv_sep.
          EXIT.
        ENDIF.
        lv_pos = lv_pos + 1.
      ENDWHILE.
      IF lv_pos < lv_len AND substring( val = iv_html off = lv_pos len = 1 ) = `=`.
        lv_has_value = abap_true.
        lv_pos = lv_pos + 1.
        WHILE lv_pos < lv_len.
          IF substring( val = iv_html off = lv_pos len = 1 ) NA lv_sep.
            EXIT.
          ENDIF.
          lv_pos = lv_pos + 1.
        ENDWHILE.
        IF lv_pos < lv_len.
          lv_ch = substring( val = iv_html off = lv_pos len = 1 ).
          IF lv_ch = `"` OR lv_ch = `'`.
            lv_close = find( val = iv_html sub = lv_ch off = lv_pos + 1 ).
            IF lv_close < 0.
              RETURN.
            ENDIF.
            lv_value = substring( val = iv_html off = lv_pos + 1 len = lv_close - lv_pos - 1 ).
            lv_pos = lv_close + 1.
          ELSE.
            lv_start = lv_pos.
            WHILE lv_pos < lv_len.
              lv_ch = substring( val = iv_html off = lv_pos len = 1 ).
              IF lv_ch CA lv_sep OR lv_ch = `>`.
                EXIT.
              ENDIF.
              lv_pos = lv_pos + 1.
            ENDWHILE.
            lv_value = substring( val = iv_html off = lv_start len = lv_pos - lv_start ).
          ENDIF.
        ENDIF.
      ENDIF.

      "Keep allowed attributes only, with checked and re-escaped values.
      IF c_raw_attrs NS |\|{ lv_attr }\||.
        CONTINUE.
      ENDIF.
      lv_clean = decode_attr( lv_value ).
      IF ( lv_attr = `href` OR lv_attr = `src` )
          AND safe_url( iv_attr = lv_attr iv_value = lv_clean ) = abap_false.
        CONTINUE.
      ENDIF.
      IF lv_attr = `style` AND safe_style( lv_clean ) = abap_false.
        CONTINUE.
      ENDIF.
      IF lv_has_value = abap_true.
        ev_tag = ev_tag && | { lv_attr }="{ escape_attr( lv_clean ) }"|.
      ELSE.
        ev_tag = ev_tag && | { lv_attr }|.
      ENDIF.
    ENDWHILE.
  ENDMETHOD.

  METHOD decode_attr.
    "Character references as browsers decode them in attribute values (';' optional).
    DATA lv_len TYPE i.
    DATA lv_pos TYPE i.
    DATA lv_amp TYPE i.
    DATA lv_stop TYPE i.
    DATA lv_ent TYPE string.
    DATA lv_num TYPE string.
    DATA lv_hex TYPE x LENGTH 4.
    DATA lv_code TYPE i.
    DATA lv_char TYPE string.

    lv_len = strlen( iv_value ).
    WHILE lv_pos < lv_len.
      lv_amp = find( val = iv_value sub = `&` off = lv_pos ).
      IF lv_amp < 0.
        rv_value = rv_value && substring( val = iv_value off = lv_pos ).
        RETURN.
      ENDIF.
      rv_value = rv_value && substring( val = iv_value off = lv_pos len = lv_amp - lv_pos ).
      lv_stop = lv_amp + 1.
      WHILE lv_stop < lv_len AND lv_stop - lv_amp <= 10.
        IF substring( val = iv_value off = lv_stop len = 1 ) NA |#{ c_raw_letters }0123456789|.
          EXIT.
        ENDIF.
        lv_stop = lv_stop + 1.
      ENDWHILE.
      lv_ent = to_lower( substring( val = iv_value off = lv_amp + 1 len = lv_stop - lv_amp - 1 ) ).
      lv_code = -1.
      IF strlen( lv_ent ) > 2 AND lv_ent(2) = `#x`.
        lv_num = to_upper( substring( val = lv_ent off = 2 ) ).
        IF lv_num CO '0123456789ABCDEF' AND strlen( lv_num ) <= 6.
          lv_num = |{ lv_num ALIGN = RIGHT WIDTH = 8 PAD = '0' }|.
          lv_hex = lv_num.
          lv_code = lv_hex.
        ENDIF.
      ELSEIF strlen( lv_ent ) > 1 AND lv_ent(1) = `#`.
        lv_num = substring( val = lv_ent off = 1 ).
        IF lv_num CO '0123456789' AND strlen( lv_num ) <= 7.
          lv_code = lv_num.
        ENDIF.
      ELSE.
        CASE lv_ent.
          WHEN `amp`.     lv_code = 38.
          WHEN `lt`.      lv_code = 60.
          WHEN `gt`.      lv_code = 62.
          WHEN `quot`.    lv_code = 34.
          WHEN `apos`.    lv_code = 39.
          WHEN `nbsp`.    lv_code = 160.
          WHEN `colon`.   lv_code = 58.
          WHEN `tab`.     lv_code = 9.
          WHEN `newline`. lv_code = 10.
          WHEN `sol`.     lv_code = 47.
          WHEN `lpar`.    lv_code = 40.
          WHEN `rpar`.    lv_code = 41.
          WHEN `semi`.    lv_code = 59.
        ENDCASE.
      ENDIF.
      IF lv_code < 0.
        "Not a character reference: the '&' is text.
        rv_value = rv_value && `&`.
        lv_pos = lv_amp + 1.
        CONTINUE.
      ENDIF.
      IF lv_code = 32.
        lv_char = ` `.
      ELSEIF lv_code > 0 AND lv_code < 65536 AND ( lv_code < 55296 OR lv_code > 57343 ).
        lv_char = cl_abap_conv_in_ce=>uccpi( lv_code ).
      ELSE.
        CLEAR lv_char.
      ENDIF.
      rv_value = rv_value && lv_char.
      lv_pos = lv_stop.
      IF lv_pos < lv_len AND substring( val = iv_value off = lv_pos len = 1 ) = `;`.
        lv_pos = lv_pos + 1.
      ENDIF.
    ENDWHILE.
  ENDMETHOD.

  METHOD safe_url.
    "Browsers ignore whitespace and control characters inside a URL scheme.
    DATA lv_url TYPE string.
    lv_url = to_lower( iv_value ).
    REPLACE ALL OCCURRENCES OF REGEX '[[:cntrl:][:space:]]' IN lv_url WITH ``.
    IF lv_url IS INITIAL.
      rv_yes = abap_true.
      RETURN.
    ENDIF.
    IF iv_attr = `src`.
      "Images must be embedded: no external or local URLs (no requests from the renderer).
      rv_yes = xsdbool( lv_url CP 'data:image/png;*' OR lv_url CP 'data:image/jpeg;*'
                     OR lv_url CP 'data:image/jpg;*' OR lv_url CP 'data:image/gif;*'
                     OR lv_url CP 'data:image/webp;*' ).
    ELSE.
      rv_yes = xsdbool( lv_url CP 'http://*' OR lv_url CP 'https://*'
                     OR lv_url CP 'mailto:*' OR lv_url CP '#*' ).
    ENDIF.
  ENDMETHOD.

  METHOD safe_style.
    DATA lv_css TYPE string.
    lv_css = to_lower( iv_value ).
    "Comments and escapes can split keywords (ur/**/l, \75rl), so both are removed first.
    REPLACE ALL OCCURRENCES OF REGEX '/\*[^*]*\*+([^/*][^*]*\*+)*/' IN lv_css WITH ``.
    REPLACE ALL OCCURRENCES OF REGEX '[[:cntrl:][:space:]]' IN lv_css WITH ``.
    rv_yes = xsdbool( lv_css NS '\' AND lv_css NS 'url(' AND lv_css NS 'expression('
                  AND lv_css NS 'javascript:' AND lv_css NS 'vbscript:' AND lv_css NS '@import'
                  AND lv_css NS 'behavior' AND lv_css NS '-moz-binding' AND lv_css NS 'image-set(' ).
  ENDMETHOD.

  METHOD escape_attr.
    rv_value = iv_value.
    REPLACE ALL OCCURRENCES OF '&' IN rv_value WITH '&amp;'.
    REPLACE ALL OCCURRENCES OF '<' IN rv_value WITH '&lt;'.
    REPLACE ALL OCCURRENCES OF '>' IN rv_value WITH '&gt;'.
    REPLACE ALL OCCURRENCES OF '"' IN rv_value WITH '&quot;'.
    REPLACE ALL OCCURRENCES OF `'` IN rv_value WITH '&#39;'.
  ENDMETHOD.

  METHOD escape_html.
    rv_text = iv_text.
    REPLACE ALL OCCURRENCES OF '&' IN rv_text WITH '&amp;'.
    REPLACE ALL OCCURRENCES OF '<' IN rv_text WITH '&lt;'.
    REPLACE ALL OCCURRENCES OF '>' IN rv_text WITH '&gt;'.
    REPLACE ALL OCCURRENCES OF '"' IN rv_text WITH '&quot;'.
    REPLACE ALL OCCURRENCES OF `'` IN rv_text WITH '&#39;'.
  ENDMETHOD.

  METHOD trim.
    rv_text = iv_text.
    SHIFT rv_text LEFT DELETING LEADING space.
    SHIFT rv_text RIGHT DELETING TRAILING space.
  ENDMETHOD.

  METHOD serialize_json.
    DATA lo_writer TYPE REF TO cl_sxml_string_writer.
    DATA lv_json TYPE string.
    DATA lv_key_at TYPE i.
    DATA lv_from TYPE i.
    DATA lv_len TYPE i.

    TRY.
        lo_writer = cl_sxml_string_writer=>create( type = if_sxml=>co_xt_json ).
        CALL TRANSFORMATION id
          SOURCE data = is_data
          RESULT XML lo_writer.
        lv_json = xstring_to_string( lo_writer->get_output( ) ).
      CATCH cx_root INTO DATA(lx_error).
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING
            previous = lx_error
            message  = |JSON serialization failed: { lx_error->get_text( ) }|.
    ENDTRY.

    lv_key_at = find( val = lv_json sub = '"DATA":' ).
    IF lv_key_at >= 0.
      lv_from = lv_key_at + 7.
      lv_len = strlen( lv_json ).
      IF lv_from < lv_len.
        lv_json = substring( val = lv_json off = lv_from ).
        lv_len = strlen( lv_json ).
        IF lv_len > 0 AND substring( val = lv_json off = lv_len - 1 ) = '}'.
          lv_json = substring( val = lv_json len = lv_len - 1 ).
        ENDIF.
      ENDIF.
    ENDIF.

    SHIFT lv_json LEFT DELETING LEADING space.
    rv_json = lv_json.
  ENDMETHOD.

  METHOD xstring_to_string.
    rv_string = lcl_pdf_convert=>xstring_to_string( iv_xstring ).
  ENDMETHOD.

  METHOD field_catalog.
    DATA lo_type TYPE REF TO cl_abap_typedescr.
    DATA lo_self TYPE REF TO lcl_pdf_data_binder.
    DATA lv_name TYPE string.

    lv_name = to_upper( iv_type_name ).
    SHIFT lv_name LEFT DELETING LEADING space.
    SHIFT lv_name RIGHT DELETING TRAILING space.
    IF lv_name IS INITIAL.
      RETURN.
    ENDIF.

    CALL METHOD cl_abap_typedescr=>describe_by_name
      EXPORTING
        p_name         = lv_name
      RECEIVING
        p_descr_ref    = lo_type
      EXCEPTIONS
        type_not_found = 1
        OTHERS         = 2.
    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING
          message = |DDIC type { lv_name } does not exist|.
    ENDIF.

    lo_self = NEW lcl_pdf_data_binder( ).
    CASE lo_type->kind.
      WHEN cl_abap_typedescr=>kind_struct.
        lo_self->add_components(
          io_struct     = CAST cl_abap_structdescr( lo_type )
          iv_rel_prefix = ''
          iv_abs_prefix = ''
          iv_parent     = ''
          iv_depth      = 0 ).
      WHEN cl_abap_typedescr=>kind_table.
        DATA(lo_line) = CAST cl_abap_tabledescr( lo_type )->get_table_line_type( ).
        IF lo_line->kind = cl_abap_typedescr=>kind_struct.
          lo_self->add_components(
            io_struct     = CAST cl_abap_structdescr( lo_line )
            iv_rel_prefix = ''
            iv_abs_prefix = ''
            iv_parent     = ''
            iv_depth      = 0 ).
        ENDIF.
      WHEN OTHERS.
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING
            message = |{ lv_name } is not a structure or table type|.
    ENDCASE.
    rt_fields = lo_self->mt_fields.
  ENDMETHOD.

  METHOD field_catalog_json.
    DATA lt_fields TYPE ty_fields.
    DATA ls_field TYPE ty_field.
    DATA lv_sep TYPE string.

    lt_fields = field_catalog( iv_type_name ).
    rv_json = '['.
    LOOP AT lt_fields INTO ls_field.
      rv_json = rv_json && lv_sep &&
        '{"name":"' && json_escape( ls_field-name ) &&
        '","path":"' && json_escape( ls_field-path ) &&
        '","parent":"' && json_escape( ls_field-parent ) &&
        '","kind":"' && json_escape( ls_field-kind ) &&
        '","abapType":"' && json_escape( ls_field-abap_type ) &&
        '","length":' && |{ ls_field-length }| &&
        ',"insert":"' && json_escape( ls_field-insert ) && '"}'.
      lv_sep = ','.
    ENDLOOP.
    rv_json = rv_json && ']'.
  ENDMETHOD.

  METHOD json_escape.
    rv_text = escape( val = iv_text format = cl_abap_format=>e_json_string ).
  ENDMETHOD.

  METHOD add_components.
    DATA ls_comp TYPE abap_compdescr.
    DATA lo_comp TYPE REF TO cl_abap_datadescr.
    DATA ls_field TYPE ty_field.
    DATA lv_rel TYPE string.
    DATA lv_abs TYPE string.
    DATA lv_nl TYPE string.

    IF iv_depth > 8.
      RETURN.
    ENDIF.

    lv_nl = cl_abap_char_utilities=>newline.

    LOOP AT io_struct->components INTO ls_comp.
      lo_comp = io_struct->get_component_type( ls_comp-name ).
      IF iv_rel_prefix IS INITIAL.
        lv_rel = ls_comp-name.
      ELSE.
        lv_rel = iv_rel_prefix && '.' && ls_comp-name.
      ENDIF.
      IF iv_abs_prefix IS INITIAL.
        lv_abs = ls_comp-name.
      ELSE.
        lv_abs = iv_abs_prefix && '.' && ls_comp-name.
      ENDIF.

      CLEAR ls_field.
      ls_field-name = ls_comp-name.
      ls_field-path = lv_abs.
      ls_field-parent = iv_parent.

      CASE lo_comp->kind.
        WHEN cl_abap_typedescr=>kind_elem.
          ls_field-kind = 'field'.
          ls_field-abap_type = elem_type( CAST cl_abap_elemdescr( lo_comp ) ).
          ls_field-length = CAST cl_abap_elemdescr( lo_comp )->length.
          ls_field-insert = '{{' && lv_rel && '}}'.
          APPEND ls_field TO mt_fields.
        WHEN cl_abap_typedescr=>kind_struct.
          ls_field-kind = 'structure'.
          ls_field-abap_type = 'STRUCTURE'.
          APPEND ls_field TO mt_fields.
          add_components(
            io_struct     = CAST cl_abap_structdescr( lo_comp )
            iv_rel_prefix = lv_rel
            iv_abs_prefix = lv_abs
            iv_parent     = lv_abs
            iv_depth      = iv_depth + 1 ).
        WHEN cl_abap_typedescr=>kind_table.
          DATA(lo_line) = CAST cl_abap_tabledescr( lo_comp )->get_table_line_type( ).
          ls_field-kind = 'table'.
          ls_field-abap_type = 'TABLE'.
          ls_field-insert = '{{#each ' && lv_rel && '}}' && lv_nl && '{{/each}}'.
          APPEND ls_field TO mt_fields.
          IF lo_line->kind = cl_abap_typedescr=>kind_struct.
            add_components(
              io_struct     = CAST cl_abap_structdescr( lo_line )
              iv_rel_prefix = ''
              iv_abs_prefix = lv_abs
              iv_parent     = lv_abs
              iv_depth      = iv_depth + 1 ).
          ELSEIF lo_line->kind = cl_abap_typedescr=>kind_elem.
            CLEAR ls_field.
            ls_field-name = '.'.
            ls_field-path = lv_abs && '.'.
            ls_field-parent = lv_abs.
            ls_field-kind = 'field'.
            ls_field-abap_type = elem_type( CAST cl_abap_elemdescr( lo_line ) ).
            ls_field-insert = '{{.}}'.
            APPEND ls_field TO mt_fields.
          ENDIF.
      ENDCASE.
    ENDLOOP.
  ENDMETHOD.

  METHOD elem_type.
    CASE io_elem->type_kind.
      WHEN cl_abap_typedescr=>typekind_char.
        rv_abap_type = 'CHAR'.
      WHEN cl_abap_typedescr=>typekind_num.
        rv_abap_type = 'NUMC'.
      WHEN cl_abap_typedescr=>typekind_date.
        rv_abap_type = 'DATE'.
      WHEN cl_abap_typedescr=>typekind_time.
        rv_abap_type = 'TIME'.
      WHEN cl_abap_typedescr=>typekind_packed.
        rv_abap_type = 'DEC'.
      WHEN cl_abap_typedescr=>typekind_int
        OR cl_abap_typedescr=>typekind_int1
        OR cl_abap_typedescr=>typekind_int2.
        rv_abap_type = 'INT'.
      WHEN cl_abap_typedescr=>typekind_float
        OR cl_abap_typedescr=>typekind_decfloat
        OR cl_abap_typedescr=>typekind_decfloat16
        OR cl_abap_typedescr=>typekind_decfloat34.
        rv_abap_type = 'FLOAT'.
      WHEN cl_abap_typedescr=>typekind_string.
        rv_abap_type = 'STRING'.
      WHEN cl_abap_typedescr=>typekind_xstring
        OR cl_abap_typedescr=>typekind_hex.
        rv_abap_type = 'RAW'.
      WHEN OTHERS.
        rv_abap_type = io_elem->type_kind.
    ENDCASE.
  ENDMETHOD.

  METHOD is_aggregate.
    DATA lv_tag TYPE string.
    DATA lv_word TYPE string.
    DATA lv_rest TYPE string.

    lv_tag = condense( iv_tag ).
    SPLIT lv_tag AT ` ` INTO lv_word lv_rest.
    lv_word = to_lower( lv_word ).
    IF lv_rest IS NOT INITIAL
        AND ( lv_word = 'sum' OR lv_word = 'count' OR lv_word = 'avg' OR lv_word = 'min' OR lv_word = 'max' ).
      rv_yes = abap_true.
    ENDIF.
  ENDMETHOD.

  METHOD parse_number.
    DATA lv_text TYPE string.
    DATA lv_clean TYPE string.
    DATA lv_len TYPE i.
    DATA lv_i TYPE i.
    DATA lv_c TYPE c LENGTH 1.
    DATA lv_neg TYPE abap_bool.
    DATA lv_dot TYPE i.
    DATA lv_comma TYPE i.
    DATA lv_dots TYPE i.
    DATA lv_commas TYPE i.
    DATA lv_dec TYPE string.
    DATA lv_grp TYPE string.
    DATA lv_at TYPE i.
    DATA lv_digit TYPE c LENGTH 1.
    DATA lv_code TYPE i.

    CLEAR: ev_value, ev_ok, ev_decimals, ev_dec_sep, ev_grouped.
    lv_text = iv_text.
    "Arabic-Indic digits and separators.
    DO 10 TIMES.
      lv_code = 1631 + sy-index.
      lv_digit = cl_abap_conv_in_ce=>uccpi( lv_code ).
      lv_c = sy-index - 1.
      REPLACE ALL OCCURRENCES OF lv_digit IN lv_text WITH lv_c.
    ENDDO.
    lv_digit = cl_abap_conv_in_ce=>uccpi( 1643 ).
    REPLACE ALL OCCURRENCES OF lv_digit IN lv_text WITH '.'.
    lv_digit = cl_abap_conv_in_ce=>uccpi( 1644 ).
    REPLACE ALL OCCURRENCES OF lv_digit IN lv_text WITH ','.

    lv_len = strlen( lv_text ).
    DO lv_len TIMES.
      lv_i = sy-index - 1.
      lv_c = lv_text+lv_i(1).
      IF lv_c CA '0123456789'.
        lv_clean = lv_clean && lv_c.
      ELSEIF lv_c = '.'.
        lv_clean = lv_clean && lv_c.
        lv_dots = lv_dots + 1.
      ELSEIF lv_c = ','.
        lv_clean = lv_clean && lv_c.
        lv_commas = lv_commas + 1.
      ELSEIF lv_c = '-'.
        lv_neg = abap_true.
      ENDIF.
    ENDDO.
    IF lv_clean NA '0123456789'.
      RETURN.
    ENDIF.

    lv_dot = find( val = lv_clean sub = '.' occ = -1 ).
    lv_comma = find( val = lv_clean sub = ',' occ = -1 ).
    IF lv_dot >= 0 AND lv_comma >= 0.
      IF lv_dot > lv_comma.
        lv_dec = '.'.
        lv_grp = ','.
      ELSE.
        lv_dec = ','.
        lv_grp = '.'.
      ENDIF.
    ELSEIF lv_comma >= 0.
      "One comma not followed by exactly three digits is a decimal comma.
      IF lv_commas = 1 AND strlen( lv_clean ) - lv_comma - 1 <> 3.
        lv_dec = ','.
      ELSE.
        lv_grp = ','.
      ENDIF.
    ELSEIF lv_dot >= 0.
      IF lv_dots = 1.
        lv_dec = '.'.
      ELSE.
        lv_grp = '.'.
      ENDIF.
    ENDIF.
    IF lv_grp IS NOT INITIAL.
      REPLACE ALL OCCURRENCES OF lv_grp IN lv_clean WITH ``.
      ev_grouped = abap_true.
    ENDIF.
    IF lv_dec IS NOT INITIAL.
      lv_at = find( val = lv_clean sub = lv_dec occ = -1 ).
      ev_decimals = strlen( lv_clean ) - lv_at - 1.
      REPLACE ALL OCCURRENCES OF lv_dec IN lv_clean WITH '.'.
      ev_dec_sep = lv_dec.
    ENDIF.
    IF lv_clean(1) = '.'.
      lv_clean = '0' && lv_clean.
    ENDIF.
    IF substring( val = lv_clean off = strlen( lv_clean ) - 1 len = 1 ) = '.'.
      lv_clean = lv_clean && '0'.
    ENDIF.
    IF lv_clean CN '0123456789.' OR strlen( lv_clean ) > 30.
      RETURN.
    ENDIF.
    TRY.
        ev_value = lv_clean.
      CATCH cx_root.
        RETURN.
    ENDTRY.
    IF lv_neg = abap_true.
      ev_value = 0 - ev_value.
    ENDIF.
    ev_ok = abap_true.
  ENDMETHOD.

  METHOD format_number.
    DATA lv_p TYPE p LENGTH 16 DECIMALS 6.
    DATA lv_raw TYPE string.
    DATA lv_int TYPE string.
    DATA lv_frac TYPE string.
    DATA lv_out TYPE string.
    DATA lv_len TYPE i.
    DATA lv_count TYPE i.
    DATA lv_i TYPE i.
    DATA lv_c TYPE c LENGTH 1.
    DATA lv_decimals TYPE i.
    DATA lv_neg TYPE abap_bool.
    DATA lv_dec TYPE string.
    DATA lv_grp TYPE string.

    lv_decimals = iv_decimals.
    IF lv_decimals < 0.
      lv_decimals = 0.
    ELSEIF lv_decimals > 6.
      lv_decimals = 6.
    ENDIF.
    lv_p = round( val = iv_value dec = lv_decimals ).
    IF lv_p < 0.
      lv_neg = abap_true.
      lv_p = 0 - lv_p.
    ENDIF.
    lv_raw = |{ lv_p }|.
    SPLIT lv_raw AT '.' INTO lv_int lv_frac.
    IF lv_decimals > 0.
      lv_frac = lv_frac && '000000'.
      lv_frac = lv_frac(lv_decimals).
    ELSE.
      CLEAR lv_frac.
    ENDIF.

    lv_dec = iv_dec_sep.
    IF lv_dec IS INITIAL.
      lv_dec = '.'.
    ENDIF.
    lv_grp = iv_group_sep.
    IF iv_arabic = abap_true.
      lv_dec = cl_abap_conv_in_ce=>uccpi( 1643 ).
      IF lv_grp IS NOT INITIAL.
        lv_grp = cl_abap_conv_in_ce=>uccpi( 1644 ).
      ENDIF.
    ENDIF.

    lv_len = strlen( lv_int ).
    lv_i = lv_len.
    WHILE lv_i > 0.
      lv_i = lv_i - 1.
      lv_c = lv_int+lv_i(1).
      IF lv_count > 0 AND lv_count MOD 3 = 0 AND lv_grp IS NOT INITIAL.
        lv_out = lv_grp && lv_out.
      ENDIF.
      lv_out = lv_c && lv_out.
      lv_count = lv_count + 1.
    ENDWHILE.
    IF lv_frac IS NOT INITIAL.
      lv_out = lv_out && lv_dec && lv_frac.
    ENDIF.
    IF lv_neg = abap_true AND lv_p <> 0.
      lv_out = '-' && lv_out.
    ENDIF.
    IF iv_arabic = abap_true.
      lv_out = arabic_digits( lv_out ).
    ENDIF.
    rv_text = lv_out.
  ENDMETHOD.

  METHOD number_pattern.
    DATA lv_pattern TYPE string.
    DATA lv_arabic TYPE abap_bool.
    DATA lv_value TYPE decfloat34.
    DATA lv_ok TYPE abap_bool.
    DATA lv_decimals TYPE i.
    DATA lv_dec_sep TYPE string.
    DATA lv_grouped TYPE abap_bool.
    DATA lv_dot TYPE i.
    DATA lv_comma TYPE i.
    DATA lv_last TYPE i.
    DATA lv_sep TYPE string.
    DATA lv_after TYPE string.
    DATA lv_dec TYPE string.
    DATA lv_grp TYPE string.
    DATA lv_places TYPE i.

    rv_text = iv_value.
    lv_pattern = condense( iv_pattern ).
    IF strlen( lv_pattern ) > 2 AND lv_pattern(2) = 'AR'.
      lv_arabic = abap_true.
      lv_pattern = substring( val = lv_pattern off = 2 ).
    ENDIF.
    parse_number(
      EXPORTING iv_text = iv_value
      IMPORTING ev_value = lv_value ev_ok = lv_ok ev_decimals = lv_decimals
                ev_dec_sep = lv_dec_sep ev_grouped = lv_grouped ).
    IF lv_ok = abap_false.
      RETURN.
    ENDIF.

    "#,##0.00 / #.##0,00 / 0.00 / 0,00 / #,##0 / #.##0 / 0
    lv_dot = find( val = lv_pattern sub = '.' occ = -1 ).
    lv_comma = find( val = lv_pattern sub = ',' occ = -1 ).
    IF lv_dot >= 0 AND lv_comma >= 0.
      IF lv_dot > lv_comma.
        lv_dec = '.'.
        lv_grp = ','.
        lv_last = lv_dot.
      ELSE.
        lv_dec = ','.
        lv_grp = '.'.
        lv_last = lv_comma.
      ENDIF.
    ELSEIF lv_dot >= 0 OR lv_comma >= 0.
      lv_last = nmax( val1 = lv_dot val2 = lv_comma ).
      lv_sep = lv_pattern+lv_last(1).
      lv_after = substring( val = lv_pattern off = lv_last + 1 ).
      IF lv_after CO '0' AND ( lv_pattern(1) = '0' OR strlen( lv_after ) <> 3 ).
        lv_dec = lv_sep.
      ELSE.
        lv_grp = lv_sep.
        lv_last = -1.
      ENDIF.
    ELSE.
      lv_last = -1.
    ENDIF.
    IF lv_dec IS NOT INITIAL AND lv_last >= 0.
      lv_places = strlen( lv_pattern ) - lv_last - 1.
    ENDIF.
    rv_text = format_number( iv_value = lv_value iv_decimals = lv_places
                             iv_dec_sep = lv_dec iv_group_sep = lv_grp iv_arabic = lv_arabic ).
  ENDMETHOD.

  METHOD aggregate.
    DATA lt_words TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    DATA lv_op TYPE string.
    DATA lv_term TYPE string.
    DATA lv_table TYPE string.
    DATA lv_field TYPE string.
    DATA lv_at TYPE i.
    DATA lr_data TYPE REF TO data.
    DATA lr_row TYPE REF TO data.
    DATA lr_value TYPE REF TO data.
    DATA lv_found TYPE abap_bool.
    DATA lt_texts TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    DATA lv_text TYPE string.
    DATA lv_rows TYPE i.
    DATA lv_value TYPE decfloat34.
    DATA lv_ok TYPE abap_bool.
    DATA lv_decimals TYPE i.
    DATA lv_dec_sep TYPE string.
    DATA lv_grouped TYPE abap_bool.
    DATA lv_sum TYPE decfloat34.
    DATA lv_min TYPE decfloat34.
    DATA lv_max TYPE decfloat34.
    DATA lv_result TYPE decfloat34.
    DATA lv_numbers TYPE i.
    DATA lv_places TYPE i.
    DATA lv_dec TYPE string.
    DATA lv_any_group TYPE abap_bool.
    DATA lv_grp TYPE string.
    FIELD-SYMBOLS <lv_node> TYPE any.
    FIELD-SYMBOLS <lt_table> TYPE ANY TABLE.
    FIELD-SYMBOLS <lv_row> TYPE any.

    lv_text = condense( iv_tag ).
    SPLIT lv_text AT ` ` INTO TABLE lt_words.
    DELETE lt_words WHERE table_line IS INITIAL.
    READ TABLE lt_words INTO lv_op INDEX 1.
    lv_op = to_lower( lv_op ).
    DELETE lt_words INDEX 1.

    "Collect the values (or row counts) of every term.
    LOOP AT lt_words INTO lv_term.
      IF lv_term CO '0123456789.,-'.
        IF lv_op = 'count'.
          parse_number( EXPORTING iv_text = lv_term IMPORTING ev_value = lv_value ev_ok = lv_ok ).
          IF lv_ok = abap_true.
            lv_rows = lv_rows + lv_value.
          ENDIF.
        ELSE.
          APPEND lv_term TO lt_texts.
        ENDIF.
        CONTINUE.
      ENDIF.
      IF lv_op = 'count'.
        lv_table = lv_term.
        CLEAR lv_field.
      ELSE.
        lv_at = find( val = lv_term sub = '.' occ = -1 ).
        IF lv_at > 0.
          lv_table = substring( val = lv_term len = lv_at ).
          lv_field = substring( val = lv_term off = lv_at + 1 ).
        ELSE.
          lv_table = lv_term.
          CLEAR lv_field.
        ENDIF.
      ENDIF.
      try_resolve( EXPORTING iv_path = lv_table IMPORTING eo_data = lr_data ev_found = lv_found ).
      IF lv_found = abap_false.
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING message = |Unknown template field in { lv_op }: { lv_table }|.
      ENDIF.
      ASSIGN lr_data->* TO <lv_node>.
      IF cl_abap_typedescr=>describe_by_data( <lv_node> )->kind = cl_abap_typedescr=>kind_table.
        ASSIGN lr_data->* TO <lt_table>.
        IF lv_op = 'count'.
          lv_rows = lv_rows + lines( <lt_table> ).
          CONTINUE.
        ENDIF.
        LOOP AT <lt_table> ASSIGNING <lv_row>.
          GET REFERENCE OF <lv_row> INTO lr_row.
          IF lv_field IS INITIAL.
            APPEND value_to_string( lr_row ) TO lt_texts.
          ELSEIF walk( EXPORTING io_data = lr_row iv_path = lv_field IMPORTING eo_data = lr_value ) = abap_true.
            APPEND value_to_string( lr_value ) TO lt_texts.
          ENDIF.
        ENDLOOP.
      ELSE.
        IF lv_op = 'count'.
          lv_rows = lv_rows + 1.
        ELSEIF lv_field IS INITIAL.
          APPEND value_to_string( lr_data ) TO lt_texts.
        ELSEIF walk( EXPORTING io_data = lr_data iv_path = lv_field IMPORTING eo_data = lr_value ) = abap_true.
          APPEND value_to_string( lr_value ) TO lt_texts.
        ENDIF.
      ENDIF.
    ENDLOOP.

    IF lv_op = 'count'.
      rv_text = |{ lv_rows }|.
      RETURN.
    ENDIF.

    LOOP AT lt_texts INTO lv_text.
      parse_number(
        EXPORTING iv_text = lv_text
        IMPORTING ev_value = lv_value ev_ok = lv_ok ev_decimals = lv_decimals
                  ev_dec_sep = lv_dec_sep ev_grouped = lv_grouped ).
      IF lv_ok = abap_false.
        CONTINUE.
      ENDIF.
      IF lv_numbers = 0.
        lv_min = lv_value.
        lv_max = lv_value.
      ELSE.
        lv_min = nmin( val1 = lv_min val2 = lv_value ).
        lv_max = nmax( val1 = lv_max val2 = lv_value ).
      ENDIF.
      lv_sum = lv_sum + lv_value.
      lv_numbers = lv_numbers + 1.
      lv_places = nmax( val1 = lv_places val2 = lv_decimals ).
      IF lv_dec IS INITIAL AND lv_dec_sep IS NOT INITIAL.
        lv_dec = lv_dec_sep.
      ENDIF.
      IF lv_grouped = abap_true.
        lv_any_group = abap_true.
      ENDIF.
    ENDLOOP.

    CASE lv_op.
      WHEN 'sum'.
        lv_result = lv_sum.
      WHEN 'avg'.
        IF lv_numbers = 0.
          RETURN.
        ENDIF.
        lv_result = lv_sum / lv_numbers.
        lv_places = nmax( val1 = lv_places val2 = 2 ).
      WHEN 'min'.
        IF lv_numbers = 0.
          RETURN.
        ENDIF.
        lv_result = lv_min.
      WHEN 'max'.
        IF lv_numbers = 0.
          RETURN.
        ENDIF.
        lv_result = lv_max.
    ENDCASE.
    IF lv_dec IS INITIAL.
      lv_dec = '.'.
    ENDIF.
    IF lv_any_group = abap_true.
      lv_grp = COND #( WHEN lv_dec = ',' THEN '.' ELSE ',' ).
    ENDIF.
    rv_text = format_number( iv_value = lv_result iv_decimals = lv_places
                             iv_dec_sep = lv_dec iv_group_sep = lv_grp ).
  ENDMETHOD.
ENDCLASS.

*& lcl_pdf_form_manager
CLASS lcl_pdf_form_manager IMPLEMENTATION.

  METHOD set_runtime.
    DATA lv_approved TYPE string.
    gv_url = iv_url.
    SHIFT gv_url LEFT DELETING LEADING space.
    SHIFT gv_url RIGHT DELETING TRAILING space.
    IF gv_url IS INITIAL.
      gv_url = gc_gotenberg_url.
    ENDIF.
    lv_approved = |dest://{ gc_gotenberg_dest }|.
    IF gv_url <> lv_approved.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING message = |Only the configured destination { lv_approved } is allowed|.
    ENDIF.
    gv_timeout = iv_timeout.
    IF gv_timeout < 1 OR gv_timeout > 300.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Timeout must be between 1 and 300 seconds'.
    ENDIF.
    IF gv_stack IS INITIAL.
      gv_stack = 'CLASSIC'.
    ENDIF.
    load_store( ).
  ENDMETHOD.

  METHOD create_form.
    lcl_pdf_security=>check( 'ZPDFEDIT' ).
    load_store( ).
    DATA ls_form TYPE ty_form.
    DATA lv_id TYPE string.

    lv_id = normalize_id( iv_form_id ).
    check_ddic( iv_ddic_structure ).

    READ TABLE gt_forms TRANSPORTING NO FIELDS WITH KEY form_id = lv_id.
    IF sy-subrc = 0.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING
          message = |Form { lv_id } already exists|.
    ENDIF.

    ls_form-form_id = lv_id.
    ls_form-description = iv_description.
    IF ls_form-description IS INITIAL.
      ls_form-description = lv_id.
    ENDIF.
    ls_form-package = to_upper( iv_package ).
    IF ls_form-package IS INITIAL.
      ls_form-package = '$TMP'.
    ENDIF.
    ls_form-ddic_structure = to_upper( iv_ddic_structure ).
    ls_form-created_by = sy-uname.
    ls_form-changed_by = sy-uname.
    ls_form-created_at = timestamp( ).
    ls_form-changed_at = ls_form-created_at.
    APPEND ls_form TO gt_forms.
    persist( ).
  ENDMETHOD.

  METHOD read_form.
    load_store( ).
    DATA lv_id TYPE string.
    lv_id = normalize_id( iv_form_id ).
    READ TABLE gt_forms INTO rs_form WITH KEY form_id = lv_id.
    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING
          message = |Form { lv_id } does not exist|.
    ENDIF.
  ENDMETHOD.

  METHOD update_form.
    lcl_pdf_security=>check( 'ZPDFEDIT' ).
    load_store( ).
    DATA lv_id TYPE string.
    DATA lv_ts TYPE timestamp.
    FIELD-SYMBOLS <form> TYPE ty_form.

    lv_id = normalize_id( iv_form_id ).
    read_form( lv_id ).
    check_ddic( iv_ddic_structure ).
    READ TABLE gt_forms ASSIGNING <form> WITH KEY form_id = lv_id.
    lv_ts = timestamp( ).
    <form>-description = iv_description.
    IF <form>-description IS INITIAL.
      <form>-description = lv_id.
    ENDIF.
    <form>-ddic_structure = to_upper( iv_ddic_structure ).
    <form>-changed_by = sy-uname.
    <form>-changed_at = lv_ts.
    persist( ).
  ENDMETHOD.

  METHOD delete_form.
    lcl_pdf_security=>check( 'ZPDFADMN' ).
    lcl_pdf_security=>check( 'ZPDFEDIT' ).
    load_store( ).
    DATA lv_id TYPE string.
    lv_id = normalize_id( iv_form_id ).
    read_form( lv_id ).
    DELETE gt_templates WHERE form_id = lv_id.
    DELETE gt_forms WHERE form_id = lv_id.
    persist( ).
  ENDMETHOD.

  METHOD list_forms.
    load_store( ).
    rt_forms = gt_forms.
    SORT rt_forms BY form_id.
  ENDMETHOD.

  METHOD save_template.
    lcl_pdf_security=>check( 'ZPDFEDIT' ).
    load_store( ).
    DATA ls_template TYPE ty_template.
    FIELD-SYMBOLS <form> TYPE ty_form.

    ls_template = is_template.
    prepare_template( CHANGING cs_template = ls_template ).
    read_form( ls_template-form_id ).
    READ TABLE gt_forms ASSIGNING <form> WITH KEY form_id = ls_template-form_id.
    IF sy-subrc = 0.
      <form>-changed_by = sy-uname.
      <form>-changed_at = timestamp( ).
    ENDIF.

    "Every save replaces the stored template; iv_new_version is accepted but has no effect.
    rv_version = insert_version( ls_template ).
    persist( ).
  ENDMETHOD.

  METHOD read_active_template.
    DATA lv_id TYPE string.
    DATA ls_row TYPE ty_template.
    DATA lv_found TYPE abap_bool.

    "Printing: when the store is not loaded yet, read only the active row of this form
    "instead of loading and unpacking every form and version.
    IF gv_loaded = abap_false AND table_ready( ) = abap_true.
      rs_template = read_active_row( iv_form_id ).
      IF rs_template IS NOT INITIAL.
        RETURN.
      ENDIF.
    ENDIF.
    load_store( ).
    lv_id = normalize_id( iv_form_id ).
    read_form( lv_id ).

    LOOP AT gt_templates INTO ls_row WHERE form_id = lv_id AND is_active = abap_true.
      rs_template = ls_row.
      lv_found = abap_true.
      EXIT.
    ENDLOOP.
    IF lv_found = abap_true.
      RETURN.
    ENDIF.

    LOOP AT gt_templates INTO ls_row WHERE form_id = lv_id.
      IF lv_found = abap_false OR ls_row-version > rs_template-version.
        rs_template = ls_row.
        lv_found = abap_true.
      ENDIF.
    ENDLOOP.
    IF lv_found = abap_false.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING
          message = |Form { lv_id } has no template|.
    ENDIF.
  ENDMETHOD.

  METHOD list_versions.
    load_store( ).
    DATA lv_id TYPE string.
    DATA ls_row TYPE ty_template.
    lv_id = normalize_id( iv_form_id ).
    read_form( lv_id ).
    LOOP AT gt_templates INTO ls_row WHERE form_id = lv_id.
      APPEND ls_row TO rt_templates.
    ENDLOOP.
    SORT rt_templates BY version DESCENDING.
  ENDMETHOD.

  METHOD get_config.
    CASE to_upper( iv_param ).
      WHEN 'GOTENBERG_URL'.
        rv_value = gv_url.
        IF rv_value IS INITIAL.
          rv_value = gc_gotenberg_url.
        ENDIF.
      WHEN 'HTTP_TIMEOUT'.
        IF gv_timeout <= 0.
          rv_value = '60'.
        ELSE.
          rv_value = gv_timeout.
        ENDIF.
      WHEN 'HTTP_STACK'.
        rv_value = gv_stack.
        IF rv_value IS INITIAL.
          rv_value = 'CLASSIC'.
        ENDIF.
      WHEN 'ENGINE'.
        rv_value = gv_engine_mode.
        IF rv_value IS INITIAL.
          rv_value = 'NATIVE'.
        ENDIF.
      WHEN OTHERS.
        CLEAR rv_value.
    ENDCASE.
  ENDMETHOD.

  METHOD set_config.
    DATA lv_timeout TYPE i.
    CASE to_upper( iv_param ).
      WHEN 'GOTENBERG_URL'.
        set_runtime( iv_url = iv_value iv_timeout = CONV i( get_config( 'HTTP_TIMEOUT' ) ) ).
      WHEN 'HTTP_TIMEOUT'.
        TRY.
            lv_timeout = iv_value.
          CATCH cx_root INTO DATA(lx_number).
            RAISE EXCEPTION TYPE cx_pdf_error
              EXPORTING previous = lx_number message = 'Invalid HTTP timeout'.
        ENDTRY.
        set_runtime( iv_url = get_config( 'GOTENBERG_URL' ) iv_timeout = lv_timeout ).
      WHEN 'HTTP_STACK'.
        IF to_upper( iv_value ) <> 'CLASSIC'.
          RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Only the CLASSIC HTTP stack is supported'.
        ENDIF.
        gv_stack = to_upper( iv_value ).
      WHEN 'ENGINE'.
        IF to_upper( iv_value ) <> 'NATIVE' AND to_upper( iv_value ) <> 'GOTENBERG'.
          RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'PDF engine must be NATIVE or GOTENBERG'.
        ENDIF.
        gv_engine_mode = to_upper( iv_value ).
      WHEN OTHERS.
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING message = |Unknown config parameter { iv_param }|.
    ENDCASE.
  ENDMETHOD.

  METHOD reset_demo.
    lcl_pdf_security=>check( 'ZPDFADMN' ).
    lcl_pdf_security=>check( 'ZPDFEDIT' ).
    load_store( ).
    DELETE gt_templates WHERE form_id = 'ZPDF_DEMO'.
    DELETE gt_forms WHERE form_id = 'ZPDF_DEMO'.
    seed_demo( ).
  ENDMETHOD.

  METHOD normalize_id.
    rv_form_id = to_upper( iv_form_id ).
    SHIFT rv_form_id LEFT DELETING LEADING space.
    SHIFT rv_form_id RIGHT DELETING TRAILING space.
    IF rv_form_id IS INITIAL
        OR strlen( rv_form_id ) > 30
        OR rv_form_id CN 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_'.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING
          message = 'Form ID must contain only A-Z, 0-9, and underscore'.
    ENDIF.
  ENDMETHOD.

  METHOD check_ddic.
    DATA lo_type TYPE REF TO cl_abap_typedescr.
    DATA lv_name TYPE string.

    lv_name = to_upper( iv_type_name ).
    SHIFT lv_name LEFT DELETING LEADING space.
    IF lv_name IS INITIAL.
      RETURN.
    ENDIF.

    CALL METHOD cl_abap_typedescr=>describe_by_name
      EXPORTING
        p_name         = lv_name
      RECEIVING
        p_descr_ref    = lo_type
      EXCEPTIONS
        type_not_found = 1
        OTHERS         = 2.
    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING
          message = |DDIC type { lv_name } does not exist|.
    ENDIF.
    IF lo_type->kind <> cl_abap_typedescr=>kind_struct
        AND lo_type->kind <> cl_abap_typedescr=>kind_table.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING
          message = |{ lv_name } is not a structure or table type|.
    ENDIF.
  ENDMETHOD.

  METHOD timestamp.
    GET TIME STAMP FIELD rv_ts.
  ENDMETHOD.

  METHOD prepare_template.
    cs_template-form_id = normalize_id( cs_template-form_id ).
    cs_template-page_size = to_upper( cs_template-page_size ).
    cs_template-orientation = to_upper( cs_template-orientation ).
    IF cs_template-page_size IS INITIAL.
      cs_template-page_size = 'A4'.
    ENDIF.
    IF cs_template-orientation IS INITIAL.
      cs_template-orientation = 'P'.
    ENDIF.
    DATA ls_page TYPE lcl_pdf_renderer=>ty_page.
    MOVE-CORRESPONDING cs_template TO ls_page.
    lcl_pdf_renderer=>validate_page( ls_page ).
    IF strlen( cs_template-html_content ) + strlen( cs_template-css_content ) +
       strlen( cs_template-header_html ) + strlen( cs_template-footer_html ) +
       strlen( cs_template-sample_json ) > 2000000.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Template exceeds 2 million characters'.
    ENDIF.
  ENDMETHOD.

  METHOD insert_version.
    DATA ls_template TYPE ty_template.
    DATA ls_row TYPE ty_template.
    DATA lv_max TYPE ty_version.

    ls_template = is_template.
    LOOP AT gt_templates INTO ls_row WHERE form_id = ls_template-form_id.
      IF ls_row-version > lv_max.
        lv_max = ls_row-version.
      ENDIF.
    ENDLOOP.

    "Only one row is kept per form, so the counter simply wraps.
    IF lv_max >= 9999.
      lv_max = 0.
    ENDIF.
    "Saving replaces the stored template: older versions of the form are removed.
    DELETE gt_templates WHERE form_id = ls_template-form_id.

    ls_template-version = lv_max + 1.
    ls_template-is_active = abap_true.
    ls_template-changed_by = sy-uname.
    ls_template-changed_at = timestamp( ).
    APPEND ls_template TO gt_templates.
    rv_version = ls_template-version.
  ENDMETHOD.

  METHOD seed_demo.
    DATA ls_template TYPE ty_template.
    READ TABLE gt_forms TRANSPORTING NO FIELDS WITH KEY form_id = 'ZPDF_DEMO'.
    IF sy-subrc = 0.
      RETURN.
    ENDIF.

    TRY.
        create_form(
          iv_form_id        = 'ZPDF_DEMO'
          iv_description    = 'SFLIGHT boarding card'
          iv_ddic_structure = 'SFLIGHT' ).
      CATCH cx_pdf_error.
        create_form(
          iv_form_id     = 'ZPDF_DEMO'
          iv_description = 'SFLIGHT boarding card' ).
    ENDTRY.

    ls_template-form_id = 'ZPDF_DEMO'.
    ls_template-page_size = 'A4'.
    ls_template-orientation = 'P'.
    ls_template-margin_top = 16.
    ls_template-margin_right = 14.
    ls_template-margin_bottom = 18.
    ls_template-margin_left = 14.
    ls_template-html_content =
      '<h1>{{carrid}} {{connid}}</h1>' &&
      '<p>Date {{fldate}}</p>' &&
      '<p>Aircraft {{planetype}}</p>' &&
      '<p>Price {{price}} {{currency}}</p>' &&
      '<p>Seats {{seatsocc}} / {{seatsmax}}</p>'.
    ls_template-css_content =
      'body{font-family:Arial,sans-serif;color:#1f2933;}' &&
      'h1{font-size:28pt;margin:0 0 12px;color:#0f2744;}' &&
      'p{font-size:12pt;margin:4px 0;}'.
    ls_template-footer_html =
      '<div style="width:100%;text-align:center;font-size:9pt;">' &&
      'Page <span class="pageNumber"></span> / <span class="totalPages"></span>' &&
      '</div>'.
    ls_template-sample_json =
      '{"CARRID":"LH","CONNID":"0400","FLDATE":"20260923","PRICE":"345.00","CURRENCY":"EUR"}'.
    save_template(
      is_template    = ls_template
      iv_new_version = abap_true ).
  ENDMETHOD.

  METHOD reload.
    IF gv_dirty = abap_true.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING message = 'Commit or discard pending changes before reload'.
    ENDIF.
    CLEAR gv_loaded.
    load_store( ).
  ENDMETHOD.

  METHOD load_store.
    DATA lt_old_forms TYPE ty_forms.
    DATA lt_old_templates TYPE ty_templates.

    lcl_pdf_security=>check( 'ZPDFVIEW' ).
    IF gv_loaded = abap_true.
      RETURN.
    ENDIF.
    CLEAR: gt_forms, gt_templates.
    IF table_ready( ) = abap_true.
      db_read( IMPORTING et_forms = gt_forms et_templates = gt_templates ).
      gt_base_forms = gt_forms.
      gt_base_templates = gt_templates.
      gv_loaded = abap_true.
      IF gt_forms IS NOT INITIAL.
        RETURN.
      ENDIF.
      "First use of the table: copy the forms of the INDX store (INDX itself is kept).
      "Only once: a table emptied by deleting its forms is not filled again.
      IF store_initialized( ) = abap_true.
        RETURN.
      ENDIF.
      TRY.
          IMPORT forms = lt_old_forms templates = lt_old_templates
            FROM DATABASE indx(zp) ID c_store_id.
        CATCH cx_root.
          CLEAR: lt_old_forms, lt_old_templates.
      ENDTRY.
      IF lt_old_forms IS INITIAL.
        RETURN.
      ENDIF.
      gt_forms = lt_old_forms.
      gt_templates = lt_old_templates.
      TRY.
          IF client_recording( ) = '2'.
            RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Client does not allow changes'.
          ENDIF.
          lcl_pdf_security=>check( 'ZPDFEDIT' ).
          gv_dirty = abap_true.
          commit_table( iv_record = abap_false ).
          "Saved after the forms, so a failed copy is tried again on the next start.
          mark_initialized( ).
          COMMIT WORK.
          gv_note = |{ lines( lt_old_forms ) } forms were copied from the old INDX store to table { c_table }. Use Transport to move them to other systems.|.
        CATCH cx_pdf_error INTO DATA(lx_copy).
          "Show the INDX forms read-only; the copy is tried again on the next start.
          gt_forms = lt_old_forms.
          gt_templates = lt_old_templates.
          gt_base_forms = gt_forms.
          gt_base_templates = gt_templates.
          CLEAR gv_dirty.
          gv_note = |Forms are shown from the old INDX store; copying them to { c_table } failed: { lx_copy->get_text( ) }|.
      ENDTRY.
      RETURN.
    ENDIF.
    TRY.
        IMPORT forms = gt_forms templates = gt_templates
          FROM DATABASE indx(zp) ID c_store_id.
      CATCH cx_root INTO DATA(lx_import).
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING previous = lx_import
                    message = 'Cannot read template store; no data was overwritten'.
    ENDTRY.
    gt_base_forms = gt_forms.
    gt_base_templates = gt_templates.
    gv_loaded = abap_true.
  ENDMETHOD.

  METHOD persist.
    "Stage only. The caller owns the transaction boundary.
    gv_dirty = abap_true.
  ENDMETHOD.

  METHOD lock_key.
    "Generic prefix covers every SRTF2 chunk of this client/store.
    CONCATENATE sy-mandt 'ZP' c_store_id INTO rv_key RESPECTING BLANKS.
  ENDMETHOD.

  METHOD unlock_store.
    DATA lv_key_text TYPE string.
    IF gv_locked = abap_true.
      LOOP AT gt_lock_keys INTO lv_key_text.
        gv_lock_key = lv_key_text.
        CALL FUNCTION 'DEQUEUE_E_TABLE'
          EXPORTING tabname = gv_lock_tab varkey = gv_lock_key _scope = '1'.
      ENDLOOP.
      CLEAR gt_lock_keys.
      gv_locked = abap_false.
    ENDIF.
  ENDMETHOD.

  METHOD read_active_row.
    DATA lr_rows TYPE REF TO data.
    DATA lv_id TYPE string.
    DATA lv_key TYPE c LENGTH 30.
    DATA lv_content TYPE xstring.
    DATA ls_form TYPE ty_form.
    FIELD-SYMBOLS <lt_rows> TYPE STANDARD TABLE.
    FIELD-SYMBOLS <ls_row> TYPE any.
    FIELD-SYMBOLS <lv_field> TYPE any.

    lcl_pdf_security=>check( 'ZPDFVIEW' ).
    lv_id = normalize_id( iv_form_id ).
    lv_key = lv_id.
    CREATE DATA lr_rows TYPE STANDARD TABLE OF (c_table).
    ASSIGN lr_rows->* TO <lt_rows>.
    SELECT * FROM (c_table) INTO TABLE <lt_rows> WHERE form_id = lv_key AND is_active = abap_true.
    LOOP AT <lt_rows> ASSIGNING <ls_row>.
      ASSIGN COMPONENT 'CONTENT' OF STRUCTURE <ls_row> TO <lv_field>.
      lv_content = <lv_field>.
      unpack( EXPORTING iv_content = lv_content IMPORTING es_form = ls_form es_template = rs_template ).
      IF rs_template-html_content IS NOT INITIAL OR rs_template-version IS NOT INITIAL.
        RETURN.
      ENDIF.
    ENDLOOP.
    CLEAR rs_template.
  ENDMETHOD.

  METHOD lock_store.
    CALL FUNCTION 'ENQUEUE_E_TABLE'
      EXPORTING tabname = iv_tab varkey = iv_key
                _scope = '1' _wait = abap_false
      EXCEPTIONS foreign_lock = 1 system_failure = 2 OTHERS = 3.
    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING message = 'Template store is busy. Your draft is retained; retry Save.'.
    ENDIF.
    gv_lock_tab = iv_tab.
    gv_lock_key = iv_key.
    APPEND CONV string( iv_key ) TO gt_lock_keys.
    gv_locked = abap_true.
  ENDMETHOD.

  METHOD abort_changes.
    "No database writes occur until commit_changes.
    gt_forms = gt_base_forms.
    gt_templates = gt_base_templates.
    CLEAR gv_dirty.
    unlock_store( ).
  ENDMETHOD.

  METHOD commit_changes.
    DATA lv_lock_tab TYPE tabname.
    DATA lt_current_forms TYPE ty_forms.
    DATA lt_current_templates TYPE ty_templates.
    IF gv_dirty = abap_false.
      RETURN.
    ENDIF.
    lcl_pdf_security=>check( 'ZPDFEDIT' ).
    IF table_ready( ) = abap_true.
      commit_table( ).
      RETURN.
    ENDIF.
    lv_lock_tab = 'INDX'.
    lock_store( iv_tab = lv_lock_tab iv_key = lock_key( ) ).
    TRY.
        IMPORT forms = lt_current_forms templates = lt_current_templates
          FROM DATABASE indx(zp) ID c_store_id.
        IF lt_current_forms <> gt_base_forms OR
           lt_current_templates <> gt_base_templates.
          RAISE EXCEPTION TYPE cx_pdf_error
            EXPORTING message = 'Another session changed the store. Copy your draft, reopen the form, and reapply your changes.'.
        ENDIF.
        EXPORT forms = gt_forms templates = gt_templates
          TO DATABASE indx(zp) ID c_store_id.
        IF sy-subrc <> 0.
          RAISE EXCEPTION TYPE cx_pdf_error
            EXPORTING message = 'Could not persist templates'.
        ENDIF.
        "This report is the transaction owner. Do not call within a BAPI LUW.
        COMMIT WORK AND WAIT.
        IF sy-subrc <> 0.
          RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Commit reported an update failure; verify the saved store before retrying'.
        ENDIF.
        gt_base_forms = gt_forms.
        gt_base_templates = gt_templates.
        CLEAR gv_dirty.
        unlock_store( ).
      CATCH cx_root INTO DATA(lx_store).
        ROLLBACK WORK.
        unlock_store( ).
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING previous = lx_store message = lx_store->get_text( ).
    ENDTRY.
  ENDMETHOD.

  METHOD store_mode.
    TRY.
        IF table_ready( ) = abap_true.
          rv_mode = 'TABLE'.
        ELSE.
          rv_mode = 'INDX'.
        ENDIF.
      CATCH cx_pdf_error.
        rv_mode = 'INVALID'.
    ENDTRY.
  ENDMETHOD.

  METHOD table_ready.
    DATA lv_class TYPE dd02l-tabclass.
    DATA lo_type TYPE REF TO cl_abap_typedescr.
    DATA lo_struct TYPE REF TO cl_abap_structdescr.
    DATA lt_need TYPE string_table.
    DATA lv_need TYPE string.

    IF gv_mode IS INITIAL.
      gv_mode = 'INDX'.
      SELECT SINGLE tabclass FROM dd02l INTO lv_class
        WHERE tabname = c_table AND as4local = 'A' AND as4vers = '0000'.
      IF sy-subrc = 0 AND lv_class = 'TRANSP'.
        gv_mode = 'TABLE'.
        CALL METHOD cl_abap_typedescr=>describe_by_name
          EXPORTING
            p_name         = c_table
          RECEIVING
            p_descr_ref    = lo_type
          EXCEPTIONS
            type_not_found = 1
            OTHERS         = 2.
        IF sy-subrc = 0 AND lo_type->kind = cl_abap_typedescr=>kind_struct.
          lo_struct ?= lo_type.
          APPEND `MANDT` TO lt_need.
          APPEND `FORM_ID` TO lt_need.
          APPEND `VERSION` TO lt_need.
          APPEND `IS_ACTIVE` TO lt_need.
          APPEND `CHANGED_BY` TO lt_need.
          APPEND `CHANGED_AT` TO lt_need.
          APPEND `CONTENT` TO lt_need.
          LOOP AT lt_need INTO lv_need.
            READ TABLE lo_struct->components TRANSPORTING NO FIELDS WITH KEY name = lv_need.
            IF sy-subrc <> 0.
              gv_mode_error = |Table { c_table } has no field { lv_need }. Create it as described in the program header.|.
              EXIT.
            ENDIF.
          ENDLOOP.
        ELSE.
          gv_mode_error = |Table { c_table } cannot be read. Activate it in SE11.|.
        ENDIF.
      ENDIF.
    ENDIF.
    IF gv_mode_error IS NOT INITIAL.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = gv_mode_error.
    ENDIF.
    rv_ready = boolc( gv_mode = 'TABLE' ).
  ENDMETHOD.

  METHOD pack.
    DATA lv_xml TYPE xstring.
    TRY.
        CALL TRANSFORMATION id SOURCE form = is_form template = is_template RESULT XML lv_xml.
        cl_abap_gzip=>compress_binary( EXPORTING raw_in = lv_xml IMPORTING gzip_out = rv_content ).
      CATCH cx_root INTO DATA(lx_pack).
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING previous = lx_pack
                    message  = |Cannot store form { is_form-form_id }: { lx_pack->get_text( ) }|.
    ENDTRY.
  ENDMETHOD.

  METHOD unpack.
    DATA lv_xml TYPE xstring.
    CLEAR: es_form, es_template.
    TRY.
        cl_abap_gzip=>decompress_binary( EXPORTING gzip_in = iv_content IMPORTING raw_out = lv_xml ).
        CALL TRANSFORMATION id SOURCE XML lv_xml RESULT form = es_form template = es_template.
      CATCH cx_root INTO DATA(lx_unpack).
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING previous = lx_unpack
                    message  = |A row of { c_table } cannot be read: { lx_unpack->get_text( ) }|.
    ENDTRY.
  ENDMETHOD.

  METHOD db_read.
    DATA lr_rows TYPE REF TO data.
    DATA ls_form TYPE ty_form.
    DATA ls_template TYPE ty_template.
    DATA lv_version TYPE ty_version.
    DATA lv_content TYPE xstring.
    FIELD-SYMBOLS <lt_rows> TYPE STANDARD TABLE.
    FIELD-SYMBOLS <ls_row> TYPE any.
    FIELD-SYMBOLS <lv_field> TYPE any.

    CLEAR: et_forms, et_templates.
    CREATE DATA lr_rows TYPE STANDARD TABLE OF (c_table).
    ASSIGN lr_rows->* TO <lt_rows>.
    SELECT * FROM (c_table) INTO TABLE <lt_rows>.
    LOOP AT <lt_rows> ASSIGNING <ls_row>.
      ASSIGN COMPONENT 'VERSION' OF STRUCTURE <ls_row> TO <lv_field>.
      lv_version = <lv_field>.
      ASSIGN COMPONENT 'CONTENT' OF STRUCTURE <ls_row> TO <lv_field>.
      lv_content = <lv_field>.
      unpack( EXPORTING iv_content = lv_content IMPORTING es_form = ls_form es_template = ls_template ).
      READ TABLE et_forms TRANSPORTING NO FIELDS WITH KEY form_id = ls_form-form_id.
      IF sy-subrc <> 0.
        APPEND ls_form TO et_forms.
      ENDIF.
      "Version 0000 only carries the form of a form without a saved template.
      IF lv_version <> '0000'.
        APPEND ls_template TO et_templates.
      ENDIF.
    ENDLOOP.
    SORT et_forms BY form_id.
    SORT et_templates BY form_id version.
  ENDMETHOD.

  METHOD db_write_form.
    DATA lr_row TYPE REF TO data.
    DATA ls_form TYPE ty_form.
    DATA ls_template TYPE ty_template.
    DATA lt_rows TYPE ty_templates.
    FIELD-SYMBOLS <ls_row> TYPE any.
    FIELD-SYMBOLS <lv_field> TYPE any.

    "Bind the ID as data, including IDs loaded from legacy storage.
    DELETE FROM (c_table) WHERE form_id = @iv_form_id.
    READ TABLE gt_forms INTO ls_form WITH KEY form_id = iv_form_id.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.
    LOOP AT gt_templates INTO ls_template WHERE form_id = iv_form_id.
      APPEND ls_template TO lt_rows.
    ENDLOOP.
    IF lt_rows IS INITIAL.
      CLEAR ls_template.
      ls_template-form_id = iv_form_id.
      ls_template-version = '0000'.
      APPEND ls_template TO lt_rows.
    ENDIF.
    CREATE DATA lr_row TYPE (c_table).
    ASSIGN lr_row->* TO <ls_row>.
    LOOP AT lt_rows INTO ls_template.
      CLEAR <ls_row>.
      ASSIGN COMPONENT 'FORM_ID' OF STRUCTURE <ls_row> TO <lv_field>.
      <lv_field> = iv_form_id.
      ASSIGN COMPONENT 'VERSION' OF STRUCTURE <ls_row> TO <lv_field>.
      <lv_field> = ls_template-version.
      ASSIGN COMPONENT 'IS_ACTIVE' OF STRUCTURE <ls_row> TO <lv_field>.
      <lv_field> = ls_template-is_active.
      ASSIGN COMPONENT 'CHANGED_BY' OF STRUCTURE <ls_row> TO <lv_field>.
      <lv_field> = ls_form-changed_by.
      ASSIGN COMPONENT 'CHANGED_AT' OF STRUCTURE <ls_row> TO <lv_field>.
      <lv_field> = ls_form-changed_at.
      ASSIGN COMPONENT 'CONTENT' OF STRUCTURE <ls_row> TO <lv_field>.
      <lv_field> = pack( is_form = ls_form is_template = ls_template ).
      INSERT (c_table) FROM <ls_row>.
      IF sy-subrc <> 0.
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING message = |Form { iv_form_id } could not be written to { c_table }|.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD same_form.
    DATA ls_a TYPE ty_form.
    DATA ls_b TYPE ty_form.
    DATA ls_template TYPE ty_template.
    DATA lt_a TYPE ty_templates.
    DATA lt_b TYPE ty_templates.

    READ TABLE it_forms_a INTO ls_a WITH KEY form_id = iv_form_id.
    READ TABLE it_forms_b INTO ls_b WITH KEY form_id = iv_form_id.
    LOOP AT it_templates_a INTO ls_template WHERE form_id = iv_form_id.
      APPEND ls_template TO lt_a.
    ENDLOOP.
    LOOP AT it_templates_b INTO ls_template WHERE form_id = iv_form_id.
      APPEND ls_template TO lt_b.
    ENDLOOP.
    SORT lt_a BY version.
    SORT lt_b BY version.
    rv_same = boolc( ls_a = ls_b AND lt_a = lt_b ).
  ENDMETHOD.

  METHOD changed_forms.
    DATA ls_form TYPE ty_form.
    DATA lt_ids TYPE string_table.
    DATA lv_id TYPE string.

    LOOP AT gt_forms INTO ls_form.
      APPEND ls_form-form_id TO lt_ids.
    ENDLOOP.
    LOOP AT gt_base_forms INTO ls_form.
      APPEND ls_form-form_id TO lt_ids.
    ENDLOOP.
    SORT lt_ids.
    DELETE ADJACENT DUPLICATES FROM lt_ids.
    LOOP AT lt_ids INTO lv_id.
      IF same_form( iv_form_id = lv_id
                    it_forms_a = gt_forms it_templates_a = gt_templates
                    it_forms_b = gt_base_forms it_templates_b = gt_base_templates ) = abap_false.
        APPEND lv_id TO rt_ids.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD is_local.
    "Forms in a $ package (default $TMP) are local objects, as in Adobe Forms:
    "they are saved without a transport request. A deleted form uses its stored package.
    DATA ls_form TYPE ty_form.
    DATA lv_package TYPE string.
    READ TABLE gt_forms INTO ls_form WITH KEY form_id = iv_form_id.
    IF sy-subrc <> 0.
      READ TABLE gt_base_forms INTO ls_form WITH KEY form_id = iv_form_id.
    ENDIF.
    lv_package = to_upper( condense( ls_form-package ) ).
    rv_local = boolc( lv_package IS INITIAL OR lv_package CP '$*' ).
  ENDMETHOD.

  METHOD commit_table.
    DATA lt_ids TYPE string_table.
    DATA lt_record TYPE string_table.
    DATA lv_id TYPE string.
    DATA lv_task TYPE trkorr.
    DATA lt_db_forms TYPE ty_forms.
    DATA lt_db_templates TYPE ty_templates.
    DATA lv_lock_key TYPE rstable-varkey.
    DATA lv_lock_id TYPE c LENGTH 30.
    DATA ls_saved_form TYPE ty_form.
    DATA ls_saved_template TYPE ty_template.

    CLEAR gv_last_request.
    lt_ids = changed_forms( ).
    IF lt_ids IS INITIAL.
      CLEAR gv_dirty.
      RETURN.
    ENDIF.
    CASE client_recording( ).
      WHEN '2'.
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING message = 'Forms cannot be changed in this client (SCC4: no changes allowed). Change them in the development system and transport them.'.
      WHEN '1'.
        "Automatic recording: every change of a form goes into a request, as in SPRO.
        "Local forms ($TMP) are saved without a request.
        IF iv_record = abap_true.
          LOOP AT lt_ids INTO lv_id.
            IF is_local( lv_id ) = abap_false.
              APPEND lv_id TO lt_record.
            ENDIF.
          ENDLOOP.
          IF lt_record IS NOT INITIAL.
            lv_task = choose_request( ).
          ENDIF.
        ENDIF.
    ENDCASE.
    "One lock per changed form, so different forms can be saved at the same time.
    LOOP AT lt_ids INTO lv_id.
      lv_lock_id = lv_id.
      CONCATENATE sy-mandt lv_lock_id INTO lv_lock_key RESPECTING BLANKS.
      TRY.
          lock_store( iv_tab = c_table iv_key = lv_lock_key ).
        CATCH cx_pdf_error.
          unlock_store( ).
          RAISE EXCEPTION TYPE cx_pdf_error
            EXPORTING message = |Form { lv_id } is being saved by another user. Your draft is retained; retry Save.|.
      ENDTRY.
    ENDLOOP.
    TRY.
        "Only the changed forms are checked and rewritten; forms that arrived by
        "transport or were saved by someone else meanwhile stay untouched.
        db_read( IMPORTING et_forms = lt_db_forms et_templates = lt_db_templates ).
        LOOP AT lt_ids INTO lv_id.
          IF same_form( iv_form_id = lv_id
                        it_forms_a = lt_db_forms it_templates_a = lt_db_templates
                        it_forms_b = gt_base_forms it_templates_b = gt_base_templates ) = abap_false.
            RAISE EXCEPTION TYPE cx_pdf_error
              EXPORTING message = |Form { lv_id } was changed in another session or by a transport. Copy your draft, reopen the form, and reapply your changes.|.
          ENDIF.
        ENDLOOP.
        LOOP AT lt_ids INTO lv_id.
          db_write_form( lv_id ).
        ENDLOOP.
        IF lv_task IS NOT INITIAL.
          record_forms( it_ids = lt_record iv_task = lv_task ).
        ENDIF.
        COMMIT WORK AND WAIT.
        IF sy-subrc <> 0.
          RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Commit reported an update failure; verify the saved store before retrying'.
        ENDIF.
        "The changed forms are now stored as in memory; the others keep their old base,
        "so a later save still notices if they were changed by someone else.
        gt_base_forms = gt_forms.
        gt_base_templates = gt_templates.
        db_read( IMPORTING et_forms = lt_db_forms et_templates = lt_db_templates ).
        LOOP AT lt_ids INTO lv_id.
          DELETE gt_forms WHERE form_id = lv_id.
          DELETE gt_templates WHERE form_id = lv_id.
          DELETE gt_base_forms WHERE form_id = lv_id.
          DELETE gt_base_templates WHERE form_id = lv_id.
          LOOP AT lt_db_forms INTO ls_saved_form WHERE form_id = lv_id.
            APPEND ls_saved_form TO gt_forms.
            APPEND ls_saved_form TO gt_base_forms.
          ENDLOOP.
          LOOP AT lt_db_templates INTO ls_saved_template WHERE form_id = lv_id.
            APPEND ls_saved_template TO gt_templates.
            APPEND ls_saved_template TO gt_base_templates.
          ENDLOOP.
        ENDLOOP.
        SORT gt_forms BY form_id.
        SORT gt_templates BY form_id version.
        SORT gt_base_forms BY form_id.
        SORT gt_base_templates BY form_id version.
        CLEAR gv_dirty.
        unlock_store( ).
        IF lv_task IS NOT INITIAL.
          SELECT SINGLE strkorr FROM e070 INTO gv_last_request WHERE trkorr = lv_task.
          IF gv_last_request IS INITIAL.
            gv_last_request = lv_task.
          ENDIF.
        ENDIF.
      CATCH cx_root INTO DATA(lx_store).
        ROLLBACK WORK.
        unlock_store( ).
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING previous = lx_store message = lx_store->get_text( ).
    ENDTRY.
  ENDMETHOD.

  METHOD store_initialized.
    DATA lv_done TYPE abap_bool.
    TRY.
        IMPORT done = lv_done FROM DATABASE indx(zp) ID c_setup_id.
        rv_done = boolc( sy-subrc = 0 AND lv_done = abap_true ).
      CATCH cx_root.
        rv_done = abap_false.
    ENDTRY.
  ENDMETHOD.

  METHOD mark_initialized.
    DATA lv_done TYPE abap_bool VALUE abap_true.
    EXPORT done = lv_done TO DATABASE indx(zp) ID c_setup_id.
    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Could not save the form store setup marker'.
    ENDIF.
  ENDMETHOD.

  METHOD client_recording.
    SELECT SINGLE cccoractiv FROM t000 INTO rv_flag WHERE mandt = sy-mandt.
  ENDMETHOD.

  METHOD choose_request.
    DATA lv_flag TYPE dd02l-contflag.
    DATA lv_order TYPE trkorr.
    DATA lv_task TYPE trkorr.
    DATA lv_text TYPE string.

    SELECT SINGLE contflag FROM dd02l INTO lv_flag
      WHERE tabname = c_table AND as4local = 'A' AND as4vers = '0000'.
    IF lv_flag <> 'C' AND lv_flag <> 'G' AND lv_flag <> 'E'.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING message = |Set the delivery class of { c_table } to C (customizing) in SE11 to transport forms.|.
    ENDIF.
    "SCC4 'no transports allowed' (TK432): customizing cannot go into a request in this client.
    IF client_recording( ) = '3'.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING message = |This client does not allow transports (SCC4: changes without automatic recording, no transports allowed). | &&
                            |In SCC4 set client { sy-mandt } to "Automatic recording of changes" or "Changes without automatic recording", then try again.|.
    ENDIF.
    TRY.
        CALL FUNCTION 'TR_ORDER_CHOICE_CORRECTION'
          EXPORTING
            iv_category            = 'CUST'
            iv_cli_dep             = abap_true
          IMPORTING
            ev_order               = lv_order
            ev_task                = lv_task
          EXCEPTIONS
            invalid_category       = 1
            no_correction_selected = 2
            OTHERS                 = 3.
      CATCH cx_sy_dyn_call_error INTO DATA(lx_call).
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING previous = lx_call
                    message  = |Transport request could not be chosen: { lx_call->get_text( ) }|.
    ENDTRY.
    IF sy-subrc = 2.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING message = 'No transport request was chosen; nothing was saved or recorded.'.
    ELSEIF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE 'S' NUMBER sy-msgno WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 INTO lv_text.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING message = |Transport request could not be chosen: { lv_text }|.
    ENDIF.
    rv_task = lv_task.
    IF rv_task IS INITIAL.
      rv_task = lv_order.
    ENDIF.
  ENDMETHOD.

  METHOD record_forms.
    "TABLES parameters of the transport API need standard tables with a default key.
    DATA lt_e071 TYPE STANDARD TABLE OF e071 WITH DEFAULT KEY.
    DATA lt_e071k TYPE STANDARD TABLE OF e071k WITH DEFAULT KEY.
    DATA ls_e071 TYPE e071.
    DATA ls_e071k TYPE e071k.
    DATA lv_id TYPE string.
    DATA lv_key TYPE c LENGTH 30.
    DATA lv_text TYPE string.

    ls_e071-trkorr = iv_task.
    ls_e071-pgmid = 'R3TR'.
    ls_e071-object = 'TABU'.
    ls_e071-obj_name = c_table.
    ls_e071-objfunc = 'K'.
    APPEND ls_e071 TO lt_e071.
    LOOP AT it_ids INTO lv_id.
      "Key: client + form ID + any version. A deleted form is transported as a deletion.
      lv_key = lv_id.
      CLEAR ls_e071k.
      ls_e071k-trkorr = iv_task.
      ls_e071k-pgmid = 'R3TR'.
      ls_e071k-object = 'TABU'.
      ls_e071k-objname = c_table.
      ls_e071k-mastertype = 'TABU'.
      ls_e071k-mastername = c_table.
      CONCATENATE sy-mandt lv_key '*' INTO ls_e071k-tabkey RESPECTING BLANKS.
      APPEND ls_e071k TO lt_e071k.
    ENDLOOP.
    TRY.
        CALL FUNCTION 'TR_APPEND_TO_COMM_OBJS_KEYS'
          EXPORTING
            wi_trkorr = iv_task
          TABLES
            wt_e071   = lt_e071
            wt_e071k  = lt_e071k
          EXCEPTIONS
            OTHERS    = 1.
      CATCH cx_sy_dyn_call_error INTO DATA(lx_call).
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING previous = lx_call
                    message  = |Form could not be added to request { iv_task }: { lx_call->get_text( ) }|.
    ENDTRY.
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE 'S' NUMBER sy-msgno WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4 INTO lv_text.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING message = |Form could not be added to request { iv_task }: { lv_text } (message { sy-msgid } { sy-msgno })|.
    ENDIF.
  ENDMETHOD.

  METHOD transport_form.
    DATA lv_id TYPE string.
    DATA lv_task TYPE trkorr.
    DATA lt_ids TYPE string_table.

    lcl_pdf_security=>check( 'ZPDFEDIT' ).
    load_store( ).
    IF table_ready( ) = abap_false.
      RAISE EXCEPTION TYPE cx_pdf_error
        EXPORTING message = |Forms are kept in INDX, which cannot be transported. Create table { c_table } (see the program header) and start the designer again.|.
    ENDIF.
    lv_id = normalize_id( iv_form_id ).
    READ TABLE gt_forms TRANSPORTING NO FIELDS WITH KEY form_id = lv_id.
    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = |Form { lv_id } does not exist|.
    ENDIF.
    IF gv_dirty = abap_true.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Save the form before adding it to a transport request.'.
    ENDIF.
    lv_task = choose_request( ).
    APPEND lv_id TO lt_ids.
    record_forms( it_ids = lt_ids iv_task = lv_task ).
    COMMIT WORK.
    SELECT SINGLE strkorr FROM e070 INTO rv_request WHERE trkorr = lv_task.
    IF rv_request IS INITIAL.
      rv_request = lv_task.
    ENDIF.
  ENDMETHOD.

  METHOD form_requests.
    TYPES:
      BEGIN OF ty_hit,
        tabkey  TYPE e071k-tabkey,
        trkorr  TYPE e071k-trkorr,
        strkorr TYPE e070-strkorr,
      END OF ty_hit.
    DATA lt_hits TYPE STANDARD TABLE OF ty_hit WITH EMPTY KEY.
    DATA ls_hit TYPE ty_hit.
    DATA ls_request TYPE ty_form_request.
    DATA lv_key TYPE string.
    DATA lv_rest TYPE string.

    IF store_mode( ) <> 'TABLE'.
      RETURN.
    ENDIF.
    SELECT k~tabkey k~trkorr h~strkorr INTO TABLE lt_hits
      FROM e071k AS k INNER JOIN e070 AS h ON h~trkorr = k~trkorr
      WHERE k~pgmid = 'R3TR' AND k~object = 'TABU' AND k~objname = c_table
        AND ( h~trstatus = 'D' OR h~trstatus = 'L' ).
    LOOP AT lt_hits INTO ls_hit.
      IF ls_hit-tabkey(3) <> sy-mandt.
        CONTINUE.
      ENDIF.
      lv_key = ls_hit-tabkey+3.
      SPLIT lv_key AT '*' INTO lv_key lv_rest.
      CONDENSE lv_key.
      IF lv_key IS INITIAL.
        CONTINUE.
      ENDIF.
      ls_request-form_id = lv_key.
      ls_request-request = ls_hit-strkorr.
      IF ls_request-request IS INITIAL.
        ls_request-request = ls_hit-trkorr.
      ENDIF.
      READ TABLE rt_requests TRANSPORTING NO FIELDS WITH KEY form_id = ls_request-form_id request = ls_request-request.
      IF sy-subrc <> 0.
        APPEND ls_request TO rt_requests.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.

  METHOD last_request.
    rv_request = gv_last_request.
  ENDMETHOD.

  METHOD take_note.
    rv_note = gv_note.
    CLEAR gv_note.
  ENDMETHOD.

ENDCLASS.

*& lcl_pdf_renderer
CLASS lcl_pdf_renderer IMPLEMENTATION.

  METHOD validate_page.
    IF is_page-page_size <> 'A3' AND is_page-page_size <> 'A4' AND
       is_page-page_size <> 'A5' AND is_page-page_size <> 'LETTER' AND
       is_page-page_size <> 'LEGAL'.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Unsupported page size'.
    ENDIF.
    IF is_page-orientation <> 'P' AND is_page-orientation <> 'L'.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Orientation must be P or L'.
    ENDIF.
    IF is_page-margin_top < 0 OR is_page-margin_top > 500 OR
       is_page-margin_right < 0 OR is_page-margin_right > 500 OR
       is_page-margin_bottom < 0 OR is_page-margin_bottom > 500 OR
       is_page-margin_left < 0 OR is_page-margin_left > 500.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Margins must be between 0 and 500 mm'.
    ENDIF.
    DATA lv_width TYPE decfloat34.
    DATA lv_height TYPE decfloat34.
    CASE is_page-page_size.
      WHEN 'A3'. lv_width = 297. lv_height = 420.
      WHEN 'A4'. lv_width = 210. lv_height = 297.
      WHEN 'A5'. lv_width = 148. lv_height = 210.
      WHEN 'LETTER'. lv_width = '215.9'. lv_height = '279.4'.
      WHEN 'LEGAL'. lv_width = '215.9'. lv_height = '355.6'.
    ENDCASE.
    IF is_page-orientation = 'L'.
      DATA(lv_swap) = lv_width.
      lv_width = lv_height.
      lv_height = lv_swap.
    ENDIF.
    IF is_page-margin_left + is_page-margin_right >= lv_width OR
       is_page-margin_top + is_page-margin_bottom >= lv_height.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Margins leave no printable page area'.
    ENDIF.
  ENDMETHOD.

  METHOD render.
    DATA lv_width TYPE string.
    DATA lv_height TYPE string.
    DATA lv_page_css TYPE string.
    DATA lv_html TYPE string.
    DATA lv_header TYPE string.
    DATA lv_footer TYPE string.
    DATA lv_body TYPE string.
    DATA lv_boundary TYPE string.
    DATA lv_url TYPE string.
    DATA lv_timeout TYPE i.
    DATA lv_type TYPE string.
    DATA ls_page TYPE ty_page.
    DATA lv_body_html TYPE string.

    "The leading <!--abappdf...--> layout metadata is not sent to Gotenberg.
    lv_body_html = iv_html.
    IF strlen( lv_body_html ) > 11 AND lv_body_html(11) = '<!--abappdf'.
      DATA(lv_meta_end) = find( val = lv_body_html sub = '-->' ).
      IF lv_meta_end > 0.
        lv_body_html = substring( val = lv_body_html off = lv_meta_end + 3 ).
      ENDIF.
    ENDIF.

    ls_page = is_page.
    IF ls_page-page_size IS INITIAL.
      ls_page-page_size = 'A4'.
      IF ls_page-orientation IS INITIAL.
        ls_page-orientation = 'P'.
      ENDIF.
      IF ls_page-margin_top = 0 AND ls_page-margin_right = 0
          AND ls_page-margin_bottom = 0 AND ls_page-margin_left = 0.
        ls_page-margin_top = 12.
        ls_page-margin_right = 10.
        ls_page-margin_bottom = 16.
        ls_page-margin_left = 10.
      ENDIF.
    ENDIF.

    validate_page( ls_page ).
    "Native engine: the PDF is written in ABAP, no Gotenberg call.
    IF lcl_pdf_form_manager=>get_config( 'ENGINE' ) = 'NATIVE'.
      rv_pdf = lcl_pdf_native=>render(
        iv_html   = iv_html
        iv_css    = iv_css
        iv_header = iv_header
        iv_footer = iv_footer
        is_page   = ls_page ).
      RETURN.
    ENDIF.
    IF strlen( iv_html ) + strlen( iv_css ) + strlen( iv_header ) + strlen( iv_footer ) > 2000000.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Rendered HTML/CSS exceeds 2 million characters'.
    ENDIF.
    page_spec(
      EXPORTING
        is_page     = ls_page
      IMPORTING
        ev_width    = lv_width
        ev_height   = lv_height
        ev_page_css = lv_page_css ).

    "QR codes and barcodes become inline SVG for Chromium.
    lv_body_html = lcl_pdf_codes=>expand_html( lv_body_html ).
    lv_html = compose_document(
      iv_html     = lv_body_html
      iv_css      = iv_css
      iv_page_css = lv_page_css ).

    lv_boundary = 'abappdfB7f3a9c2e1b04d88'.
    WHILE lv_html CS lv_boundary OR iv_header CS lv_boundary OR iv_footer CS lv_boundary.
      lv_boundary = lv_boundary && 'Z'.
    ENDWHILE.

    append_file(
      EXPORTING
        iv_boundary = lv_boundary
        iv_filename = 'index.html'
        iv_content  = lv_html
      CHANGING
        cv_body     = lv_body ).

    IF iv_header IS NOT INITIAL.
      lv_header = compose_fragment( iv_header ).
      append_file(
        EXPORTING
          iv_boundary = lv_boundary
          iv_filename = 'header.html'
          iv_content  = lv_header
        CHANGING
          cv_body     = lv_body ).
    ENDIF.

    IF iv_footer IS NOT INITIAL.
      lv_footer = compose_fragment( iv_footer ).
      append_file(
        EXPORTING
          iv_boundary = lv_boundary
          iv_filename = 'footer.html'
          iv_content  = lv_footer
        CHANGING
          cv_body     = lv_body ).
    ENDIF.

    append_field(
      EXPORTING iv_boundary = lv_boundary iv_name = 'paperWidth' iv_value = lv_width
      CHANGING cv_body = lv_body ).
    append_field(
      EXPORTING iv_boundary = lv_boundary iv_name = 'paperHeight' iv_value = lv_height
      CHANGING cv_body = lv_body ).
    append_field(
      EXPORTING iv_boundary = lv_boundary iv_name = 'marginTop'
                iv_value = |{ ls_page-margin_top }mm|
      CHANGING cv_body = lv_body ).
    append_field(
      EXPORTING iv_boundary = lv_boundary iv_name = 'marginBottom'
                iv_value = |{ ls_page-margin_bottom }mm|
      CHANGING cv_body = lv_body ).
    append_field(
      EXPORTING iv_boundary = lv_boundary iv_name = 'marginLeft'
                iv_value = |{ ls_page-margin_left }mm|
      CHANGING cv_body = lv_body ).
    append_field(
      EXPORTING iv_boundary = lv_boundary iv_name = 'marginRight'
                iv_value = |{ ls_page-margin_right }mm|
      CHANGING cv_body = lv_body ).
    append_field(
      EXPORTING iv_boundary = lv_boundary iv_name = 'landscape' iv_value = 'false'
      CHANGING cv_body = lv_body ).
    append_field(
      EXPORTING iv_boundary = lv_boundary iv_name = 'printBackground' iv_value = 'true'
      CHANGING cv_body = lv_body ).
    append_field(
      EXPORTING iv_boundary = lv_boundary iv_name = 'preferCssPageSize' iv_value = 'true'
      CHANGING cv_body = lv_body ).
    append_field(
      EXPORTING iv_boundary = lv_boundary iv_name = 'emulatedMediaType' iv_value = 'print'
      CHANGING cv_body = lv_body ).

    lv_body = lv_body && '--' && lv_boundary && '--' && cl_abap_char_utilities=>cr_lf.
    lv_type = 'multipart/form-data; boundary=' && lv_boundary.
    lv_url = endpoint( c_path ).

    lv_timeout = lcl_pdf_form_manager=>get_config( 'HTTP_TIMEOUT' ).
    IF lv_timeout <= 0.
      lv_timeout = 60.
    ENDIF.

    rv_pdf = post(
      iv_url          = lv_url
      iv_content_type = lv_type
      iv_body         = lcl_pdf_convert=>string_to_xstring( lv_body )
      iv_timeout      = lv_timeout ).
  ENDMETHOD.

  METHOD lif_pdf_render~ping.
    DATA lv_timeout TYPE i VALUE 5.
    DATA lv_body TYPE xstring.
    lv_body = post(
      iv_url          = endpoint( '/health' )
      iv_content_type = 'text/plain'
      iv_body         = lcl_pdf_convert=>string_to_xstring( '' )
      iv_timeout      = lv_timeout
      iv_accept_pdf   = abap_false ).
  ENDMETHOD.

  METHOD endpoint.
    DATA lv_base TYPE string.
    DATA lv_len TYPE i.
    DATA lv_suffix TYPE string.

    lv_base = lcl_pdf_form_manager=>get_config( 'GOTENBERG_URL' ).
    SHIFT lv_base LEFT DELETING LEADING space.
    SHIFT lv_base RIGHT DELETING TRAILING space.
    IF lv_base IS INITIAL.
      lv_base = gc_gotenberg_url.
    ENDIF.

    lv_suffix = c_path.
    lv_len = strlen( lv_base ) - strlen( lv_suffix ).
    IF lv_len > 0.
      IF substring( val = lv_base off = lv_len ) = lv_suffix.
        lv_base = substring( val = lv_base len = lv_len ).
      ENDIF.
    ENDIF.
    IF strlen( lv_base ) >= 7.
      IF substring( val = lv_base off = strlen( lv_base ) - 7 ) = '/health'.
        lv_base = substring( val = lv_base len = strlen( lv_base ) - 7 ).
      ENDIF.
    ENDIF.

    lv_len = strlen( lv_base ).
    IF lv_len > 0.
      IF substring( val = lv_base off = lv_len - 1 ) = '/'.
        lv_base = substring( val = lv_base len = lv_len - 1 ).
      ENDIF.
    ENDIF.
    rv_url = lv_base && iv_path.
  ENDMETHOD.

  METHOD page_spec.
    DATA lv_size TYPE string.
    DATA lv_css TYPE string.
    DATA lv_orient TYPE string.
    DATA lv_width TYPE string.
    DATA lv_height TYPE string.

    lv_size = to_upper( is_page-page_size ).
    CASE lv_size.
      WHEN 'A3'.
        lv_width = '297mm'.
        lv_height = '420mm'.
        lv_css = 'A3'.
      WHEN 'A5'.
        lv_width = '148mm'.
        lv_height = '210mm'.
        lv_css = 'A5'.
      WHEN 'LETTER'.
        lv_width = '8.5in'.
        lv_height = '11in'.
        lv_css = 'letter'.
      WHEN 'LEGAL'.
        lv_width = '8.5in'.
        lv_height = '14in'.
        lv_css = 'legal'.
      WHEN OTHERS.
        lv_width = '210mm'.
        lv_height = '297mm'.
        lv_css = 'A4'.
    ENDCASE.

    IF is_page-orientation = 'L'.
      DATA lv_swap TYPE string.
      lv_swap = lv_width.
      lv_width = lv_height.
      lv_height = lv_swap.
      lv_orient = 'landscape'.
    ELSE.
      lv_orient = 'portrait'.
    ENDIF.

    ev_width = lv_width.
    ev_height = lv_height.
    ev_page_css =
      |@page \{ size: { lv_css } { lv_orient }; margin: { is_page-margin_top }mm | &&
      |{ is_page-margin_right }mm { is_page-margin_bottom }mm { is_page-margin_left }mm; \}| &&
      cl_abap_char_utilities=>newline &&
      |html, body \{ margin: 0; padding: 0; \}| &&
      cl_abap_char_utilities=>newline &&
      "A table's top margin must not collapse through body, or it shifts the
      "absolutely positioned designer objects down with it.
      |body \{ display: flow-root; \}|.
  ENDMETHOD.

  METHOD compose_document.
    DATA lv_style TYPE string.
    DATA lv_upper TYPE string.
    DATA lv_pos TYPE i.

    lv_style = '<style>' && iv_page_css && cl_abap_char_utilities=>newline &&
      iv_css && '</style>'.

    IF contains_html( iv_html ) = abap_false.
      rv_html = '<!DOCTYPE html><html><head><meta charset="utf-8">' &&
        lv_style && '</head><body>' && iv_html && '</body></html>'.
      RETURN.
    ENDIF.

    lv_upper = to_upper( iv_html ).
    lv_pos = find( val = lv_upper sub = '</HEAD>' ).
    IF lv_pos >= 0.
      rv_html = substring( val = iv_html len = lv_pos ) &&
        lv_style &&
        substring( val = iv_html off = lv_pos ).
      RETURN.
    ENDIF.

    rv_html = lv_style && iv_html.
  ENDMETHOD.

  METHOD compose_fragment.
    IF contains_html( iv_html ) = abap_true.
      rv_html = iv_html.
      RETURN.
    ENDIF.
    rv_html = '<!DOCTYPE html><html><head><meta charset="utf-8"><style>' &&
      'body{margin:0;padding:0;font-family:sans-serif;font-size:9pt;}' &&
      '</style></head><body>' && iv_html && '</body></html>'.
  ENDMETHOD.

  METHOD contains_html.
    rv_yes = xsdbool( to_upper( iv_html ) CS '<HTML' ).
  ENDMETHOD.

  METHOD append_file.
    DATA lv_crlf TYPE string.
    lv_crlf = cl_abap_char_utilities=>cr_lf.
    cv_body = cv_body && '--' && iv_boundary && lv_crlf &&
      'Content-Disposition: form-data; name="files"; filename="' &&
      iv_filename && '"' && lv_crlf &&
      'Content-Type: text/html; charset=utf-8' && lv_crlf && lv_crlf &&
      iv_content && lv_crlf.
  ENDMETHOD.

  METHOD append_field.
    DATA lv_crlf TYPE string.
    lv_crlf = cl_abap_char_utilities=>cr_lf.
    cv_body = cv_body && '--' && iv_boundary && lv_crlf &&
      'Content-Disposition: form-data; name="' && iv_name && '"' &&
      lv_crlf && lv_crlf && iv_value && lv_crlf.
  ENDMETHOD.

  METHOD post.
    rv_body = post_classic(
      iv_url = iv_url iv_content_type = iv_content_type
      iv_body = iv_body iv_timeout = iv_timeout ).

    IF iv_accept_pdf = abap_true.
      IF xstrlen( rv_body ) < 5.
        RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Gotenberg returned an empty PDF'.
      ENDIF.
      IF rv_body(5) <> '255044462D'.
        RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Response is not a PDF (%PDF- signature missing)'.
      ENDIF.
      IF xstrlen( rv_body ) > 50000000.
        RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'PDF exceeds the 50 MB application limit'.
      ENDIF.
    ENDIF.
  ENDMETHOD.

  METHOD post_classic.
    DATA lo_client TYPE REF TO if_http_client.
    DATA lv_code TYPE i.
    DATA lv_reason TYPE string.
    DATA lv_error TYPE string.
    DATA lv_path TYPE string.
    DATA lv_text TYPE string.

    TRY.
        "Recheck at the network boundary; never use a user-supplied destination.
        IF iv_url = |dest://{ gc_gotenberg_dest }{ c_path }|.
          lv_path = c_path.
        ELSEIF iv_url = |dest://{ gc_gotenberg_dest }/health|.
          lv_path = '/health'.
        ELSE.
          RAISE EXCEPTION TYPE cx_pdf_error
            EXPORTING message = 'Unapproved rendering endpoint'.
        ENDIF.
        cl_http_client=>create_by_destination(
          EXPORTING destination = gc_gotenberg_dest
          IMPORTING client = lo_client
          EXCEPTIONS argument_not_found = 1 destination_not_found = 2
                     internal_error = 3 plugin_not_active = 4 OTHERS = 5 ).
        IF sy-subrc <> 0.
          RAISE EXCEPTION TYPE cx_pdf_error
            EXPORTING message = |Configure SM59 destination { gc_gotenberg_dest } before rendering|.
        ENDIF.
        lo_client->propertytype_redirect = if_http_client=>co_disabled.
        lo_client->propertytype_logon_popup = if_http_client=>co_disabled.
        cl_http_utility=>set_request_uri( request = lo_client->request uri = lv_path ).
        lo_client->request->set_method( 'GET' ).
        IF iv_body IS NOT INITIAL.
          lo_client->request->set_method( 'POST' ).
        ENDIF.

        lo_client->request->set_header_field(
          name  = 'User-Agent'
          value = 'abapPDF' ).
        IF iv_body IS NOT INITIAL.
          lo_client->request->set_data( iv_body ).
          lo_client->request->set_content_type( iv_content_type ).
        ENDIF.

        lo_client->send(
          EXPORTING
            timeout = iv_timeout
          EXCEPTIONS
            http_communication_failure = 1
            http_invalid_state = 2
            http_processing_failed = 3
            http_invalid_timeout = 4
            OTHERS = 5 ).
        IF sy-subrc <> 0.
          RAISE EXCEPTION TYPE cx_pdf_error
            EXPORTING
              message = |HTTP send to Gotenberg failed ({ sy-subrc })|.
        ENDIF.

        lo_client->receive(
          EXCEPTIONS
            http_communication_failure = 1
            http_invalid_state = 2
            http_processing_failed = 3
            OTHERS = 4 ).
        IF sy-subrc <> 0.
          RAISE EXCEPTION TYPE cx_pdf_error
            EXPORTING
              message = |HTTP receive from Gotenberg failed ({ sy-subrc })|.
        ENDIF.

        lo_client->response->get_status(
          IMPORTING
            code   = lv_code
            reason = lv_reason ).
        IF lv_code < 200 OR lv_code >= 300.
          lv_error = lo_client->response->get_cdata( ).
          IF strlen( lv_error ) > 500.
            lv_error = substring( val = lv_error len = 500 ).
          ENDIF.
          RAISE EXCEPTION TYPE cx_pdf_error
            EXPORTING
              message = |Gotenberg HTTP { lv_code } { lv_reason }: { lv_error }|.
        ENDIF.

        IF iv_body IS NOT INITIAL.
          DATA(lv_mime) = to_lower( lo_client->response->get_header_field( 'content-type' ) ).
          SPLIT lv_mime AT ';' INTO lv_mime lv_text.
          CONDENSE lv_mime.
          IF lv_mime <> 'application/pdf'.
            RAISE EXCEPTION TYPE cx_pdf_error
              EXPORTING message = |Expected application/pdf, received { lv_mime }|.
          ENDIF.
        ENDIF.
        rv_body = lo_client->response->get_data( ).
        lo_client->close( ).
        FREE lo_client.

      CLEANUP.
        IF lo_client IS BOUND.
          lo_client->close( ).
        ENDIF.
    ENDTRY.
  ENDMETHOD.

  METHOD post_cloud.
    DATA lv_pdf TYPE xstring.
    TRY.
        CALL METHOD ('ZCL_PDF_HTTP_CLOUD')=>post
          EXPORTING
            iv_url          = iv_url
            iv_content_type = iv_content_type
            iv_body         = iv_body
            iv_timeout      = iv_timeout
          RECEIVING
            rv_body         = lv_pdf.
        rv_body = lv_pdf.
      CATCH cx_root INTO DATA(lx_error).
        RAISE EXCEPTION TYPE cx_pdf_error
          EXPORTING
            previous = lx_error
            message  = |Cloud HTTP stack failed. Activate cloud/zcl_pdf_http_cloud.clas.abap and set HTTP_STACK = CLOUD. { lx_error->get_text( ) }|.
    ENDTRY.
  ENDMETHOD.

ENDCLASS.

*& lcl_pdf_native
CLASS lcl_pdf_native IMPLEMENTATION.

  METHOD render.
    DATA lo_native TYPE REF TO lcl_pdf_native.
    CREATE OBJECT lo_native.
    rv_pdf = lo_native->run(
      iv_html   = iv_html
      iv_css    = iv_css
      iv_header = iv_header
      iv_footer = iv_footer
      is_page   = is_page ).
  ENDMETHOD.

  METHOD run.
    DATA lt_tokens TYPE ty_tokens.
    DATA ls_token TYPE ty_token.
    DATA lv_widgets TYPE abap_bool.
    DATA lv_total TYPE i.
    DATA lv_page TYPE i.

    setup_page( is_page ).
    load_widths( ).
    parse_css( iv_css ).

    IF strlen( iv_html ) >= 11 AND iv_html(11) = '<!--abappdf'.
      lv_widgets = abap_true.
    ENDIF.
    lt_tokens = tokenize( iv_html ).
    IF lv_widgets = abap_false.
      LOOP AT lt_tokens INTO ls_token WHERE kind = 'O' AND name = 'div'.
        IF to_lower( attr( iv_attrs = ls_token-attrs iv_name = `style` ) ) CS 'position:absolute'.
          lv_widgets = abap_true.
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.

    IF lv_widgets = abap_true.
      layout_widgets( lt_tokens ).
    ELSE.
      layout_flow( lt_tokens ).
    ENDIF.
    IF mt_pages IS INITIAL.
      new_page( ).
    ENDIF.

    lv_total = lines( mt_pages ).
    DO lv_total TIMES.
      lv_page = sy-index.
      mv_page = lv_page.
      IF iv_header IS NOT INITIAL.
        margin_text( iv_fragment = iv_header iv_page = lv_page iv_total = lv_total iv_top = abap_true ).
      ENDIF.
      IF iv_footer IS NOT INITIAL.
        margin_text( iv_fragment = iv_footer iv_page = lv_page iv_total = lv_total iv_top = abap_false ).
      ENDIF.
    ENDDO.

    rv_pdf = assemble( ).
  ENDMETHOD.

  METHOD setup_page.
    DATA lv_w TYPE f.
    DATA lv_h TYPE f.
    DATA lv_swap TYPE f.
    DATA lv_mm TYPE f.

    CASE to_upper( is_page-page_size ).
      WHEN 'A3'.
        lv_w = 297.
        lv_h = 420.
      WHEN 'A5'.
        lv_w = 148.
        lv_h = 210.
      WHEN 'LETTER'.
        lv_w = '215.9'.
        lv_h = '279.4'.
      WHEN 'LEGAL'.
        lv_w = '215.9'.
        lv_h = '355.6'.
      WHEN OTHERS.
        lv_w = 210.
        lv_h = 297.
    ENDCASE.
    IF is_page-orientation = 'L'.
      lv_swap = lv_w.
      lv_w = lv_h.
      lv_h = lv_swap.
    ENDIF.
    lv_mm = 72 / '25.4'.
    mv_pw = lv_w * lv_mm.
    mv_ph = lv_h * lv_mm.
    mv_mt = is_page-margin_top * lv_mm.
    mv_mr = is_page-margin_right * lv_mm.
    mv_mb = is_page-margin_bottom * lv_mm.
    mv_ml = is_page-margin_left * lv_mm.
  ENDMETHOD.

