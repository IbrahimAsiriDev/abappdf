*& lcl_pdf_app
CLASS lcl_pdf_app IMPLEMENTATION.

  METHOD set_source.
    gv_src_file = iv_file.
    gv_src_mime = iv_mime.
  ENDMETHOD.

  METHOD start.
    DATA lt_events TYPE cntl_simple_events.
    DATA ls_event TYPE cntl_simple_event.

    IF go_html IS BOUND.
      RETURN.
    ENDIF.

    CREATE OBJECT go_html
      EXPORTING
        parent               = cl_gui_container=>default_screen
        query_table_disabled = abap_true
      EXCEPTIONS
        OTHERS = 1.
    IF sy-subrc <> 0.
      MESSAGE 'Could not create the HTML viewer' TYPE 'I'.
      RETURN.
    ENDIF.

    ls_event-eventid = cl_gui_html_viewer=>m_id_sapevent.
    ls_event-appl_event = abap_true.
    APPEND ls_event TO lt_events.
    go_html->set_registered_events( events = lt_events ).
    SET HANDLER on_sapevent FOR go_html.

    TRY.
        IF lcl_pdf_form_manager=>get_config( 'ENGINE' ) <> 'NATIVE'.
          lcl_pdf_renderer=>ping( ).
        ENDIF.
        gv_engine = 'ok'.
      CATCH cx_pdf_error INTO DATA(lx_pdf).
        gv_engine = lx_pdf->get_text( ).
      CATCH cx_root INTO DATA(lx_root).
        gv_engine = lx_root->get_text( ).
    ENDTRY.

    seed_first_form( ).
    show( ).
  ENDMETHOD.

  METHOD show.
    DATA lv_html TYPE string.
    DATA lv_json TYPE string.

    TRY.
        lv_html = load_designer( ).
        REPLACE FIRST OCCURRENCE OF 'data-abappdf-runtime="browser"' IN lv_html
          WITH 'data-abappdf-runtime="sap"'.
        lv_json = build_context( ).
        "The preview PDF is sent once; later page rebuilds do not carry it again.
        CLEAR gv_pdf.
        REPLACE ALL OCCURRENCES OF '<' IN lv_json WITH '\u003c'.
        REPLACE FIRST OCCURRENCE OF '<tbody id="formBody"></tbody>' IN lv_html
          WITH |<tbody id="formBody">{ form_rows( ) }</tbody>|.
        "Form bodies are not embedded in the page; they are loaded on demand via EDIT.
        IF gv_form IS NOT INITIAL.
          REPLACE FIRST OCCURRENCE OF 'id="abappdf-open" type="hidden" value=""' IN lv_html
            WITH |id="abappdf-open" type="hidden" value="{ html_escape( gv_form ) }"|.
        ENDIF.
        "The context goes into the textarea once; the inline script is only a fallback.
        REPLACE FIRST OCCURRENCE OF '>ABAPPDF_JSON<' IN lv_html
          WITH |>{ html_escape( lv_json ) }<|.
        IF sy-subrc <> 0.
          REPLACE FIRST OCCURRENCE OF 'var ABAPPDF_CONTEXT = null;' IN lv_html
            WITH |var ABAPPDF_CONTEXT = { lv_json };|.
          IF sy-subrc <> 0.
            REPLACE FIRST OCCURRENCE OF '</body>' IN lv_html
              WITH |<script>var ABAPPDF_CONTEXT = { lv_json };</script></body>|.
          ENDIF.
        ENDIF.
        display( lv_html ).
      CATCH cx_pdf_error INTO DATA(lx_pdf).
        MESSAGE lx_pdf->get_text( ) TYPE 'I'.
      CATCH cx_root INTO DATA(lx_root).
        MESSAGE lx_root->get_text( ) TYPE 'I'.
    ENDTRY.
  ENDMETHOD.

  METHOD on_sapevent.
    DATA lv_async_save TYPE abap_bool.
    DATA lv_saved_version TYPE string.
    DATA lv_action TYPE string.
    DATA lv_query TYPE string.
    DATA lv_body TYPE string.
    DATA lt_fields TYPE ty_fields.
    DATA lv_new TYPE abap_bool.
    DATA ls_template TYPE lcl_pdf_form_manager=>ty_template.
    DATA ls_page TYPE lcl_pdf_renderer=>ty_page.
    DATA ls_form TYPE lcl_pdf_form_manager=>ty_form.
    DATA lv_version TYPE lcl_pdf_form_manager=>ty_version.
    DATA lv_pdf TYPE xstring.
    DATA lo_renderer TYPE REF TO lcl_pdf_renderer.
    DATA lv_q TYPE i.
    DATA lv_idx TYPE i.
    DATA lv_tot TYPE i.
    DATA lv_part TYPE string.
    DATA lv_b64 TYPE string.
    DATA lv_form_name TYPE string.
    DATA lv_raw TYPE string.
    DATA lv_ack TYPE abap_bool.
    DATA ls_chunk TYPE ty_chunk.
    DATA lv_request TYPE trkorr.

    lv_action = to_upper( action ).
    lv_q = find( val = lv_action sub = '?' ).
    IF lv_q >= 0.
      lv_query = substring( val = action off = lv_q + 1 ).
      lv_action = substring( val = lv_action len = lv_q ).
    ENDIF.
    IF lv_action = 'SAVE_ASYNC'.
      lv_async_save = abap_true.
      lv_action = 'SAVE'.
    ENDIF.
    IF lv_action = 'SAVE_FORM'.
      lv_action = 'SAVE'.
    ELSEIF lv_action = 'PREVIEW_FORM'.
      lv_action = 'PREVIEW'.
    ELSEIF lv_action CP 'EDIT_*' OR lv_action CP 'OPEN_*'.
      lv_form_name = substring( val = lv_action off = 5 ).
      lv_action = 'EDIT'.
    ENDIF.
    IF getdata IS NOT INITIAL.
      lv_query = getdata.
      IF lv_query(1) = '?'.
        lv_query = substring( val = lv_query off = 1 ).
      ENDIF.
    ENDIF.

    "Opening a saved form only sends that form to the page that is already shown.
    IF lv_action = 'LOAD_FORM'.
      form_reply( post_to_string( postdata ) ).
      cl_gui_cfw=>flush( EXCEPTIONS OTHERS = 1 ).
      RETURN.
    ENDIF.

    TRY.
        CASE lv_action.
          WHEN 'EDIT' OR 'OPEN'.
            IF lv_form_name IS INITIAL.
              lv_form_name = query_value( iv_query = lv_query iv_name = 'name' ).
            ENDIF.
            IF lv_form_name IS INITIAL.
              lv_form_name = query_value( iv_query = lv_query iv_name = 'form_name' ).
            ENDIF.
            IF lv_form_name IS INITIAL.
              lv_form_name = query_value( iv_query = lv_query iv_name = 'form_id' ).
            ENDIF.
            lv_raw = getdata.
            IF lv_form_name IS INITIAL AND lv_raw CS 'name='.
              SPLIT lv_raw AT 'name=' INTO lv_b64 lv_form_name.
            ENDIF.
            lv_raw = to_upper( action ).
            IF lv_form_name IS INITIAL.
              lv_q = find( val = lv_raw sub = 'NAME=' ).
              IF lv_q >= 0.
                lv_form_name = substring( val = action off = lv_q + 5 ).
              ENDIF.
            ENDIF.
            LOOP AT query_table ASSIGNING FIELD-SYMBOL(<qrow>).
              ASSIGN COMPONENT 'NAME' OF STRUCTURE <qrow> TO FIELD-SYMBOL(<qname>).
              ASSIGN COMPONENT 'VALUE' OF STRUCTURE <qrow> TO FIELD-SYMBOL(<qvalue>).
              IF sy-subrc = 0 AND lv_form_name IS INITIAL
                  AND to_upper( <qname> ) = 'NAME'.
                lv_form_name = <qvalue>.
              ENDIF.
            ENDLOOP.
            SPLIT lv_form_name AT '&' INTO lv_form_name lv_b64.
            SPLIT lv_form_name AT '#' INTO lv_form_name lv_b64.
            lv_form_name = cl_http_utility=>unescape_url( lv_form_name ).
            SHIFT lv_form_name LEFT DELETING LEADING space.
            SHIFT lv_form_name RIGHT DELETING TRAILING space.
            lcl_pdf_form_manager=>reload( ).
            gv_form = lv_form_name.
            CLEAR gv_draft.
            CLEAR gv_pdf.
            CLEAR gv_message.
            gv_view_only = xsdbool( to_upper( query_value( iv_query = lv_query iv_name = 'pdf' ) ) = 'X' ).
            IF gv_form IS INITIAL.
              gv_form = 'ZPDF_DEMO'.
            ENDIF.
          WHEN 'CREATE'.
            lcl_pdf_form_manager=>create_form(
              iv_form_id        = query_value( iv_query = lv_query iv_name = 'form_id' )
              iv_description    = query_value( iv_query = lv_query iv_name = 'descr' )
              iv_package        = query_value( iv_query = lv_query iv_name = 'package' )
              iv_ddic_structure = query_value( iv_query = lv_query iv_name = 'ddic' ) ).
            gv_form = query_value( iv_query = lv_query iv_name = 'form_id' ).
            CLEAR gv_draft.
            gv_message = |Created { gv_form }|.
          WHEN 'DELETE'.
            lcl_pdf_form_manager=>delete_form( query_value( iv_query = lv_query iv_name = 'form_id' ) ).
            lcl_pdf_form_manager=>commit_changes( ).
            CLEAR gv_form.
            CLEAR gv_draft.
            gv_message = 'Form deleted'.
            IF lcl_pdf_form_manager=>last_request( ) IS NOT INITIAL.
              gv_message = gv_message && | (deletion recorded in transport request { lcl_pdf_form_manager=>last_request( ) })|.
            ENDIF.
          WHEN 'TRANSPORT'.
            lv_form_name = to_upper( query_value( iv_query = lv_query iv_name = 'form_id' ) ).
            lv_request = lcl_pdf_form_manager=>transport_form( lv_form_name ).
            gv_message = |Form { lv_form_name } is in transport request { lv_request }.|.
            IF to_upper( query_value( iv_query = lv_query iv_name = 'from' ) ) = 'LIST'.
              CLEAR gv_form.
            ELSE.
              gv_form = lv_form_name.
            ENDIF.
            CLEAR gv_draft.
          WHEN 'SAVE_ABORT'.
            CLEAR gt_chunks.
            gv_message = 'Save did not finish. Try Save again.'.
          WHEN 'SAVE' OR 'PREVIEW'.
            lv_part = query_value( iv_query = lv_query iv_name = 'd' ).
            IF lv_action = 'SAVE' AND lv_part IS NOT INITIAL.
              lv_idx = to_int( query_value( iv_query = lv_query iv_name = 'i' ) ).
              lv_tot = to_int( query_value( iv_query = lv_query iv_name = 't' ) ).
              IF lv_tot < 1 OR lv_tot > 12000 OR lv_idx < 0 OR lv_idx >= lv_tot
                  OR strlen( lv_part ) > 1000.
                RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Invalid save chunk'.
              ENDIF.
              IF lv_idx = 0.
                CLEAR gt_chunks.
                gv_chunk_total = lv_tot.
              ENDIF.
              IF lv_tot <> gv_chunk_total OR lv_idx <> lines( gt_chunks ).
                RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Save chunks arrived out of sequence; retry Save'.
              ENDIF.
              ls_chunk-idx = lv_idx.
              ls_chunk-part = lv_part.
              APPEND ls_chunk TO gt_chunks.
              IF lines( gt_chunks ) < lv_tot.
                display( ack_page( iv_done = lines( gt_chunks ) iv_total = lv_tot ) ).
                RETURN.
              ENDIF.
              CLEAR lv_b64.
              LOOP AT gt_chunks INTO ls_chunk.
                lv_b64 = lv_b64 && ls_chunk-part.
              ENDLOOP.
              CLEAR gt_chunks.
              CLEAR gv_chunk_total.
              lv_body = 'payload=' && lv_b64.
            ELSE.
              lv_body = post_to_string( postdata ).
            ENDIF.
            IF strlen( lv_body ) > 12000000.
              RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Encoded request exceeds 12 MB'.
            ENDIF.
            lv_b64 = lv_body.
            lv_q = find( val = lv_b64 sub = 'payload=' ).
            IF lv_q >= 0.
              lv_b64 = substring( val = lv_b64 off = lv_q + 8 ).
            ENDIF.
            lv_q = find( val = lv_b64 sub = '&' ).
            IF lv_q >= 0.
              lv_b64 = substring( val = lv_b64 len = lv_q ).
            ENDIF.
            DO 2 TIMES.
              IF lv_b64 NS '%'.
                EXIT.
              ENDIF.
              REPLACE ALL OCCURRENCES OF '+' IN lv_b64 WITH '%2B'.
              lv_b64 = cl_http_utility=>unescape_url( lv_b64 ).
            ENDDO.
            IF lv_b64 IS INITIAL.
              gv_message = 'Save was not accepted by the HTML control.'.
            ELSE.
              lt_fields = form_fields( lcl_pdf_convert=>base64_decode( lv_b64 ) ).
            ENDIF.
            IF lt_fields IS INITIAL.
              gv_message = 'SAP GUI did not return the template body. Use SAP GUI for Windows.'.
            ELSE.
              gv_form = to_upper( field_value( it_fields = lt_fields iv_name = 'form_id' ) ).
              SHIFT gv_form LEFT DELETING LEADING space.
              SHIFT gv_form RIGHT DELETING TRAILING space.
              IF gv_form IS INITIAL.
                gv_message = 'Enter a form name before saving'.
              ELSE.
                remember_draft( lt_fields ).
                IF lv_action = 'SAVE'.
                TRY.
                    ls_form = lcl_pdf_form_manager=>read_form( gv_form ).
                  CATCH cx_pdf_error.
                    lcl_pdf_form_manager=>create_form(
                      iv_form_id        = gv_form
                      iv_description    = gv_form
                      iv_package        = field_value( it_fields = lt_fields iv_name = 'package' )
                      iv_ddic_structure = field_value( it_fields = lt_fields iv_name = 'ddic' ) ).
                ENDTRY.
                ENDIF.
                IF lv_action = 'SAVE'.
                  ls_form = lcl_pdf_form_manager=>read_form( gv_form ).
                  IF ls_form-ddic_structure <> to_upper( gs_draft_form-ddic_structure ).
                    lcl_pdf_form_manager=>update_form(
                      iv_form_id = gv_form
                      iv_description = ls_form-description
                      iv_ddic_structure = gs_draft_form-ddic_structure ).
                  ENDIF.
                  ls_template = gs_draft.
                  ls_template-form_id = gv_form.
                  lv_new = xsdbool( field_value( it_fields = lt_fields iv_name = 'new_version' ) = 'X' ).
                  lv_version = lcl_pdf_form_manager=>save_template(
                    is_template    = ls_template
                    iv_new_version = lv_new ).
                  lcl_pdf_form_manager=>commit_changes( ).
                  lv_saved_version = lv_version.
                  CLEAR gv_draft.
                  CLEAR gv_pdf.
                  "Keep the form open and reload the committed template.
                  gv_message = |Form saved successfully. Version { lv_version }.|.
                  IF lcl_pdf_form_manager=>last_request( ) IS NOT INITIAL.
                    gv_message = gv_message && | Recorded in transport request { lcl_pdf_form_manager=>last_request( ) }.|.
                  ENDIF.
                ELSE.
                  TRY.
                      ls_form = lcl_pdf_form_manager=>read_form( gv_form ).
                    CATCH cx_pdf_error.
                      ls_form-ddic_structure = field_value( it_fields = lt_fields iv_name = 'ddic' ).
                  ENDTRY.
                  ls_form-ddic_structure = gs_draft_form-ddic_structure.
                  ls_page-page_size = gs_draft-page_size.
                  ls_page-orientation = gs_draft-orientation.
                  ls_page-margin_top = gs_draft-margin_top.
                  ls_page-margin_right = gs_draft-margin_right.
                  ls_page-margin_bottom = gs_draft-margin_bottom.
                  ls_page-margin_left = gs_draft-margin_left.
                  CREATE OBJECT lo_renderer.
                  lv_pdf = lo_renderer->render(
                    iv_html   = bind_sample(
                                  iv_template = gs_draft-html_content
                                  iv_sample   = gs_draft-sample_json
                                  iv_ddic     = ls_form-ddic_structure )
                    iv_css    = bind_sample(
                                  iv_template = gs_draft-css_content
                                  iv_sample   = gs_draft-sample_json
                                  iv_ddic     = ls_form-ddic_structure )
                    iv_header = bind_sample(
                                  iv_template = gs_draft-header_html
                                  iv_sample   = gs_draft-sample_json
                                  iv_ddic     = ls_form-ddic_structure )
                    iv_footer = bind_sample(
                                  iv_template = gs_draft-footer_html
                                  iv_sample   = gs_draft-sample_json
                                  iv_ddic     = ls_form-ddic_structure )
                    is_page   = ls_page ).
                  gv_pdf = cl_http_utility=>encode_x_base64( unencoded = lv_pdf ).
                  lcl_pdf_api=>download_pdf(
                    iv_pdf_xstring = lv_pdf
                    iv_filename    = |{ gv_form }.pdf| ).
                  gv_message = 'PDF rendered'.
                ENDIF.
              ENDIF.
            ENDIF.
        ENDCASE.
        lcl_pdf_form_manager=>commit_changes( ).
      CATCH cx_pdf_error INTO DATA(lx_pdf).
        lcl_pdf_form_manager=>abort_changes( ).
        gv_message = lx_pdf->get_text( ).
      CATCH cx_root INTO DATA(lx_error).
        lcl_pdf_form_manager=>abort_changes( ).
        gv_message = lx_error->get_text( ).
    ENDTRY.

    IF lv_async_save = abap_true.
      TRY.
          save_reply( iv_version = lv_saved_version iv_message = gv_message ).
        CATCH cx_pdf_error INTO DATA(lx_reply).
          MESSAGE lx_reply->get_text( ) TYPE 'I'.
      ENDTRY.
    ELSE.
      show( ).
    ENDIF.
    cl_gui_cfw=>flush( EXCEPTIONS OTHERS = 1 ).
  ENDMETHOD.

  METHOD ack_page.
    rv_html = '<!DOCTYPE html><html><body onload="cont()">'.
    rv_html = rv_html && |<p id="m">Saving { iv_done } of { iv_total }...</p>|.
    rv_html = rv_html && '<a id="go" href="sapevent:save_abort">Back to designer</a><script>'.
    rv_html = rv_html && 'function cont(){var raw=window.name||"";'.
    rv_html = rv_html && 'if(raw.indexOf("ABAPPDF")!==0){try{raw=sessionStorage.getItem("abappdf")||"";}catch(ex){raw="";}}'.
    rv_html = rv_html && 'var nl=String.fromCharCode(10);var p=raw.split(nl);var link=document.getElementById("go");'.
    rv_html = rv_html && 'if(!p||p.length<4||p[0]!=="ABAPPDF"){window.location.href=link.href;return;}'.
    rv_html = rv_html && 'var next=parseInt(p[2],10);var packed=p[3];var size=1000;'.
    rv_html = rv_html && 'var total=Math.ceil(packed.length/size);if(!total){total=1;}'.
    rv_html = rv_html && 'if(!(next<total)){window.name="";window.location.href=link.href;return;}'.
    rv_html = rv_html && 'var chunk=packed.substring(next*size,next*size+size);p[2]=String(next+1);'.
    rv_html = rv_html && 'var blob=p.join(nl);window.name=blob;'.
    rv_html = rv_html && 'try{sessionStorage.setItem("abappdf",blob);}catch(ex2){}'.
    rv_html = rv_html && 'var url="sapevent:"+p[1]+"?i="+next+"&t="+total+"&d="+encodeURIComponent(chunk);'.
    rv_html = rv_html && 'link.href=url;document.getElementById("m").innerHTML="Saving "+(next+1)+" of "+total;'.
    rv_html = rv_html && 'window.location.href=url;}'.
    rv_html = rv_html && '</script></body></html>'.
  ENDMETHOD.

  METHOD load_designer.
    DATA lt_text TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    DATA lo_api TYPE REF TO if_mr_api.
    DATA lv_x TYPE xstring.
    DATA lv_line TYPE string.

    IF gv_src_file IS NOT INITIAL.
      cl_gui_frontend_services=>gui_upload(
        EXPORTING
          filename = gv_src_file
          filetype = 'ASC'
          codepage = '4110'
        CHANGING
          data_tab = lt_text
        EXCEPTIONS
          OTHERS   = 1 ).
      IF sy-subrc = 0 AND lt_text IS NOT INITIAL.
        LOOP AT lt_text INTO lv_line.
          rv_html = rv_html && lv_line && cl_abap_char_utilities=>newline.
        ENDLOOP.
        RETURN.
      ENDIF.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'Could not read the selected local designer HTML file'.
    ENDIF.

    IF gv_src_mime IS NOT INITIAL.
      lo_api = cl_mime_repository_api=>get_api( ).
      lo_api->get(
        EXPORTING
          i_url              = gv_src_mime
        IMPORTING
          e_content          = lv_x
        EXCEPTIONS
          parameter_missing  = 1
          error_occured      = 2
          not_found          = 3
          permission_failure = 4
          OTHERS             = 5 ).
      IF sy-subrc = 0 AND lv_x IS NOT INITIAL.
        rv_html = lcl_pdf_convert=>xstring_to_string( lv_x ).
        RETURN.
      ENDIF.
    ENDIF.

    rv_html = lcl_pdf_designer=>get_html( ).
  ENDMETHOD.

  METHOD build_context.
    DATA lt_forms TYPE lcl_pdf_form_manager=>ty_forms.
    DATA ls_form_row TYPE lcl_pdf_form_manager=>ty_form.
    DATA ls_form TYPE lcl_pdf_form_manager=>ty_form.
    DATA ls_tpl TYPE lcl_pdf_form_manager=>ty_template.
    DATA lv_forms TYPE string.
    DATA lv_sep TYPE string.
    DATA lv_fields TYPE string VALUE '[]'.
    DATA lv_sample TYPE string.
    DATA lv_message TYPE string.
    DATA lx_pdf TYPE REF TO cx_pdf_error.
    DATA ls_list_tpl TYPE lcl_pdf_form_manager=>ty_template.
    DATA lv_note TYPE string.
    DATA lt_requests TYPE lcl_pdf_form_manager=>ty_form_requests.
    DATA ls_request TYPE lcl_pdf_form_manager=>ty_form_request.
    DATA lv_request TYPE string.

    lv_message = gv_message.
    lt_forms = lcl_pdf_form_manager=>list_forms( ).
    lv_note = lcl_pdf_form_manager=>take_note( ).
    IF lv_note IS NOT INITIAL.
      lv_message = condense( lv_message && ` ` && lv_note ).
    ENDIF.
    lt_requests = lcl_pdf_form_manager=>form_requests( ).
    LOOP AT lt_forms INTO ls_form_row.
      CLEAR lv_request.
      LOOP AT lt_requests INTO ls_request WHERE form_id = ls_form_row-form_id.
        lv_request = lv_request && COND string( WHEN lv_request IS INITIAL THEN `` ELSE `, ` ) && ls_request-request.
      ENDLOOP.
      CLEAR ls_list_tpl.
      TRY.
          ls_list_tpl = lcl_pdf_form_manager=>read_active_template( ls_form_row-form_id ).
        CATCH cx_pdf_error.
      ENDTRY.
      "List metadata only; the form body is loaded via EDIT when opened.
      lv_forms = lv_forms && lv_sep &&
        '{"id":"' && json_escape( ls_form_row-form_id ) &&
        '","description":"' && json_escape( ls_form_row-description ) &&
        '","package":"' && json_escape( ls_form_row-package ) &&
        '","ddic":"' && json_escape( ls_form_row-ddic_structure ) &&
        '","pageSize":"' && json_escape( ls_list_tpl-page_size ) &&
        '","orientation":"' && json_escape( ls_list_tpl-orientation ) &&
        '","marginTop":' && |{ ls_list_tpl-margin_top }| &&
        ',"marginRight":' && |{ ls_list_tpl-margin_right }| &&
        ',"marginBottom":' && |{ ls_list_tpl-margin_bottom }| &&
        ',"marginLeft":' && |{ ls_list_tpl-margin_left }| &&
        ',"changedAt":"' && |{ ls_form_row-changed_at }| &&
        '","saved":true,"version":"' && |{ ls_list_tpl-version }| &&
        '","transport":"' && json_escape( lv_request ) && '"}'.
      lv_sep = ','.
    ENDLOOP.

    IF gv_form IS NOT INITIAL.
      TRY.
          IF gv_draft = abap_true.
            ls_form = gs_draft_form.
            ls_tpl = gs_draft.
          ELSE.
            ls_form = lcl_pdf_form_manager=>read_form( gv_form ).
            TRY.
                ls_tpl = lcl_pdf_form_manager=>read_active_template( gv_form ).
              CATCH cx_pdf_error.
                CLEAR ls_tpl.
            ENDTRY.
          ENDIF.
          IF ls_form-ddic_structure IS NOT INITIAL.
            TRY.
                lv_fields = lcl_pdf_data_binder=>field_catalog_json( ls_form-ddic_structure ).
              CATCH cx_pdf_error INTO lx_pdf.
                lv_fields = '[]'.
                lv_message = lv_message && | { lx_pdf->get_text( ) }|.
            ENDTRY.
          ENDIF.
        CATCH cx_pdf_error INTO lx_pdf.
          lv_message = lx_pdf->get_text( ).
      ENDTRY.
    ENDIF.

    IF gv_draft = abap_true AND gv_form IS NOT INITIAL.
      ls_tpl = gs_draft.
    ENDIF.
    lv_sample = ls_tpl-sample_json.
    IF lv_sample IS INITIAL.
      lv_sample = sample_skeleton( ls_form-ddic_structure ).
    ENDIF.
    IF ls_tpl-page_size IS INITIAL.
      ls_tpl-page_size = 'A4'.
      ls_tpl-orientation = 'P'.
      ls_tpl-margin_top = 12.
      ls_tpl-margin_right = 10.
      ls_tpl-margin_bottom = 16.
      ls_tpl-margin_left = 10.
    ENDIF.

    rv_json = '{' &&
      '"formId":"' && json_escape( ls_form-form_id ) && '",' &&
      '"description":"' && json_escape( ls_form-description ) && '",' &&
      '"package":"' && json_escape( ls_form-package ) && '",' &&
      '"ddic":"' && json_escape( ls_form-ddic_structure ) && '",' &&
      '"version":"' && json_escape( |{ ls_tpl-version }| ) && '",' &&
      '"message":"' && json_escape( lv_message ) && '",' &&
      '"engine":"' && json_escape( gv_engine ) && '",' &&
      '"store":"' && lcl_pdf_form_manager=>store_mode( ) && '",' &&
      '"recording":"' && lcl_pdf_form_manager=>client_recording( ) && '",' &&
      '"viewOnly":' && COND string( WHEN gv_view_only = abap_true THEN 'true' ELSE 'false' ) && ',' &&
      '"page":{"size":"' && json_escape( ls_tpl-page_size ) &&
      '","orientation":"' && json_escape( ls_tpl-orientation ) &&
      '","marginTop":' && |{ ls_tpl-margin_top }| &&
      ',"marginRight":' && |{ ls_tpl-margin_right }| &&
      ',"marginBottom":' && |{ ls_tpl-margin_bottom }| &&
      ',"marginLeft":' && |{ ls_tpl-margin_left }| && '},' &&
      '"html":"' && json_escape( ls_tpl-html_content ) && '",' &&
      '"css":"' && json_escape( ls_tpl-css_content ) && '",' &&
      '"header":"' && json_escape( ls_tpl-header_html ) && '",' &&
      '"footer":"' && json_escape( ls_tpl-footer_html ) && '",' &&
      '"sample":"' && json_escape( lv_sample ) && '",' &&
      '"forms":[' && lv_forms && '],' &&
      '"fields":' && lv_fields && ',' &&
      '"previewPdf":"' && json_escape( gv_pdf ) && '"' &&
      '}'.
  ENDMETHOD.

  METHOD form_rows.
    DATA lt_forms TYPE lcl_pdf_form_manager=>ty_forms.
    DATA ls_row TYPE lcl_pdf_form_manager=>ty_form.
    DATA lv_id TYPE string.
    DATA lv_pkg TYPE string.

    lt_forms = lcl_pdf_form_manager=>list_forms( ).
    LOOP AT lt_forms INTO ls_row.
      lv_id = html_escape( ls_row-form_id ).
      lv_pkg = '$TMP'.
      rv_html = rv_html && '<tr><td></td><td><span class="link" data-act="edit" data-id="'.
      rv_html = rv_html && lv_id && '">' && lv_id && '</span>'.
      rv_html = rv_html && '<div class="muted">' && html_escape( ls_row-description ).
      rv_html = rv_html && '</div></td><td><span class="pkg">' && lv_pkg && '</span></td><td>'.
      rv_html = rv_html && |{ ls_row-changed_at }| && '</td><td><span class="link" data-act="edit"'.
      rv_html = rv_html && ' data-id="' && lv_id && '">Edit</span> &nbsp; <span class="link" data-act="open"'.
      rv_html = rv_html && ' data-id="' && lv_id && '">Open</span></td></tr>'.
    ENDLOOP.
  ENDMETHOD.

  METHOD form_store.
    DATA lt_forms TYPE lcl_pdf_form_manager=>ty_forms.
    DATA ls_row TYPE lcl_pdf_form_manager=>ty_form.
    DATA ls_tpl TYPE lcl_pdf_form_manager=>ty_template.
    DATA lv_id TYPE string.
    DATA lv_json TYPE string.

    lt_forms = lcl_pdf_form_manager=>list_forms( ).
    rv_html = '<div id="formStore">'.
    LOOP AT lt_forms INTO ls_row.
      CLEAR ls_tpl.
      TRY.
          ls_tpl = lcl_pdf_form_manager=>read_active_template( ls_row-form_id ).
        CATCH cx_pdf_error.
      ENDTRY.
      lv_id = html_escape( ls_row-form_id ).
      lv_json = '{"id":"' && json_escape( ls_row-form_id ) &&
        '","description":"' && json_escape( ls_row-description ) &&
        '","package":"' && json_escape( ls_row-package ) &&
        '","ddic":"' && json_escape( ls_row-ddic_structure ) &&
        '","saved":true' &&
        ',"html":"' && json_escape( ls_tpl-html_content ) &&
        '","css":"' && json_escape( ls_tpl-css_content ) &&
        '","header":"' && json_escape( ls_tpl-header_html ) &&
        '","footer":"' && json_escape( ls_tpl-footer_html ) &&
        '","sample":"' && json_escape( ls_tpl-sample_json ) &&
        '","pageSize":"' && json_escape( ls_tpl-page_size ) &&
        '","orientation":"' && json_escape( ls_tpl-orientation ) &&
        '","marginTop":' && |{ ls_tpl-margin_top }| &&
        ',"marginRight":' && |{ ls_tpl-margin_right }| &&
        ',"marginBottom":' && |{ ls_tpl-margin_bottom }| &&
        ',"marginLeft":' && |{ ls_tpl-margin_left }| && '}'.
      rv_html = rv_html && '<textarea class="hidden">'.
      rv_html = rv_html && html_escape( lv_json ) && '</textarea>'.
    ENDLOOP.
    rv_html = rv_html && '</div>'.
  ENDMETHOD.

  METHOD html_escape.
    rv_text = iv_text.
    REPLACE ALL OCCURRENCES OF '&' IN rv_text WITH '&amp;'.
    REPLACE ALL OCCURRENCES OF '<' IN rv_text WITH '&lt;'.
    REPLACE ALL OCCURRENCES OF '>' IN rv_text WITH '&gt;'.
    REPLACE ALL OCCURRENCES OF '"' IN rv_text WITH '&quot;'.
  ENDMETHOD.

  METHOD json_escape.
    rv_text = escape( val = iv_text format = cl_abap_format=>e_json_string ).
  ENDMETHOD.

  METHOD sample_skeleton.
    DATA lt_fields TYPE lcl_pdf_data_binder=>ty_fields.
    DATA ls_field TYPE lcl_pdf_data_binder=>ty_field.
    DATA lv_sep TYPE string.

    IF iv_ddic IS INITIAL.
      rv_json = '{}'.
      RETURN.
    ENDIF.
    TRY.
        lt_fields = lcl_pdf_data_binder=>field_catalog( iv_ddic ).
      CATCH cx_pdf_error.
        rv_json = '{}'.
        RETURN.
    ENDTRY.

    rv_json = '{'.
    LOOP AT lt_fields INTO ls_field WHERE parent IS INITIAL.
      IF ls_field-kind = 'field'.
        rv_json = rv_json && lv_sep && '"' && json_escape( ls_field-name ) && '":""'.
        lv_sep = ','.
      ELSEIF ls_field-kind = 'table'.
        rv_json = rv_json && lv_sep && '"' && json_escape( ls_field-name ) && '":[]'.
        lv_sep = ','.
      ENDIF.
    ENDLOOP.
    rv_json = rv_json && '}'.
  ENDMETHOD.

  METHOD display.
    DATA lt_binary TYPE solix_tab.
    DATA lv_url TYPE c LENGTH 255.
    DATA lv_data TYPE xstring.
    DATA lv_size TYPE i.
    lv_data = lcl_pdf_convert=>string_to_xstring( iv_html ).
    lv_size = xstrlen( lv_data ).
    CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
      EXPORTING buffer = lv_data
      TABLES binary_tab = lt_binary.
    go_html->load_data(
      EXPORTING type = 'text' subtype = 'html' size = lv_size
      IMPORTING assigned_url = lv_url
      CHANGING data_table = lt_binary
      EXCEPTIONS OTHERS = 1 ).
    IF sy-subrc <> 0.
      RAISE EXCEPTION TYPE cx_pdf_error EXPORTING message = 'HTML viewer rejected the designer page'.
    ENDIF.
    IF iv_frame IS INITIAL.
      go_html->show_url( url = lv_url ).
    ELSE.
      DATA lv_frame TYPE c LENGTH 255.
      lv_frame = iv_frame.
      go_html->show_url( url = lv_url frame = lv_frame ).
    ENDIF.
  ENDMETHOD.

  METHOD seed_first_form.
    "Runs once per client: a store that has never been set up and has no forms gets the
    "demo form. Deleting forms later (even all of them) does not bring it back.
    "Users without change authorization, or a client closed for changes, are skipped.
    DATA ls_template TYPE lcl_pdf_form_manager=>ty_template.
    TRY.
        IF lcl_pdf_form_manager=>store_initialized( ) = abap_true.
          RETURN.
        ENDIF.
        IF lcl_pdf_form_manager=>client_recording( ) = '2'.
          RETURN.
        ENDIF.
        lcl_pdf_security=>check( 'ZPDFEDIT' ).
        IF lcl_pdf_form_manager=>list_forms( ) IS NOT INITIAL.
          "Existing installation: only record that the store is set up.
          lcl_pdf_form_manager=>mark_initialized( ).
          COMMIT WORK.
          RETURN.
        ENDIF.
        lcl_pdf_form_manager=>create_form(
          iv_form_id     = c_demo_form
          iv_description = 'Flight passenger manifest (demo)' ).
        ls_template = demo_template( ).
        lcl_pdf_form_manager=>save_template( ls_template ).
        lcl_pdf_form_manager=>mark_initialized( ).
        lcl_pdf_form_manager=>commit_changes( ).
        gv_message = |Demo form { c_demo_form } was installed. Run report ZABAPPDF_DEMO_FLIGHTS to print it.|.
      CATCH cx_pdf_error.
        lcl_pdf_form_manager=>abort_changes( ).
        ROLLBACK WORK.
    ENDTRY.
  ENDMETHOD.

