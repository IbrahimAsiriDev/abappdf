  METHOD char_width.
    DATA lv_table TYPE i.
    DATA lv_index TYPE i.
    DATA lv_width TYPE i.

    IF iv_font >= 13.
      rv_width = lcl_pdf_arabic=>cp_width( iv_cp = iv_code iv_bold = xsdbool( iv_font = 14 ) ).
      RETURN.
    ENDIF.
    IF iv_code < 32 OR iv_code > 255.
      RETURN.
    ENDIF.
    CASE iv_font.
      WHEN 1 OR 3.
        lv_table = 1.
      WHEN 2 OR 4.
        lv_table = 2.
      WHEN 5.
        lv_table = 3.
      WHEN 6.
        lv_table = 4.
      WHEN 7.
        lv_table = 5.
      WHEN 8.
        lv_table = 6.
      WHEN OTHERS.
        rv_width = 600.
        RETURN.
    ENDCASE.
    lv_index = ( lv_table - 1 ) * 224 + iv_code - 31.
    READ TABLE gt_widths INTO lv_width INDEX lv_index.
    IF sy-subrc = 0.
      rv_width = lv_width.
    ELSE.
      rv_width = 556.
    ENDIF.
  ENDMETHOD.

  METHOD hex_width.
    DATA lv_x TYPE x LENGTH 1.
    DATA lv_x2 TYPE x LENGTH 2.
    DATA lv_code TYPE i.
    DATA lv_off TYPE i.
    DATA lv_sum TYPE f.

    IF iv_font >= 13.
      WHILE lv_off + 4 <= strlen( iv_hex ).
        lv_x2 = iv_hex+lv_off(4).
        lv_code = lv_x2.
        lv_sum = lv_sum + lcl_pdf_arabic=>glyph_width( iv_gid = lv_code iv_bold = xsdbool( iv_font = 14 ) ).
        lv_off = lv_off + 4.
      ENDWHILE.
      rv_width = lv_sum * iv_size / 1000.
      RETURN.
    ENDIF.

    WHILE lv_off + 2 <= strlen( iv_hex ).
      lv_x = iv_hex+lv_off(2).
      lv_code = lv_x.
      lv_sum = lv_sum + char_width( iv_font = iv_font iv_code = lv_code ).
      lv_off = lv_off + 2.
    ENDWHILE.
    rv_width = lv_sum * iv_size / 1000.
  ENDMETHOD.

  METHOD font_index.
    CASE is_style-family.
      WHEN 'T'.
        rv_index = 5.
      WHEN 'C'.
        rv_index = 9.
      WHEN OTHERS.
        rv_index = 1.
    ENDCASE.
    IF is_style-bold = abap_true.
      rv_index = rv_index + 1.
    ENDIF.
    IF is_style-italic = abap_true.
      rv_index = rv_index + 2.
    ENDIF.
  ENDMETHOD.

  METHOD length_pt.
    DATA lv_value TYPE string.
    DATA lv_number TYPE string.
    DATA lv_unit TYPE string.
    DATA lv_f TYPE f.
    DATA lv_len TYPE i.

    lv_value = to_lower( iv_value ).
    CONDENSE lv_value NO-GAPS.
    IF lv_value IS INITIAL.
      RETURN.
    ENDIF.
    lv_len = strlen( lv_value ).
    lv_number = lv_value.
    WHILE lv_len > 0.
      lv_unit = substring( val = lv_value off = lv_len - 1 len = 1 ).
      IF lv_unit CO '0123456789.'.
        EXIT.
      ENDIF.
      lv_len = lv_len - 1.
    ENDWHILE.
    IF lv_len <= 0.
      RETURN.
    ENDIF.
    lv_number = substring( val = lv_value len = lv_len ).
    lv_unit = substring( val = lv_value off = lv_len ).
    IF lv_number CN '0123456789.-'.
      RETURN.
    ENDIF.
    TRY.
        lv_f = lv_number.
      CATCH cx_root.
        RETURN.
    ENDTRY.
    CASE lv_unit.
      WHEN 'pt'.
        rv_pt = lv_f.
      WHEN 'mm'.
        rv_pt = lv_f * 72 / '25.4'.
      WHEN 'cm'.
        rv_pt = lv_f * 72 / '2.54'.
      WHEN 'in'.
        rv_pt = lv_f * 72.
      WHEN 'em' OR 'rem'.
        rv_pt = lv_f * iv_base.
      WHEN '%'.
        rv_pt = lv_f * iv_base / 100.
      WHEN OTHERS.
        rv_pt = lv_f * '0.75'.
    ENDCASE.
  ENDMETHOD.

  METHOD num.
    DATA lv_p TYPE p LENGTH 12 DECIMALS 2.
    lv_p = iv_value.
